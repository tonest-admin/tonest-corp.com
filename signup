<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
  <title>TO:NEST 회원가입</title>
  <meta name="theme-color" content="#16a7a4">
  <link rel="icon" href="/favicon.ico?v=3" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico?v=3" type="image/x-icon">
<style>
    :root{
      --bg:#f6f9f8;--card:#fff;--line:#dfe8e6;--line2:#edf3f2;
      --text:#172124;--muted:#708083;--primary:#16a7a4;--primary2:#118b89;
      --danger:#dc2626;--success:#15803d;
      --shadow:0 20px 50px rgba(15,45,47,.10);
      --shadow2:0 10px 28px rgba(20,70,68,.07);
      --radius:22px;
      --font:"Pretendard Variable","Pretendard","Noto Sans KR",system-ui,-apple-system,"Segoe UI",sans-serif;
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;font-family:var(--font);color:var(--text)}
    html{
      background:
        radial-gradient(circle at 50% 0%,rgba(30,174,168,.10),transparent 38%),
        linear-gradient(180deg,#fff 0%,var(--bg) 72%,#eef5f3 100%);
    }
    body{background:transparent;-webkit-font-smoothing:antialiased}
    button,input,a{font-family:inherit}
    .wrap{min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:clamp(14px,2.6vw,30px)}
    .stack{width:min(100%,440px);display:flex;flex-direction:column;gap:14px}
    .logo-panel{
      position:relative;width:100%;height:190px;border:1px solid var(--line);
      border-radius:30px;background:#fff;display:flex;align-items:center;justify-content:center;
      overflow:hidden;box-shadow:var(--shadow2)
    }
    .logo-panel:before{
      content:"";position:absolute;inset:18px;border:1px solid var(--line2);
      border-radius:24px;background:linear-gradient(180deg,#fff,#fbfefd)
    }
    .brand-logo-img{position:relative;z-index:1;width:72%;height:72%;object-fit:contain;display:block}
    .card{
      width:100%;background:rgba(255,255,255,.98);border:1px solid var(--line);
      border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)
    }
    .kicker{margin-bottom:8px;color:var(--primary2);font-size:11px;font-weight:800;letter-spacing:.16em}
    .title{margin:0 0 4px;font-size:29px;line-height:1.1;font-weight:850;letter-spacing:-.04em}
    .subtitle{margin:0 0 15px;color:var(--muted);font-size:12.5px;line-height:1.55;font-weight:600}
    .label{display:block;margin:10px 0 6px;color:#334345;font-size:12px;font-weight:800}
    input{
      width:100%;height:43px;padding:0 13px;border-radius:14px;border:1px solid #cad8d6;
      background:#f8fbfa;color:var(--text);outline:none;font-size:15px;font-weight:700
    }
    input::placeholder{color:#9aa8aa;font-weight:600}
    input:focus{background:#fff;border-color:rgba(22,167,164,.72);box-shadow:0 0 0 3px rgba(22,167,164,.13)}
    .hint{margin-top:6px;color:#8a989a;font-size:10.5px;line-height:1.4}
    .btn{
      width:100%;height:44px;margin-top:14px;border:1px solid rgba(17,139,137,.2);
      border-radius:14px;background:linear-gradient(180deg,#22b7b2,#16a7a4);
      color:#fff;font-size:15px;font-weight:800;cursor:pointer;
      box-shadow:0 12px 24px rgba(22,167,164,.22);
      display:flex;align-items:center;justify-content:center;text-decoration:none
    }
    .btn:hover{filter:brightness(1.035)} .btn:active{transform:translateY(1px)}
    .btn:disabled{opacity:.65;cursor:not-allowed}
    .btn.secondary{margin-top:8px;background:#fff;color:var(--primary2);border-color:#cad8d6;box-shadow:none}
    .status{min-height:18px;margin-top:10px;color:var(--muted);font-size:11.5px;line-height:1.5;white-space:pre-wrap;font-weight:650}
    .status.error{color:var(--danger)} .status.success{color:var(--success)}
    .footer{margin-top:11px;padding-top:11px;border-top:1px solid var(--line2);color:#97a3a4;font-size:10.5px;text-align:center;font-weight:650;letter-spacing:.02em}
    @media(max-width:760px){
      .wrap{padding:max(10px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) max(10px,env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left))}
      .stack{width:min(100%,410px);gap:9px}
      .logo-panel{height:150px;border-radius:22px}.logo-panel:before{inset:11px;border-radius:16px}
      .brand-logo-img{width:76%;height:76%}
      .card{padding:14px;border-radius:19px}.title{font-size:26px}.subtitle{font-size:11.5px;margin-bottom:10px}
      .label{margin:7px 0 4px;font-size:11.5px}
      input{height:39px;border-radius:12px;font-size:14px}
      .btn{height:40px;margin-top:10px;border-radius:12px;font-size:14px}
    }
  </style>
</head>
<body>
<div class="wrap">
  <main class="stack">
    <section class="logo-panel" aria-label="TO:NEST">
      <img class="brand-logo-img" src="/logo.png" alt="TO:NEST">
    </section>

    <section class="card">
      <div class="kicker">TO:NEST ACCOUNT</div>
      <h1 class="title">회원가입</h1>
      <p class="subtitle">가입 후 관리자 승인이 완료되어야 서비스를 사용할 수 있습니다.</p>

      <form id="signupForm">
        <label class="label" for="displayName">이름</label>
        <input id="displayName" type="text" placeholder="이름" autocomplete="name" maxlength="50">

        <label class="label" for="email">이메일</label>
        <input id="email" type="email" placeholder="name@company.com" autocomplete="email" maxlength="254">

        <label class="label" for="phone">연락처</label>
        <input id="phone" type="tel" placeholder="010-0000-0000" autocomplete="tel" maxlength="30">

        <label class="label" for="password">비밀번호</label>
        <input id="password" type="password" placeholder="8자 이상" autocomplete="new-password">
        <div class="hint">비밀번호는 8자 이상 입력해주세요.</div>

        <label class="label" for="passwordConfirm">비밀번호 확인</label>
        <input id="passwordConfirm" type="password" placeholder="비밀번호 다시 입력" autocomplete="new-password">

        <button class="btn" id="submitBtn" type="submit">가입하기</button>
        <a class="btn secondary" href="/">로그인으로 돌아가기</a>

        <div class="status" id="status" aria-live="polite"></div>
      </form>

      <div class="footer">THE POWER TO ATTRACT PEOPLE</div>
    </section>
  </main>
</div>

<script>
(() => {
  const AUTH_WORKER_URL = "https://login.tonest-admin.workers.dev";

  const form = document.getElementById("signupForm");
  const displayName = document.getElementById("displayName");
  const email = document.getElementById("email");
  const phone = document.getElementById("phone");
  const password = document.getElementById("password");
  const passwordConfirm = document.getElementById("passwordConfirm");
  const submitBtn = document.getElementById("submitBtn");
  const status = document.getElementById("status");

  const setStatus = (message, type = "") => {
    status.textContent = message || "";
    status.className = "status" + (type ? " " + type : "");
  };

  function normalizePhone(value) {
    return String(value || "").trim();
  }

  async function submitSignup(event) {
    event.preventDefault();

    const nameValue = (displayName.value || "").trim();
    const emailValue = (email.value || "").trim().toLowerCase();
    const phoneValue = normalizePhone(phone.value);
    const passwordValue = password.value || "";
    const confirmValue = passwordConfirm.value || "";

    if (!nameValue) {
      setStatus("이름을 입력해주세요.", "error");
      displayName.focus();
      return;
    }

    if (!emailValue) {
      setStatus("이메일을 입력해주세요.", "error");
      email.focus();
      return;
    }

    if (passwordValue.length < 8) {
      setStatus("비밀번호는 8자 이상 입력해주세요.", "error");
      password.focus();
      return;
    }

    if (passwordValue !== confirmValue) {
      setStatus("비밀번호 확인이 일치하지 않습니다.", "error");
      passwordConfirm.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "가입 처리 중...";
    setStatus("가입 요청을 처리하고 있습니다...");

    try {
      const response = await fetch(AUTH_WORKER_URL + "/signup", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          display_name: nameValue,
          email: emailValue,
          phone: phoneValue,
          password: passwordValue
        })
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result.ok) {
        throw new Error(result.message || "회원가입에 실패했습니다.");
      }

      form.reset();

      if (result.requiresEmailConfirmation) {
        setStatus(
          "가입 요청이 완료되었습니다.\n이메일 인증 후 관리자 승인이 완료되면 로그인할 수 있습니다.",
          "success"
        );
      } else {
        setStatus(
          "가입 요청이 완료되었습니다.\n관리자 승인 후 로그인할 수 있습니다.",
          "success"
        );
      }
    } catch (error) {
      setStatus(error?.message || "회원가입에 실패했습니다.", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "가입하기";
    }
  }

  form.addEventListener("submit", submitSignup);

  const params = new URLSearchParams(location.search);
  if (params.get("verified") === "1") {
    setStatus(
      "이메일 인증이 완료되었습니다.\n관리자 승인 후 로그인할 수 있습니다.",
      "success"
    );
  }
})();
</script>
</body>
</html>
