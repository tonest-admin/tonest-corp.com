<script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=add4ce93b38c0ff9d9b9053728e067b3&autoload=false&libraries=services"></script>
<script src="/board-menu.js?v=6" defer></script>

<style>
:root{
  --bg:#eef6f4;--card:#fff;--line:#cfdcda;--line2:#bccbc8;
  --text:#10191b;--muted:#405452;--primary:#16a7a4;--primary2:#118b89;
  --blue:#2563eb;--green:#15803d;--amber:#a16207;--red:#dc2626;
  --shadow:0 10px 28px rgba(15,45,47,.10);
  --font:"Pretendard Variable","Pretendard","Segoe UI","Noto Sans KR",system-ui,-apple-system,sans-serif
}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;font-family:var(--font);color:var(--text);background:var(--bg);-webkit-font-smoothing:auto;text-rendering:auto}
body{overflow:hidden}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}

.app{height:100dvh;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto}
.topbar{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);background:#fff;z-index:40}
.menuBtn{width:42px;height:42px;flex:0 0 42px;padding:0;border:0;border-radius:12px;background:#fff;display:grid;place-items:center}
.menuBtn:hover{background:#eaf8f6}
.menuBtn img{width:36px;height:36px;display:block;object-fit:contain}
.titleBlock{min-width:0}
.title{font-size:21px;line-height:1.05;font-weight:950;letter-spacing:-.035em}
.subtitle{margin-top:3px;color:var(--muted);font-size:11px;font-weight:800}
.grow{flex:1}
.pill{min-height:34px;display:inline-flex;align-items:center;padding:0 11px;border:1px solid var(--line2);border-radius:999px;background:#f8fbfa;color:#2c423f;font-size:11.5px;font-weight:900;white-space:nowrap}

.btn{min-height:36px;display:inline-flex;align-items:center;justify-content:center;padding:0 12px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:#263a37;font-size:12px;font-weight:900;white-space:nowrap}
.btn:hover{border-color:#86cac4;background:#f7fcfb}
.btn.primary{border-color:var(--primary);background:linear-gradient(180deg,#22b7b2,#16a7a4);color:#fff}
.btn.blue{border-color:#bfdbfe;background:#eff6ff;color:var(--blue)}
.btn.green{border-color:#bbf7d0;background:#effcf3;color:var(--green)}
.btn.amber{border-color:#fde68a;background:#fff9e8;color:var(--amber)}
.btn.danger{border-color:#fecaca;background:#fff;color:var(--red)}
.btn:disabled{opacity:.45;cursor:not-allowed}

.searchbar{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(150px,.9fr) 118px auto auto;gap:8px;align-items:center;padding:9px 12px;border-bottom:1px solid var(--line);background:#f8fbfa;z-index:35}
.control{width:100%;height:38px;padding:0 10px;border:1px solid #bdcdca;border-radius:10px;background:#fff;color:#152522;outline:none;font-size:12.5px;font-weight:800}
.control:focus{border-color:#65bfb8;box-shadow:0 0 0 3px rgba(22,167,164,.10)}

.workspace{min-height:0;display:grid;grid-template-columns:390px minmax(0,1fr);transition:grid-template-columns .18s ease}
.workspace.collapsed{grid-template-columns:0 minmax(0,1fr)}
.side{min-width:0;min-height:0;overflow:auto;border-right:1px solid var(--line);background:#f7fbfa}
.workspace.collapsed .side{width:0;overflow:hidden;border-right:0;opacity:0;pointer-events:none}
.sideInner{display:grid;gap:9px;padding:10px}
.card{border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:0 5px 18px rgba(15,45,47,.05)}
.cardHead{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 12px;border-bottom:1px solid #e5edeb}
.cardHead strong{font-size:13px;font-weight:950}
.cardHead span{color:var(--muted);font-size:10.5px;font-weight:800}
.routeList{max-height:31vh;overflow:auto;padding:8px;display:grid;gap:6px}
.routeItem{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:11px;background:#fff;text-align:left}
.routeItem:hover,.routeItem.active{border-color:#71c7c0;background:#f1fbf9}
.routeTop{display:flex;align-items:center;gap:6px}
.routeCode{min-width:0;flex:1;font-size:13px;font-weight:950}
.polyBadge{min-height:19px;display:inline-flex;align-items:center;padding:0 6px;border-radius:999px;border:1px solid #d6e3e1;background:#f8fbfa;color:#536866;font-size:8.5px;font-weight:900}
.polyBadge.yes{border-color:#a7e2d6;background:#ebfaf6;color:#047857}
.routeMeta{margin-top:4px;color:#526663;font-size:10.5px;line-height:1.45;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.editor{padding:11px}
.selectedMeta{margin-bottom:10px;padding:9px 10px;border:1px solid #d9e6e4;border-radius:10px;background:#f7fbfa;color:#3f5552;font-size:10.5px;line-height:1.45;font-weight:800}
.field{display:grid;gap:5px;margin-bottom:9px}
.field label{color:#3f5552;font-size:10.5px;font-weight:900}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.buttonGrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.empty{padding:22px 12px;color:#596d69;font-size:11px;font-weight:800;text-align:center}

.mapPane{position:relative;min-width:0;min-height:0;background:#e9f1ef}
#map{position:absolute;inset:0}
.mapTools{position:absolute;top:10px;right:10px;z-index:20;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100% - 70px)}
.mapTools .btn,.sideToggle{box-shadow:0 7px 20px rgba(15,45,47,.13)}
.sideToggle{position:absolute;top:10px;left:10px;z-index:22;width:38px;min-width:38px;padding:0}
.hint{position:absolute;left:50%;top:62px;z-index:24;display:none;max-width:calc(100% - 40px);padding:8px 12px;transform:translateX(-50%);border-radius:999px;background:rgba(17,27,29,.90);color:#fff;font-size:10.5px;font-weight:850;text-align:center}
.hint.show{display:block}
.routeLabel{min-width:54px;padding:4px 7px;border-radius:8px;border:1px solid rgba(15,45,47,.15);background:rgba(255,255,255,.94);color:#102522;box-shadow:0 3px 10px rgba(15,45,47,.13);font-size:9.5px;font-weight:950;line-height:1.2;text-align:center;pointer-events:none}

.footer{min-height:35px;display:flex;align-items:center;gap:9px;padding:5px 12px;border-top:1px solid var(--line);background:#fff;color:#405452;font-size:10.5px;font-weight:850;z-index:40}
.footer.error{color:var(--red)}
.ready{min-height:22px;display:inline-flex;align-items:center;padding:0 8px;border:1px solid #bbf7d0;border-radius:999px;background:#f0fdf4;color:#15803d;font-size:9px;font-weight:900}

@media(max-width:920px){
  .topbar{flex-wrap:wrap}.grow{display:none}.pill{order:3;width:100%}
  .searchbar{grid-template-columns:1fr 1fr}
  .workspace,.workspace.collapsed{display:block}
  .side,.workspace.collapsed .side{position:absolute;left:0;top:0;bottom:0;z-index:30;width:min(90vw,390px);opacity:1;overflow:auto;transform:translateX(-103%);transition:transform .18s ease;pointer-events:auto;border-right:1px solid var(--line);box-shadow:0 14px 38px rgba(15,45,47,.20)}
  .workspace.mobileOpen .side,.workspace.collapsed.mobileOpen .side{transform:translateX(0)}
  .mapPane{position:absolute;inset:0}
}
</style>
</head>

<body>
<div class="app">

