  const night=row.vendor_name_1w||row.vendor_1w_name||"-";

  dom.selectedMeta.textContent=
    `입차지 : ${text(row.delivery_location_name)||"-"}
`+
    `주간 : ${day}
`+
    `야간 : ${night}
`+
    `${row.polygon_wgs84?"폴리곤 등록":"폴리곤 미등록"}`;

  if(pack.polygons.length){
    const bounds=new kakao.maps.LatLngBounds();
    pack.polygons.forEach(poly=>polygonPathToArray(poly).forEach(p=>bounds.extend(p)));
