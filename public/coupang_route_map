<script>
(() => {
"use strict";

const AUTH_BASE = location.origin;
const ROUTE_API = "https://route.tonest-admin.workers.dev";
const $ = s => document.querySelector(s);

const dom = {
  workspace:$("#workspace"), userPill:$("#userPill"), reloadBtn:$("#reloadBtn"),
  campInput:$("#campInput"), codeInput:$("#codeInput"), modeSelect:$("#modeSelect"),
  searchBtn:$("#searchBtn"), clearBtn:$("#clearBtn"), routeList:$("#routeList"),
  routeCount:$("#routeCount"), editorCard:$("#editorCard"), selectedId:$("#selectedId"),
  selectedMeta:$("#selectedMeta"), editCamp:$("#editCamp"), editCode:$("#editCode"),
  deliveryName:$("#deliveryName"), deliveryAddress:$("#deliveryAddress"),
  drawNewBtn:$("#drawNewBtn"), drawAddBtn:$("#drawAddBtn"),
  editPolygonBtn:$("#editPolygonBtn"), saveBtn:$("#saveBtn"),
  deleteBtn:$("#deleteBtn"), cancelEditBtn:$("#cancelEditBtn"),
  sideToggle:$("#sideToggle"), fitBtn:$("#fitBtn"), labelBtn:$("#labelBtn"),
  mapTypeBtn:$("#mapTypeBtn"), hint:$("#hint"), footer:$("#footer"), status:$("#status")
};

const state = {
  sb:null, session:null, profile:null, canEdit:false,
  map:null, isRoadmap:true, labelOn:true,
  rows:[], selectedId:null, selectedOriginal:null, overlays:new Map(),
  drawing:null, drawPoints:[], drawMarkers:[], drawLine:null,
  editing:false, editMarkers:[]
};

const roleLabel = role => ({
  super_admin:"최고관리자",
  admin:"관리자",
  team_leader:"팀장",
  driver:"기사"
})[role] || role || "-";

const text = v => String(v ?? "").trim();

function status(message,error=false){
  dom.status.textContent=message||"";
  dom.footer.classList.toggle("error",Boolean(error));
}

function showHint(message=""){
  dom.hint.textContent=message;
  dom.hint.classList.toggle("show",Boolean(message));
}

function hash32(value){
  let h=2166136261;
  for(const ch of String(value||"")){
    h^=ch.charCodeAt(0);
    h=Math.imul(h,16777619);
  }
  return h>>>0;
}

function routeColor(row){
  const key=text(row?.full_code||row?.code||row?.id);
  return `hsl(${hash32(key)%360} 70% 45%)`;
}

function parsePolygonWgs84(value){
  if(!value)return null;
  if(Array.isArray(value))return value;
  if(typeof value==="string"){
    try{
      const p=JSON.parse(value);
      return Array.isArray(p)?p:null;
    }catch{return null}
  }
  return null;
}

function normalizeRings(value){
  if(!Array.isArray(value)||!value.length)return[];
  const first=value[0];
  if(Array.isArray(first)&&first.length>=2&&typeof first[0]==="number")return[value];
  if(Array.isArray(first)&&Array.isArray(first[0]))return value;
  return[];
}

function ringToLatLngs(ring){
  return (Array.isArray(ring)?ring:[])
    .map(p=>{
      if(!Array.isArray(p)||p.length<2)return null;
      const lng=Number(p[0]),lat=Number(p[1]);
      return Number.isFinite(lat)&&Number.isFinite(lng)
        ? new kakao.maps.LatLng(lat,lng)
        : null;
    })
    .filter(Boolean);
}

function polygonPathToArray(polygon){
  const path=polygon?.getPath?.();
  if(!path)return[];
  if(Array.isArray(path))return path;
  if(typeof path.getLength==="function"&&typeof path.getAt==="function"){
    const out=[];
    for(let i=0;i<path.getLength();i++)out.push(path.getAt(i));
    return out;
  }
  return[];
}

function polygonsToWgs84(polygons){
  const out=[];
  for(const polygon of polygons||[]){
    const ring=polygonPathToArray(polygon).map(ll=>[ll.getLng(),ll.getLat()]);
    if(ring.length>=3)out.push(ring);
  }
  return out.length?out:null;
}

function centroid(points){
  let lat=0,lng=0;
  for(const p of points){lat+=p.getLat();lng+=p.getLng()}
  return new kakao.maps.LatLng(lat/points.length,lng/points.length);
}

function makeDotImage({size=12,fill="#fff",stroke="#0f172a",strokeWidth=2}={}){
  const c=size/2,r=Math.max(1,c-strokeWidth/2);
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}"><circle cx="${c}" cy="${c}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeWidth}"/></svg>`;
  return new kakao.maps.MarkerImage(
    "data:image/svg+xml;charset=utf-8,"+encodeURIComponent(svg),
    new kakao.maps.Size(size,size),
    {offset:new kakao.maps.Point(c,c)}
  );
}

let __editDot,__drawDot;
const editDotImage=()=>__editDot||(__editDot=makeDotImage());
const drawDotImage=()=>__drawDot||(__drawDot=makeDotImage({size:10,fill:"#16a7a4",stroke:"#fff"}));

async function currentAccessToken(forceRefresh=false){
  if(!state.sb){
    throw new Error("Supabase 클라이언트가 준비되지 않았습니다.");
  }

  if(forceRefresh){
    const {data,error}=await state.sb.auth.refreshSession();
    if(error)throw error;

    state.session=data?.session||null;
  }else{
    const {data,error}=await state.sb.auth.getSession();
    if(error)throw error;

    state.session=data?.session||null;

    const expiresAt=Number(state.session?.expires_at||0);
    const now=Math.floor(Date.now()/1000);

    if(
      state.session?.refresh_token &&
      expiresAt &&
      expiresAt-now < 90
    ){
      const refreshed=await state.sb.auth.refreshSession();

      if(!refreshed.error){
        state.session=refreshed.data?.session||state.session;
      }
    }
  }

  return state.session?.access_token||"";
}

async function apiFetch(path,options={},retry=true){
  let token=await currentAccessToken(false);

  if(!token){
    throw new Error("로그인 세션이 없습니다.");
  }

  const headers=new Headers(options.headers||{});
  headers.set("Authorization","Bearer "+token);

  if(options.body&&!headers.has("Content-Type")){
    headers.set("Content-Type","application/json");
  }

  let response=await fetch(
    ROUTE_API+path,
    {...options,headers,cache:"no-store"}
  );

  if(response.status===401&&retry){
    token=await currentAccessToken(true);

    if(token){
      headers.set("Authorization","Bearer "+token);

      response=await fetch(
        ROUTE_API+path,
        {...options,headers,cache:"no-store"}
      );
    }
  }

  const payload=await response.json().catch(()=>({}));

  if(!response.ok){
    throw new Error(
      payload?.message||
      payload?.error||
      `HTTP ${response.status}`
    );
  }

  return payload;
}

async function initAuth(){
  const cfgRes=await fetch(AUTH_BASE+"/auth-config",{cache:"no-store"});
  const cfg=await cfgRes.json().catch(()=>({}));

  if(!cfgRes.ok||!cfg.supabaseUrl||!cfg.supabaseKey){
    throw new Error(cfg.message||"로그인 설정을 불러오지 못했습니다.");
  }

  state.sb=window.supabase.createClient(
    cfg.supabaseUrl,cfg.supabaseKey,
    {auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}}
  );

  const {data:{session},error:sessionError}=await state.sb.auth.getSession();

  if(sessionError)throw sessionError;

  if(!session?.access_token){
    location.replace("/?next=%2Fcoupang_route_map");
    return false;
  }

  state.session=session;

  // getUser() forces Supabase to validate the current session once.
  const userCheck=await state.sb.auth.getUser();

  if(userCheck.error){
    const refreshed=await state.sb.auth.refreshSession();

    if(refreshed.error||!refreshed.data?.session?.access_token){
      location.replace("/?next=%2Fcoupang_route_map");
      return false;
    }

    state.session=refreshed.data.session;
  }

  const me=await apiFetch("/me");
  state.profile=me.profile||{};
  state.canEdit=Boolean(me.canEdit);

  dom.userPill.textContent=
    `${state.profile.display_name||state.profile.email||session.user.email||"사용자"} · ${roleLabel(state.profile.role)}`;

  document.querySelectorAll(".editOnly").forEach(el=>{el.hidden=!state.canEdit});
  [dom.editCamp,dom.editCode,dom.deliveryName,dom.deliveryAddress].forEach(el=>{el.disabled=!state.canEdit});

  return true;
}

function clearOverlays(){
  stopEditMode();
  stopDrawMode();

  for(const pack of state.overlays.values()){
    pack.polygons.forEach(p=>p.setMap(null));
    pack.labels.forEach(l=>l.setMap(null));
  }
  state.overlays.clear();
}

function makeLabel(row,position){
  const node=document.createElement("div");
  node.className="routeLabel";
  node.textContent=text(row.full_code||row.code||"-");
  return new kakao.maps.CustomOverlay({position,content:node,yAnchor:1,zIndex:9});
}

function renderRows(fit=true){
  clearOverlays();
  const bounds=new kakao.maps.LatLngBounds();
  let any=false;

  for(const row of state.rows){
    const id=String(row.id??`${row.camp}/${row.full_code||row.code}`);
    const color=routeColor(row);
    const rings=normalizeRings(parsePolygonWgs84(row.polygon_wgs84));
    const pack={row,polygons:[],labels:[]};

    for(const ring of rings){
      const pts=ringToLatLngs(ring);
      if(pts.length<3)continue;

      const polygon=new kakao.maps.Polygon({
        path:pts,strokeWeight:2,strokeColor:color,strokeOpacity:.95,
        fillColor:color,fillOpacity:.22,zIndex:2
      });

      polygon.setMap(state.map);
      kakao.maps.event.addListener(polygon,"click",()=>selectRoute(id));
      pack.polygons.push(polygon);
      pts.forEach(p=>bounds.extend(p));

      if(state.labelOn){
        const label=makeLabel(row,centroid(pts));
        label.setMap(state.map);
        pack.labels.push(label);
      }
      any=true;
    }

    state.overlays.set(id,pack);
  }

  if(fit&&any)state.map.setBounds(bounds);
  renderRouteList();
}

function renderRouteList(){
  dom.routeList.replaceChildren();
  dom.routeCount.textContent=`${state.rows.length.toLocaleString()}건`;

  if(!state.rows.length){
    const empty=document.createElement("div");
    empty.className="empty";
    empty.textContent="조회된 라우트가 없습니다.";
    dom.routeList.appendChild(empty);
    return;
  }

  for(const row of state.rows){
    const id=String(row.id??`${row.camp}/${row.full_code||row.code}`);
    const btn=document.createElement("button");
    btn.type="button";
    btn.className="routeItem"+(String(state.selectedId)===id?" active":"");
    btn.dataset.id=id;

    const top=document.createElement("div");
    top.className="routeTop";

    const code=document.createElement("div");
    code.className="routeCode";
    code.textContent=`${row.camp||"-"} · ${row.full_code||row.code||"-"}`;

    const badge=document.createElement("span");
    badge.className="polyBadge"+(row.polygon_wgs84?" yes":"");
    badge.textContent=row.polygon_wgs84?"폴리곤":"미등록";

    const meta=document.createElement("div");
    meta.className="routeMeta";
    const day=row.vendor_name_2w||row.vendor_2w_name||"-";
    const night=row.vendor_name_1w||row.vendor_1w_name||"-";
    meta.textContent=`${row.delivery_location_name||"입차지 미지정"} · 주 ${day} · 야 ${night}`;

    top.append(code,badge);
    btn.append(top,meta);
    dom.routeList.appendChild(btn);
  }
}

function selectedPack(){
  return state.overlays.get(String(state.selectedId))||null;
}

function selectRoute(id){
  stopEditMode();
  stopDrawMode();

  const pack=state.overlays.get(String(id));
  if(!pack)return;

  const row=pack.row;
  state.selectedId=String(id);
  state.selectedOriginal=JSON.parse(JSON.stringify(row));

  dom.editorCard.hidden=false;
  dom.selectedId.textContent=`ID ${row.id??"-"}`;
  dom.editCamp.value=text(row.camp);
  dom.editCode.value=text(row.full_code||row.code);
  dom.deliveryName.value=text(row.delivery_location_name);
  dom.deliveryAddress.value=text(row.delivery_location_address);

  const day=row.vendor_name_2w||row.vendor_2w_name||"-";
  const night=row.vendor_name_1w||row.vendor_1w_name||"-";

  dom.selectedMeta.textContent=
    `주간 ${day} · 야간 ${night} · ${row.polygon_wgs84?"폴리곤 등록":"폴리곤 미등록"}`;

  if(pack.polygons.length){
    const bounds=new kakao.maps.LatLngBounds();
    pack.polygons.forEach(poly=>polygonPathToArray(poly).forEach(p=>bounds.extend(p)));
    state.map.setBounds(bounds);
  }

  renderRouteList();

  if(window.matchMedia("(max-width:920px)").matches){
    dom.workspace.classList.remove("mobileOpen");
  }
}

function stopEditMode(){
  state.editMarkers.forEach(m=>m.setMap(null));
  state.editMarkers=[];
  state.editing=false;
}

function enterEditMode(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack||!pack.polygons.length){
    status("편집할 폴리곤이 없습니다.",true);
    return;
  }

  stopEditMode();
  stopDrawMode();
  state.editing=true;

  for(const polygon of pack.polygons){
    const points=polygonPathToArray(polygon);

    for(let i=0;i<points.length;i++){
      const marker=new kakao.maps.Marker({
        position:points[i],draggable:true,image:editDotImage(),zIndex:100
      });

      marker.setMap(state.map);

      kakao.maps.event.addListener(marker,"dragend",()=>{
        const current=polygonPathToArray(polygon).slice();
        current[i]=marker.getPosition();
        polygon.setPath(current);
      });

      kakao.maps.event.addListener(marker,"rightclick",()=>{
        const current=polygonPathToArray(polygon).slice();
        if(current.length<=3){
          status("폴리곤은 최소 3점이 필요합니다.",true);
          return;
        }
        current.splice(i,1);
        polygon.setPath(current);
        enterEditMode();
      });

      state.editMarkers.push(marker);
    }
  }

  showHint("점 편집: 흰 점 드래그 · 우클릭으로 점 삭제");
  status("폴리곤 점 편집 모드");
}

function stopDrawMode(){
  state.drawing=null;
  state.drawPoints=[];
  state.drawMarkers.forEach(m=>m.setMap(null));
  state.drawMarkers=[];
  if(state.drawLine){state.drawLine.setMap(null);state.drawLine=null}
  showHint("");
}

function addDrawPoint(latlng){
  state.drawPoints.push(latlng);
  const marker=new kakao.maps.Marker({position:latlng,image:drawDotImage(),zIndex:120});
  marker.setMap(state.map);
  state.drawMarkers.push(marker);
  state.drawLine.setPath(state.drawPoints);
}

function popDrawPoint(){
  if(!state.drawPoints.length)return;
  state.drawPoints.pop();
  const marker=state.drawMarkers.pop();
  marker?.setMap(null);
  state.drawLine.setPath(state.drawPoints);
}

function createDraftFromInputs(){
  const camp=text(dom.campInput.value);
  const code=text(dom.codeInput.value).toUpperCase();

  if(!camp||!code){
    status("신규 라우트는 캠프와 라우트 코드를 먼저 입력하세요.",true);
    return false;
  }

  const id=`draft:${camp}:${code}`;
  const row={
    id:null,camp,code,full_code:code,polygon_wgs84:null,
    delivery_location_name:"",delivery_location_address:"",__draft:true
  };

  state.rows.push(row);
  state.overlays.set(id,{row,polygons:[],labels:[]});
  selectRoute(id);
  return true;
}

function beginDraw(mode){
  if(!state.canEdit)return;

  if(!state.selectedId&&!createDraftFromInputs())return;
  const pack=selectedPack();

  if(!pack){
    status("라우트를 먼저 선택하세요.",true);
    return;
  }

  stopEditMode();
  stopDrawMode();

  state.drawing=mode;
  state.drawLine=new kakao.maps.Polyline({
    path:[],strokeWeight:2,strokeColor:"#16a7a4",strokeOpacity:.95,strokeStyle:"shortdash"
  });
  state.drawLine.setMap(state.map);

  showHint("지도 클릭=점 추가 · Enter=완료 · 우클릭=마지막 점 취소 · ESC=취소");
  status(mode==="new"?"새 폴리곤 그리기 시작":"추가 구역 그리기 시작");
}

function finishDraw(){
  if(!state.drawing)return;

  if(state.drawPoints.length<3){
    status("점이 3개 이상 필요합니다.",true);
    return;
  }

  const pack=selectedPack();
  if(!pack)return;

  const color=routeColor(pack.row);
  const polygon=new kakao.maps.Polygon({
    path:state.drawPoints.slice(),
    strokeWeight:2,strokeColor:color,strokeOpacity:.95,
    fillColor:color,fillOpacity:.22,zIndex:4
  });

  polygon.setMap(state.map);
  kakao.maps.event.addListener(polygon,"click",()=>selectRoute(state.selectedId));

  if(state.drawing==="new"){
    pack.polygons.forEach(p=>p.setMap(null));
    pack.polygons=[polygon];
  }else{
    pack.polygons.push(polygon);
  }

  stopDrawMode();
  status("폴리곤 생성 완료 · 저장 버튼을 눌러 서버에 반영하세요.");
}

async function saveSelected(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack){
    status("저장할 라우트가 없습니다.",true);
    return;
  }

  const camp=text(dom.editCamp.value);
  const code=text(dom.editCode.value).toUpperCase();

  if(!camp||!code){
    status("캠프와 라우트 코드는 필수입니다.",true);
    return;
  }

  const payload={
    camp,code,
    delivery_location_name:text(dom.deliveryName.value)||null,
    delivery_location_address:text(dom.deliveryAddress.value)||null,
    polygon_wgs84:polygonsToWgs84(pack.polygons)
  };

  status("라우트 저장 중...");

  if(pack.row.id==null){
    await apiFetch("/routes",{method:"POST",body:JSON.stringify(payload)});
    status("신규 라우트를 저장했습니다.");
  }else{
    await apiFetch("/routes/"+pack.row.id,{method:"PATCH",body:JSON.stringify(payload)});
    status("라우트 통합 데이터를 동기화하고 저장했습니다.");
  }

  dom.campInput.value=camp;
  dom.codeInput.value=code;
  dom.modeSelect.value="exact";
  await loadRoutes();
}

async function deleteSelected(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack||pack.row.id==null){
    status("서버에 저장된 라우트만 삭제할 수 있습니다.",true);
    return;
  }

  const label=`${pack.row.camp} / ${pack.row.full_code||pack.row.code}`;

  if(!confirm(`${label} 라우트를 통합 데이터에서 삭제할까요?\n연결 데이터도 MAROOWELL route-master 삭제 로직으로 처리됩니다.`)){
    return;
  }

  status("라우트 삭제 중...");
  await apiFetch("/routes/"+pack.row.id,{method:"DELETE"});
  state.selectedId=null;
  dom.editorCard.hidden=true;
  status("라우트를 삭제했습니다.");
  await loadRoutes();
}

async function loadRoutes(){
  const camp=text(dom.campInput.value);
  const code=text(dom.codeInput.value);

  if(!camp){
    status("캠프를 입력하세요.",true);
    dom.campInput.focus();
    return;
  }

  status("라우트 조회 중...");

  const p=new URLSearchParams({camp,mode:dom.modeSelect.value||"prefix"});
  if(code)p.set("code",code);

  const payload=await apiFetch("/routes?"+p.toString());
  state.rows=Array.isArray(payload?.rows)?payload.rows:[];
  state.selectedId=null;
  state.selectedOriginal=null;
  dom.editorCard.hidden=true;

  renderRows(true);
  status(`라우트 ${state.rows.length.toLocaleString()}건을 불러왔습니다.`);
}

function fitAll(){
  const bounds=new kakao.maps.LatLngBounds();
  let count=0;

  for(const pack of state.overlays.values()){
    for(const poly of pack.polygons){
      for(const p of polygonPathToArray(poly)){
        bounds.extend(p);count++;
      }
    }
  }

  if(count)state.map.setBounds(bounds);
}

function rebuildLabels(){
  for(const pack of state.overlays.values()){
    pack.labels.forEach(l=>l.setMap(null));
    pack.labels=[];

    if(!state.labelOn)continue;

    for(const poly of pack.polygons){
      const pts=polygonPathToArray(poly);
      if(pts.length<3)continue;
      const label=makeLabel(pack.row,centroid(pts));
      label.setMap(state.map);
      pack.labels.push(label);
    }
  }

  dom.labelBtn.textContent=state.labelOn?"라벨 ON":"라벨 OFF";
}

function toggleSidebar(){
  const mobile=window.matchMedia("(max-width:920px)").matches;

  if(mobile){
    dom.workspace.classList.toggle("mobileOpen");
    dom.sideToggle.textContent=dom.workspace.classList.contains("mobileOpen")?"◀":"▶";
  }else{
    dom.workspace.classList.toggle("collapsed");
    dom.sideToggle.textContent=dom.workspace.classList.contains("collapsed")?"▶":"◀";
  }

  const center=state.map.getCenter();

  setTimeout(()=>{
    state.map.relayout();
    state.map.setCenter(center);
  },200);
}

function bindEvents(){
  const run=()=>loadRoutes().catch(e=>status(e?.message||String(e),true));

  dom.searchBtn.addEventListener("click",run);
  dom.reloadBtn.addEventListener("click",run);

  dom.clearBtn.addEventListener("click",()=>{
    dom.campInput.value="";
    dom.codeInput.value="";
    state.rows=[];
    state.selectedId=null;
    dom.editorCard.hidden=true;
    clearOverlays();
    renderRouteList();
    status("조회 조건을 초기화했습니다.");
  });

  dom.routeList.addEventListener("click",e=>{
    const item=e.target.closest("[data-id]");
    if(item)selectRoute(item.dataset.id);
  });

  dom.sideToggle.addEventListener("click",toggleSidebar);
  dom.fitBtn.addEventListener("click",fitAll);

  dom.labelBtn.addEventListener("click",()=>{
    state.labelOn=!state.labelOn;
    rebuildLabels();
  });

  dom.mapTypeBtn.addEventListener("click",()=>{
    state.isRoadmap=!state.isRoadmap;
    state.map.setMapTypeId(
      state.isRoadmap?kakao.maps.MapTypeId.ROADMAP:kakao.maps.MapTypeId.SKYVIEW
    );
    dom.mapTypeBtn.textContent=state.isRoadmap?"위성":"일반지도";
  });

  dom.drawNewBtn.addEventListener("click",()=>beginDraw("new"));
  dom.drawAddBtn.addEventListener("click",()=>beginDraw("add"));
  dom.editPolygonBtn.addEventListener("click",enterEditMode);

  dom.saveBtn.addEventListener("click",()=>{
    saveSelected().catch(e=>status(e?.message||String(e),true));
  });

  dom.deleteBtn.addEventListener("click",()=>{
    deleteSelected().catch(e=>status(e?.message||String(e),true));
  });

  dom.cancelEditBtn.addEventListener("click",()=>{
    stopEditMode();stopDrawMode();status("편집 모드를 종료했습니다.");
  });

  dom.codeInput.addEventListener("keydown",e=>{
    if(e.key==="Enter")run();
  });

  kakao.maps.event.addListener(state.map,"click",e=>{
    if(state.drawing&&e?.latLng)addDrawPoint(e.latLng);
  });

  kakao.maps.event.addListener(state.map,"rightclick",()=>{
    if(state.drawing)popDrawPoint();
  });

  document.addEventListener("keydown",e=>{
    if(e.key==="Enter"&&state.drawing){
      e.preventDefault();
      finishDraw();
    }

    if(e.key==="Escape"&&(state.drawing||state.editing)){
      stopDrawMode();stopEditMode();status("편집을 취소했습니다.");
    }
  });

  window.addEventListener("resize",()=>{
    const center=state.map.getCenter();
    state.map.relayout();
    state.map.setCenter(center);
  });
}

async function init(){
  // 지도 자체는 인증과 분리해서 먼저 생성.
  state.map=new kakao.maps.Map($("#map"),{
    center:new kakao.maps.LatLng(36.45,127.85),
    level:13
  });

  bindEvents();

  document.documentElement.style.visibility="visible";
  status("지도 준비 완료 · 로그인 권한 확인 중...");

  try{
    const ok=await initAuth();
    if(!ok)return;

    status(state.canEdit?"조회 · 수정 가능":"조회 전용 권한");
  }catch(error){
    console.error(error);

    // 지도는 그대로 유지하고, 조회/수정 기능만 잠근다.
    dom.searchBtn.disabled=true;
    dom.reloadBtn.disabled=true;
    document.querySelectorAll(".editOnly").forEach(el=>{el.hidden=true});

    status(
      "지도는 정상 로드되었습니다. 로그인 권한 확인 실패: "+
      (error?.message||String(error)),
      true
    );
  }
}

if(window.kakao?.maps){
  kakao.maps.load(()=>{
    init().catch(e=>{
      console.error(e);
      document.documentElement.style.visibility="visible";
      status(e?.message||String(e),true);
    });
  });
}else{
  document.documentElement.style.visibility="visible";
  status("카카오 지도 SDK를 불러오지 못했습니다.",true);
}
})();
</script>
</body>
</html>
