async function initAuth(){
  const cfgRes=await fetch(AUTH_BASE+"/auth-config",{cache:"no-store"});
  const cfg=await cfgRes.json().catch(()=>({}));

  if(!cfgRes.ok||!cfg.supabaseUrl||!cfg.supabaseKey){
    throw new Error(cfg.message||"로그인 설정을 불러오지 못했습니다.");
  }

  state.sb=window.supabase.createClient(
    cfg.supabaseUrl,cfg.supabaseKey,
    {auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}}
  );

  const {data:{session},error:sessionError}=await state.sb.auth.getSession();

  if(sessionError)throw sessionError;

  if(!session?.access_token){
    location.replace("/?next=%2Fcoupang_route_map");
    return false;
  }

  state.session=session;

  // getUser() forces Supabase to validate the current session once.
  const userCheck=await state.sb.auth.getUser();

  if(userCheck.error){
    const refreshed=await state.sb.auth.refreshSession();

    if(refreshed.error||!refreshed.data?.session?.access_token){
      location.replace("/?next=%2Fcoupang_route_map");
      return false;
    }

    state.session=refreshed.data.session;
  }

  const me=await apiFetch("/me");
  state.profile=me.profile||{};
  state.canEdit=Boolean(me.canEdit);

  dom.userPill.textContent=
    `${state.profile.display_name||state.profile.email||session.user.email||"사용자"} · ${roleLabel(state.profile.role)}`;

  document.querySelectorAll(".editOnly").forEach(el=>{el.hidden=!state.canEdit});
  [dom.editCamp,dom.editCode,dom.deliveryName,dom.deliveryAddress].forEach(el=>{el.disabled=!state.canEdit});

  return true;
}

