function stopEditMode(){
  state.editMarkers.forEach(m=>m.setMap(null));
  state.editMarkers=[];
  state.editing=false;
}

function enterEditMode(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack||!pack.polygons.length){
    status("편집할 폴리곤이 없습니다.",true);
    return;
  }

  stopEditMode();
  stopDrawMode();
  state.editing=true;

  for(const polygon of pack.polygons){
    const points=polygonPathToArray(polygon);

    for(let i=0;i<points.length;i++){
      const marker=new kakao.maps.Marker({
        position:points[i],draggable:true,image:editDotImage(),zIndex:100
      });

      marker.setMap(state.map);

      kakao.maps.event.addListener(marker,"dragend",()=>{
        const current=polygonPathToArray(polygon).slice();
        current[i]=marker.getPosition();
        polygon.setPath(current);
        rebuildLabels();
      });

      kakao.maps.event.addListener(marker,"rightclick",()=>{
        const current=polygonPathToArray(polygon).slice();
        if(current.length<=3){
          status("폴리곤은 최소 3점이 필요합니다.",true);
          return;
        }
        current.splice(i,1);
        polygon.setPath(current);
        rebuildLabels();
        enterEditMode();
      });

      state.editMarkers.push(marker);
    }

    for(let i=0;i<points.length;i++){
      const nextIndex=(i+1)%points.length;
      const a=points[i];
      const b=points[nextIndex];
      const mid=new kakao.maps.LatLng((a.getLat()+b.getLat())/2,(a.getLng()+b.getLng())/2);
      const midMarker=new kakao.maps.Marker({
        position:mid,draggable:true,
        image:makeDotImage({size:9,fill:"#94a3b8",stroke:"#fff",strokeWidth:2}),
        zIndex:95
      });
      midMarker.setMap(state.map);
      let inserted=false;
      const insertPoint=()=>{
        if(inserted)return;
        inserted=true;
        const current=polygonPathToArray(polygon).slice();
        current.splice(nextIndex,0,midMarker.getPosition());
        polygon.setPath(current);
        rebuildLabels();
        enterEditMode();
      };
      kakao.maps.event.addListener(midMarker,"click",insertPoint);
      kakao.maps.event.addListener(midMarker,"dragend",insertPoint);
      state.editMarkers.push(midMarker);
    }
  }

  showHint("점 편집: 흰 점 드래그 · 우클릭으로 점 삭제");
  status("폴리곤 점 편집 모드");
}

function stopDrawMode(){
  state.drawing=null;
  state.drawPoints=[];
  state.drawMarkers.forEach(m=>m.setMap(null));
  state.drawMarkers=[];
  if(state.drawLine){state.drawLine.setMap(null);state.drawLine=null}
  showHint("");
}

function addDrawPoint(latlng){
  state.drawPoints.push(latlng);
  const marker=new kakao.maps.Marker({position:latlng,image:drawDotImage(),zIndex:120});
  marker.setMap(state.map);
  state.drawMarkers.push(marker);
  state.drawLine.setPath(state.drawPoints);
}

function popDrawPoint(){
  if(!state.drawPoints.length)return;
  state.drawPoints.pop();
  const marker=state.drawMarkers.pop();
  marker?.setMap(null);
  state.drawLine.setPath(state.drawPoints);
}

function createDraftFromInputs(){
  const camp=text(dom.campInput.value);
  const codes=parseCodes(dom.codeInput.value);
  if(!camp||codes.length!==1){
    status("\uC2E0\uADDC \uB4F1\uB85D/\uADF8\uB9AC\uAE30\uB294 \uCEA0\uD504\uC640 \uB77C\uC6B0\uD2B8 \uCF54\uB4DC 1\uAC1C\uB97C \uC785\uB825\uD558\uC138\uC694.",true);
    return false;
  }
  const code=codes[0];
  const id=`draft:${camp}:${code}`;
  const row={id:null,camp,code,full_code:code,polygon_wgs84:null,delivery_location_name:"",delivery_location_address:"",__draft:true};
  state.rows.push(row);
  assignColors(state.rows);
  state.overlays.set(id,{row,polygons:[],labels:[]});
  selectRoute(id);
  renderRouteList();
  return true;
}

async function ensureSelectedForDraw(){
  if(state.selectedId)return true;
  const camp=text(dom.campInput.value);
  const codes=parseCodes(dom.codeInput.value);
  if(!camp){status("캠프를 입력하세요.",true);return false;}
  if(codes.length!==1){status("그리기는 라우트 코드 1개만 입력하세요.",true);return false;}
  const code=codes[0];
  const params=new URLSearchParams({camp,code,mode:"exact"});
  const payload=await apiFetch("/routes?"+params.toString());
  const rows=Array.isArray(payload?.rows)?payload.rows:[];
  if(rows.length){
    state.rows=rows;
    renderRows(true);
    const row=rows[0];
    selectRoute(String(row.id??`${row.camp}/${row.full_code||row.code}`));
    return true;
  }
  state.rows=[];
  state.selectedId=null;
  dom.editorCard.hidden=true;
  clearOverlays();
  dom.campInput.value=camp;
  dom.codeInput.value=code;
  return createDraftFromInputs();
}

function beginDraw(mode){
  if(!state.canEdit)return;

  if(!state.selectedId&&!createDraftFromInputs())return;
  const pack=selectedPack();

  if(!pack){
    status("라우트를 먼저 선택하세요.",true);
    return;
  }

  stopEditMode();
  stopDrawMode();

  state.drawing=mode;
  state.drawLine=new kakao.maps.Polyline({
    path:[],strokeWeight:2,strokeColor:"#16a7a4",strokeOpacity:.95,strokeStyle:"shortdash"
  });
  state.drawLine.setMap(state.map);

  showHint("지도 클릭=점 추가 · Enter=완료 · 우클릭=마지막 점 취소 · ESC=취소");
  status(mode==="new"?"새 폴리곤 그리기 시작":"추가 구역 그리기 시작");
}

function finishDraw(){
  if(!state.drawing)return;

  if(state.drawPoints.length<3){
    status("점이 3개 이상 필요합니다.",true);
    return;
  }

  const pack=selectedPack();
  if(!pack)return;

  const color=pack.row.__color||colorByIndex(0,hash32(pack.row.camp||"")%360);
  const polygon=new kakao.maps.Polygon({
    path:state.drawPoints.slice(),
    strokeWeight:2,strokeColor:color,strokeOpacity:.95,
    fillColor:color,fillOpacity:.22,zIndex:4
  });

  polygon.setMap(state.map);
  kakao.maps.event.addListener(polygon,"click",()=>selectRoute(state.selectedId));

  if(state.drawing==="new"){
    pack.polygons.forEach(p=>p.setMap(null));
    pack.polygons=[polygon];
  }else{
    pack.polygons.push(polygon);
  }

  stopDrawMode();
  status("폴리곤 생성 완료 · 저장 버튼을 눌러 서버에 반영하세요.");
}

async function saveSelected(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack){
    status("저장할 라우트가 없습니다.",true);
    return;
  }

  const camp=text(dom.editCamp.value);
  const code=text(dom.editCode.value).toUpperCase();

  if(!camp||!code){
    status("캠프와 라우트 코드는 필수입니다.",true);
    return;
  }

  const payload={
    camp,code,
    delivery_location_name:text(dom.deliveryName.value)||null,
    delivery_location_address:text(dom.deliveryAddress.value)||null,
    polygon_wgs84:polygonsToWgs84(pack.polygons)
  };

  status("라우트 저장 중...");

  let savedPayload=null;

  if(pack.row.id==null){
    savedPayload=await apiFetch(
      "/routes",
      {method:"POST",body:JSON.stringify(payload)}
    );
    status("신규 라우트를 MAROOWELL에 저장했습니다.");
  }else{
    savedPayload=await apiFetch(
      "/routes/"+pack.row.id,
      {method:"PATCH",body:JSON.stringify(payload)}
    );
    status("MAROOWELL 라우트 통합 데이터를 저장했습니다.");
  }

  const savedRow=
    savedPayload?.row||
    savedPayload?.route||
    savedPayload?.data||
    pack.row;

  await syncRouteInfoAfterMap(savedRow,camp,code);

  dom.campInput.value=camp;
  dom.codeInput.value=code;
  dom.modeSelect.value="exact";
  await loadRoutes();

  status(
    "저장 완료 · 폴리곤은 MAROOWELL, 라우트 정보는 TO:NEST에 연결되었습니다."
  );
}

async function deleteSelected(){
  if(!state.canEdit)return;
  const pack=selectedPack();

  if(!pack||pack.row.id==null){
    status("서버에 저장된 라우트만 삭제할 수 있습니다.",true);
    return;
  }

  const label=`${pack.row.camp} / ${pack.row.full_code||pack.row.code}`;

  if(!confirm(`${label} 라우트를 통합 데이터에서 삭제할까요?\n연결 데이터도 MAROOWELL route-master 삭제 로직으로 처리됩니다.`)){
    return;
  }

  status("라우트 삭제 중...");
  await apiFetch("/routes/"+pack.row.id,{method:"DELETE"});
  state.selectedId=null;
  dom.editorCard.hidden=true;
  status("라우트를 삭제했습니다.");
  await loadRoutes();
}

async function registerNewRoute(){
  if(!state.canEdit)return;
  const camp=text(dom.campInput.value);
  const codes=parseCodes(dom.codeInput.value);
  if(!camp){status("\uCEA0\uD504\uB97C \uC785\uB825\uD558\uC138\uC694.",true);return;}
  if(codes.length!==1){status("\uC2E0\uADDC \uB4F1\uB85D\uC740 \uB77C\uC6B0\uD2B8 \uCF54\uB4DC 1\uAC1C\uB9CC \uC785\uB825\uD558\uC138\uC694.",true);return;}
  const code=codes[0];
  status("\uC911\uBCF5 \uB77C\uC6B0\uD2B8 \uD655\uC778 \uC911...");
  const p=new URLSearchParams({camp,code,mode:"exact"});
  const payload=await apiFetch("/routes?"+p.toString());
  const rows=Array.isArray(payload?.rows)?payload.rows:[];
  if(rows.length){
    state.rows=rows;
    renderRows(true);
    const row=rows[0];
    selectRoute(String(row.id??`${row.camp}/${row.full_code||row.code}`));
    status("\uC774\uBBF8 \uB4F1\uB85D\uB41C \uB77C\uC6B0\uD2B8\uC785\uB2C8\uB2E4. \uAE30\uC874 \uB77C\uC6B0\uD2B8\uB97C \uC120\uD0DD\uD588\uC2B5\uB2C8\uB2E4.",true);
    return;
  }
  state.rows=[];
  state.selectedId=null;
  dom.editorCard.hidden=true;
  clearOverlays();
  dom.campInput.value=camp;
  dom.codeInput.value=code;
  createDraftFromInputs();
  status(`\uC2E0\uADDC \uB77C\uC6B0\uD2B8 ${camp} / ${code} \uB4F1\uB85D \uBAA8\uB4DC. \uC0C8\uB85C \uADF8\uB9AC\uAE30 \uD6C4 \uC800\uC7A5\uD558\uC138\uC694.`);
}

async function deletePolygonOnly(){
  if(!state.canEdit)return;
  const pack=selectedPack();
  if(!pack){status("\uC120\uD0DD\uB41C \uB77C\uC6B0\uD2B8\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.",true);return;}
  if(!confirm("\uC774 \uB77C\uC6B0\uD2B8\uC758 \uD3F4\uB9AC\uACE4\uB9CC \uC0AD\uC81C\uD560\uAE4C\uC694?\n\uB77C\uC6B0\uD2B8 \uD589\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."))return;
  if(pack.row.id==null){
    pack.polygons.forEach(p=>p.setMap(null));
    pack.polygons=[];
    rebuildLabels();
    status("\uC784\uC2DC \uD3F4\uB9AC\uACE4\uC744 \uC0AD\uC81C\uD588\uC2B5\uB2C8\uB2E4.");
    return;
  }
  const removed=await apiFetch("/routes/"+pack.row.id,{method:"PATCH",body:JSON.stringify({
    camp:text(pack.row.camp),
    code:text(pack.row.full_code||pack.row.code),
    delivery_location_name:text(pack.row.delivery_location_name)||null,
    delivery_location_address:text(pack.row.delivery_location_address)||null,
    polygon_wgs84:null
  })});

  await syncRouteInfoAfterMap(
    removed?.row||removed?.route||pack.row,
    text(pack.row.camp),
    text(pack.row.full_code||pack.row.code)
  );

  status("\uD3F4\uB9AC\uACE4 \uC0AD\uC81C \uC644\uB8CC \u00B7 TO:NEST \uC0C1\uD0DC \uB3D9\uAE30\uD654 \uC644\uB8CC");
  await loadRoutes();
}

async function loadRoutes(){
  const camp=text(dom.campInput.value);
  const codes=parseCodes(dom.codeInput.value);
  if(!camp){status("\uCEA0\uD504\uB97C \uC785\uB825\uD558\uC138\uC694.",true);dom.campInput.focus();return;}
  status("\uB77C\uC6B0\uD2B8 \uC870\uD68C \uC911...");
  const all=[];
  const seen=new Set();
  const append=rows=>{
    for(const row of rows||[]){
      const key=row.id!=null?`id:${row.id}`:`${row.camp}/${row.full_code||row.code}`;
      if(seen.has(key))continue;
      seen.add(key);all.push(row);
    }
  };
  const fetchOne=async code=>{
    const p=new URLSearchParams({camp,mode:dom.modeSelect.value||"prefix"});
    if(code)p.set("code",code);
    const payload=await apiFetch("/routes?"+p.toString());
    append(Array.isArray(payload?.rows)?payload.rows:[]);
  };
  if(!codes.length){await fetchOne("");}
  else{for(const code of codes){try{await fetchOne(code);}catch(error){console.warn("route lookup failed",code,error);}}}
  state.rows=all;
  state.selectedId=null;
  state.selectedOriginal=null;
  dom.editorCard.hidden=true;
  renderRows(true);
  status(all.length?`\uB85C\uB4DC \uC644\uB8CC: ${all.length}\uAC1C`:"\uC870\uD68C\uB41C \uB77C\uC6B0\uD2B8\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.");
}

function fitAll(){
  const bounds=new kakao.maps.LatLngBounds();
  let count=0;

  for(const pack of state.overlays.values()){
    for(const poly of pack.polygons){
      for(const p of polygonPathToArray(poly)){
        bounds.extend(p);count++;
      }
    }
  }

  if(count)state.map.setBounds(bounds);
}

function rebuildLabels(){
  for(const pack of state.overlays.values()){
    pack.labels.forEach(l=>l.setMap(null));
    pack.labels=[];
    if(!state.labelOn&&!state.vendorLabelOn)continue;
    for(const poly of pack.polygons){
      const pts=polygonPathToArray(poly);
      if(pts.length<3)continue;
      const label=makeLabel(pack.row,centroid(pts));
      label.setMap(state.map);
      pack.labels.push(label);
    }
  }
  dom.labelBtn.textContent=state.labelOn?"\uB77C\uC6B0\uD2B8 \uB77C\uBCA8 ON":"\uB77C\uC6B0\uD2B8 \uB77C\uBCA8 OFF";
  dom.vendorLabelBtn.textContent=state.vendorLabelOn?"\uBCA4\uB354 \uB77C\uBCA8 ON":"\uBCA4\uB354 \uB77C\uBCA8 OFF";
}

function toggleSidebar(){
  const mobile=window.matchMedia("(max-width:920px)").matches;

  if(mobile){
    dom.workspace.classList.toggle("mobileOpen");
    dom.sideToggle.textContent=dom.workspace.classList.contains("mobileOpen")?"◀":"▶";
  }else{
    dom.workspace.classList.toggle("collapsed");
    dom.sideToggle.textContent=dom.workspace.classList.contains("collapsed")?"▶":"◀";
  }

  const center=state.map.getCenter();

  setTimeout(()=>{
    state.map.relayout();
    state.map.setCenter(center);
  },200);
}

function createRoadviewWalker(position){
  const root=document.createElement("div");
  root.className="roadviewWalker";

  const cone=document.createElement("div");
  cone.className="roadviewWalkerCone";

  const halo=document.createElement("div");
  halo.className="roadviewWalkerHalo";

  const dot=document.createElement("div");
  dot.className="roadviewWalkerDot";

  root.append(cone,halo,dot);

  const overlay=new kakao.maps.CustomOverlay({
    position,
    content:root,
    xAnchor:.5,
    yAnchor:.5,
    zIndex:99
  });

  return {
    setMap(targetMap){
      overlay.setMap(targetMap);
    },

    setPosition(nextPosition){
      if(nextPosition){
        overlay.setPosition(nextPosition);
      }
    },

    setAngle(angle){
      const pan=((Number(angle)||0)%360+360)%360;
      cone.style.transform=
        `translateX(-50%) rotate(${pan}deg)`;
    }
  };
}

function syncRoadviewWalker(){
  if(!state.roadview||!state.map)return;

  const position=
    state.roadview.getPosition?.() ||
    state.map.getCenter();

  if(!state.roadviewWalker){
    state.roadviewWalker=
      createRoadviewWalker(position);
  }

  state.roadviewWalker.setPosition(position);

  if(state.roadviewOn){
    state.roadviewWalker.setMap(state.map);
  }

  const viewpoint=
    state.roadview.getViewpoint?.();

  if(viewpoint){
    state.roadviewWalker.setAngle(
      viewpoint.pan
    );
  }
}

function setRoadviewAt(latlng){
  if(!state.roadviewOn||!latlng)return;

  state.roadviewClient.getNearestPanoId(
    latlng,
    200,
    panoId=>{
      if(!panoId){
        status("근처 로드뷰가 없습니다.",true);
        return;
      }

      document
        .getElementById("mapWrap")
        ?.classList.add("roadview-open");

      state.roadview.setPanoId(
        panoId,
        latlng
      );

      syncRoadviewWalker();
      showHint("");

      setTimeout(()=>{
        try{
          state.map.relayout();
          state.roadview.relayout?.();
        }catch{}
      },80);

      status("로드뷰 표시 · 파란 표시가 현재 위치와 시야 방향입니다.");
    }
  );
}

function setRoadviewOn(on){
  state.roadviewOn=Boolean(on);

  dom.roadviewBtn.textContent=
    state.roadviewOn
      ? "로드뷰 종료"
      : "로드뷰";

  const wrap=
    document.getElementById(
      "mapWrap"
    );

  if(!state.roadviewOn){
    wrap?.classList.remove(
      "roadview-open"
    );

    try{
      state.map.removeOverlayMapTypeId(
        kakao.maps.MapTypeId.ROADVIEW
      );
    }catch{}

    state.roadviewWalker?.setMap(null);
    showHint("");

    setTimeout(()=>{
      try{
        state.map.relayout();
      }catch{}
    },80);

    status("로드뷰 종료");
    return;
  }

  try{
    state.map.addOverlayMapTypeId(
      kakao.maps.MapTypeId.ROADVIEW
    );
  }catch{}

  wrap?.classList.remove(
    "roadview-open"
  );

  if(state.roadviewWalker){
    state.roadviewWalker.setMap(
      state.map
    );
  }

  showHint(
    "로드뷰: 파란 도로 위에서 원하는 위치를 클릭하세요."
  );

  status(
    "로드뷰 위치 선택 모드"
  );
}

function bindEvents(){
  const run=()=>loadRoutes().catch(e=>status(e?.message||String(e),true));

  dom.searchBtn.addEventListener("click",run);
  dom.reloadBtn.addEventListener("click",run);
  dom.registerBtn.addEventListener("click",()=>registerNewRoute().catch(e=>status(e?.message||String(e),true)));
  dom.deletePolyBtn.addEventListener("click",()=>deletePolygonOnly().catch(e=>status(e?.message||String(e),true)));

  dom.clearBtn.addEventListener("click",()=>{state.rows=[];state.selectedId=null;dom.editorCard.hidden=true;clearOverlays();renderRouteList();status("\uC9C0\uB3C4 \uCD08\uAE30\uD654 \uC644\uB8CC");});

  dom.routeList.addEventListener("click",e=>{
    const item=e.target.closest("[data-id]");
    if(item)selectRoute(item.dataset.id);
  });

  dom.sideToggle.addEventListener("click",toggleSidebar);
  dom.fitBtn.addEventListener("click",fitAll);

  dom.labelBtn.addEventListener("click",()=>{state.labelOn=!state.labelOn;rebuildLabels();});
  dom.vendorLabelBtn.addEventListener("click",()=>{state.vendorLabelOn=!state.vendorLabelOn;rebuildLabels();});

  dom.mapTypeBtn.addEventListener("click",()=>{
    state.isRoadmap=!state.isRoadmap;
    state.map.setMapTypeId(
      state.isRoadmap?kakao.maps.MapTypeId.ROADMAP:kakao.maps.MapTypeId.SKYVIEW
    );
    dom.mapTypeBtn.textContent=state.isRoadmap?"위성":"일반지도";
  });

  dom.roadviewBtn.addEventListener("click",()=>{
    setRoadviewOn(!state.roadviewOn);
  });

  dom.drawNewBtn.addEventListener("click",async()=>{try{if(await ensureSelectedForDraw())beginDraw("new");}catch(e){status(e?.message||String(e),true);}});
  dom.drawAddBtn.addEventListener("click",async()=>{try{if(await ensureSelectedForDraw())beginDraw("add");}catch(e){status(e?.message||String(e),true);}});
  dom.editPolygonBtn.addEventListener("click",enterEditMode);

  dom.saveBtn.addEventListener("click",()=>{
    saveSelected().catch(e=>status(e?.message||String(e),true));
  });

  dom.deleteBtn.addEventListener("click",()=>{
    deleteSelected().catch(e=>status(e?.message||String(e),true));
  });

  dom.cancelEditBtn.addEventListener("click",()=>{
    stopEditMode();stopDrawMode();status("편집 모드를 종료했습니다.");
  });

  const inputEnter=e=>{if(e.key==="Enter"&&!e.isComposing){e.preventDefault();run();}};
  dom.campInput.addEventListener("keydown",inputEnter);
  dom.codeInput.addEventListener("keydown",inputEnter);

  kakao.maps.event.addListener(state.map,"click",e=>{
    if(state.drawing&&e?.latLng){
      addDrawPoint(e.latLng);
      return;
    }

    if(state.roadviewOn&&e?.latLng){
      setRoadviewAt(e.latLng);
      return;
    }

    // 폴리곤 클릭 직후 지도 click 이벤트가 이어지는 경우 선택 해제 방지.
    if(Date.now()-state.lastRouteClickAt<180){
      return;
    }

    if(state.selectedId){
      clearRouteSelection("선택 해제");
    }
  });

  kakao.maps.event.addListener(state.map,"rightclick",()=>{
    if(state.drawing)popDrawPoint();
  });

  document.addEventListener("keydown",e=>{
    if(e.key==="Enter"&&state.drawing){
      e.preventDefault();
      finishDraw();
      return;
    }

    if(e.key==="Escape"){
      e.preventDefault();

      if(state.drawing){
        stopDrawMode();
      }

      if(state.editing){
        stopEditMode();
      }

      if(state.selectedId){
        clearRouteSelection("선택 해제");
      }else{
        status("편집/선택 해제");
      }
    }
  });

  window.addEventListener("resize",()=>{
    const center=state.map.getCenter();
    state.map.relayout();
    state.map.setCenter(center);
  });
}

async function init(){
  // 지도 자체는 인증과 분리해서 먼저 생성.
  state.map=new kakao.maps.Map($("#map"),{
    center:new kakao.maps.LatLng(36.45,127.85),
    level:13
  });

  state.roadview=new kakao.maps.Roadview($("#roadview"));
  state.roadviewClient=new kakao.maps.RoadviewClient();

  kakao.maps.event.addListener(
    state.roadview,
    "init",
    syncRoadviewWalker
  );

  kakao.maps.event.addListener(
    state.roadview,
    "viewpoint_changed",
    ()=>{
      if(!state.roadviewWalker){
        syncRoadviewWalker();
      }

      const viewpoint=
        state.roadview.getViewpoint?.();

      if(
        viewpoint &&
        state.roadviewWalker
      ){
        state.roadviewWalker.setAngle(
          viewpoint.pan
        );
      }
    }
  );

  kakao.maps.event.addListener(
    state.roadview,
    "position_changed",
    ()=>{
      const pos=
        state.roadview.getPosition?.();

      if(!pos)return;

      if(!state.roadviewWalker){
        syncRoadviewWalker();
      }

      state.roadviewWalker?.setPosition(
        pos
      );

      if(state.roadviewOn){
        state.roadviewWalker?.setMap(
          state.map
        );
      }

      state.map.setCenter(pos);
    }
  );

  bindEvents();

  document.documentElement.style.visibility="visible";
  status("지도 준비 완료 · 로그인 권한 확인 중...");

  try{
    const ok=await initAuth();
    if(!ok)return;

    status(state.canEdit?"\uC870\uD68C \u00B7 \uB4F1\uB85D \u00B7 \uC218\uC815 \uAC00\uB2A5":"\uC870\uD68C \uC804\uC6A9 \uAD8C\uD55C");

    const launched=applyLaunchRouteParams();

    if(launched.camp){
      try{
        await loadRoutes();

        if(state.rows.length===1){
          const row=state.rows[0];
          selectRoute(
            String(
              row.id ??
              `${row.camp}/${row.full_code||row.code}`
            )
          );
        }
      }catch(loadError){
        console.warn("launch route auto load failed",loadError);
      }
    }
  }catch(error){
    console.error(error);

    // 지도는 그대로 유지하고, 조회/수정 기능만 잠근다.
    dom.searchBtn.disabled=true;
    dom.reloadBtn.disabled=true;
    document.querySelectorAll(".editOnly").forEach(el=>{el.hidden=true});

    status(
      "지도는 정상 로드되었습니다. 로그인 권한 확인 실패: "+
      (error?.message||String(error)),
      true
    );
  }
}

if(window.kakao?.maps){
  kakao.maps.load(()=>{
    init().catch(e=>{
      console.error(e);
      document.documentElement.style.visibility="visible";
      status(e?.message||String(e),true);
    });
  });
}else{
  document.documentElement.style.visibility="visible";
  status("카카오 지도 SDK를 불러오지 못했습니다.",true);
}
})();
</script>
