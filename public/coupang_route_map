async function currentAccessToken(forceRefresh=false){
  if(!state.sb){
    throw new Error("Supabase 클라이언트가 준비되지 않았습니다.");
  }

  if(forceRefresh){
    const {data,error}=await state.sb.auth.refreshSession();
    if(error)throw error;

    state.session=data?.session||null;
  }else{
    const {data,error}=await state.sb.auth.getSession();
    if(error)throw error;

    state.session=data?.session||null;

    const expiresAt=Number(state.session?.expires_at||0);
    const now=Math.floor(Date.now()/1000);

    if(
      state.session?.refresh_token &&
      expiresAt &&
      expiresAt-now < 90
    ){
      const refreshed=await state.sb.auth.refreshSession();

      if(!refreshed.error){
        state.session=refreshed.data?.session||state.session;
      }
    }
  }

  return state.session?.access_token||"";
}

async function apiFetch(path,options={},retry=true){
  let token=await currentAccessToken(false);

  if(!token){
    throw new Error("로그인 세션이 없습니다.");
  }

  const headers=new Headers(options.headers||{});
  headers.set("Authorization","Bearer "+token);

  if(options.body&&!headers.has("Content-Type")){
    headers.set("Content-Type","application/json");
  }

  let response=await fetch(
    ROUTE_API+path,
    {...options,headers,cache:"no-store"}
  );

  if(response.status===401&&retry){
    token=await currentAccessToken(true);

    if(token){
      headers.set("Authorization","Bearer "+token);

      response=await fetch(
        ROUTE_API+path,
        {...options,headers,cache:"no-store"}
      );
    }
  }

  const payload=await response.json().catch(()=>({}));

  if(!response.ok){
    throw new Error(
      payload?.message||
      payload?.error||
      `HTTP ${response.status}`
    );
  }

  return payload;
}

