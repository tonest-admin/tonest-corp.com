<!doctype html>
<html lang="ko">
<head>
<style>html{visibility:hidden}</style>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="referrer" content="origin">
<title>쿠팡 라우트 지도 | TO:NEST</title>

<link rel="icon" href="/favicon.ico?v=15" type="image/x-icon">
<link rel="shortcut icon" href="/favicon.ico?v=15" type="image/x-icon">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=add4ce93b38c0ff9d9b9053728e067b3&autoload=false&libraries=services"></script>
<script src="/board-menu.js?v=8" defer></script>

<style>
:root{
  --bg:#eef6f4;--card:#fff;--line:#cfdcda;--line2:#bccbc8;
  --text:#10191b;--muted:#405452;--primary:#16a7a4;--primary2:#118b89;
  --blue:#2563eb;--green:#15803d;--amber:#a16207;--red:#dc2626;
  --shadow:0 10px 28px rgba(15,45,47,.10);
  --font:"Pretendard Variable","Pretendard","Segoe UI","Noto Sans KR",system-ui,-apple-system,sans-serif
}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;font-family:var(--font);color:var(--text);background:var(--bg);-webkit-font-smoothing:auto;text-rendering:auto}
body{overflow:hidden}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}

.app{height:100dvh;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto}
.topbar{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);background:#fff;z-index:40}
.menuBtn{width:42px;height:42px;flex:0 0 42px;padding:0;border:0;border-radius:12px;background:#fff;display:grid;place-items:center}
.menuBtn:hover{background:#eaf8f6}
.menuBtn img{width:36px;height:36px;display:block;object-fit:contain}
.titleBlock{min-width:0}
.title{font-size:21px;line-height:1.05;font-weight:950;letter-spacing:-.035em}
.subtitle{margin-top:3px;color:var(--muted);font-size:11px;font-weight:800}
.grow{flex:1}
.pill{min-height:34px;display:inline-flex;align-items:center;padding:0 11px;border:1px solid var(--line2);border-radius:999px;background:#f8fbfa;color:#2c423f;font-size:11.5px;font-weight:900;white-space:nowrap}

.btn{min-height:36px;display:inline-flex;align-items:center;justify-content:center;padding:0 12px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:#263a37;font-size:12px;font-weight:900;white-space:nowrap}
.btn:hover{border-color:#86cac4;background:#f7fcfb}
.btn.primary{border-color:var(--primary);background:linear-gradient(180deg,#22b7b2,#16a7a4);color:#fff}
.btn.blue{border-color:#bfdbfe;background:#eff6ff;color:var(--blue)}
.btn.green{border-color:#bbf7d0;background:#effcf3;color:var(--green)}
.btn.amber{border-color:#fde68a;background:#fff9e8;color:var(--amber)}
.btn.danger{border-color:#fecaca;background:#fff;color:var(--red)}
.btn:disabled{opacity:.45;cursor:not-allowed}

.searchbar{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(150px,.9fr) 118px auto auto;gap:8px;align-items:center;padding:9px 12px;border-bottom:1px solid var(--line);background:#f8fbfa;z-index:35}
.control{width:100%;height:38px;padding:0 10px;border:1px solid #bdcdca;border-radius:10px;background:#fff;color:#152522;outline:none;font-size:12.5px;font-weight:800}
.control:focus{border-color:#65bfb8;box-shadow:0 0 0 3px rgba(22,167,164,.10)}

.workspace{min-height:0;display:grid;grid-template-columns:390px minmax(0,1fr);transition:grid-template-columns .18s ease}
.workspace.collapsed{grid-template-columns:0 minmax(0,1fr)}
.side{min-width:0;min-height:0;overflow:auto;border-right:1px solid var(--line);background:#f7fbfa}
.workspace.collapsed .side{width:0;overflow:hidden;border-right:0;opacity:0;pointer-events:none}
.sideInner{display:grid;gap:9px;padding:10px}
.card{border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:0 5px 18px rgba(15,45,47,.05)}
.cardHead{min-height:42px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 12px;border-bottom:1px solid #e5edeb}
.cardHead strong{font-size:13px;font-weight:950}
.cardHead span{color:var(--muted);font-size:10.5px;font-weight:800}
.routeList{max-height:31vh;overflow:auto;padding:8px;display:grid;gap:6px}
.routeItem{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:11px;background:#fff;text-align:left}
.routeItem:hover,.routeItem.active{border-color:#71c7c0;background:#f1fbf9}
.routeItem.active:focus{
  outline:2px solid rgba(22,167,164,.28);
  outline-offset:1px;
}
.routeTop{display:flex;align-items:center;gap:6px}
.routeCode{min-width:0;flex:1;font-size:13px;font-weight:950}
.polyBadge{min-height:19px;display:inline-flex;align-items:center;padding:0 6px;border-radius:999px;border:1px solid #d6e3e1;background:#f8fbfa;color:#536866;font-size:8.5px;font-weight:900}
.polyBadge.yes{border-color:#a7e2d6;background:#ebfaf6;color:#047857}
.routeMeta{
  display:grid;
  gap:2px;
  margin-top:6px;
  color:#526663;
  font-size:10px;
  line-height:1.45;
  font-weight:800;
}
.routeMetaLine{
  display:grid;
  grid-template-columns:46px minmax(0,1fr);
  gap:4px;
  min-width:0;
}
.routeMetaKey{
  color:#2d4440;
  font-weight:950;
}
.routeMetaValue{
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.editor{padding:11px}
.selectedMeta{
  margin-bottom:10px;
  padding:9px 10px;
  border:1px solid #d9e6e4;
  border-radius:10px;
  background:#f7fbfa;
  color:#3f5552;
  font-size:10.5px;
  line-height:1.55;
  font-weight:850;
  white-space:pre-line;
}
.field{display:grid;gap:5px;margin-bottom:9px}
.field label{color:#3f5552;font-size:10.5px;font-weight:900}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.buttonGrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.empty{padding:22px 12px;color:#596d69;font-size:11px;font-weight:800;text-align:center}

.mapPane{position:relative;min-width:0;min-height:0;background:#e9f1ef}
.mapWrap{position:absolute;inset:0;display:flex;min-width:0;min-height:0;background:#e9f1ef}
#map,#roadview{flex:1 1 0;width:100%;height:100%;min-width:0;min-height:0}
#roadview{display:none;background:#e5e7eb}
.mapWrap.roadview-open #roadview{display:block}
.mapTools{position:absolute;top:10px;right:10px;z-index:20;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100% - 70px)}
.mapTools .btn,.sideToggle{box-shadow:0 7px 20px rgba(15,45,47,.13)}
.sideToggle{position:absolute;top:10px;left:10px;z-index:22;width:38px;min-width:38px;padding:0}
.hint{position:absolute;left:50%;top:62px;z-index:24;display:none;max-width:calc(100% - 40px);padding:8px 12px;transform:translateX(-50%);border-radius:999px;background:rgba(17,27,29,.90);color:#fff;font-size:10.5px;font-weight:850;text-align:center}
.hint.show{display:block}
.routeLabel{min-width:54px;padding:4px 7px;border-radius:8px;border:1px solid rgba(15,45,47,.15);background:rgba(255,255,255,.94);color:#102522;box-shadow:0 3px 10px rgba(15,45,47,.13);font-size:9.5px;font-weight:950;line-height:1.2;text-align:center;pointer-events:none}

.footer{min-height:35px;display:flex;align-items:center;gap:9px;padding:5px 12px;border-top:1px solid var(--line);background:#fff;color:#405452;font-size:10.5px;font-weight:850;z-index:40}
.footer.error{color:var(--red)}
.ready{min-height:22px;display:inline-flex;align-items:center;padding:0 8px;border:1px solid #bbf7d0;border-radius:999px;background:#f0fdf4;color:#15803d;font-size:9px;font-weight:900}

@media(max-width:920px){
  .topbar{flex-wrap:wrap}.grow{display:none}.pill{order:3;width:100%}
  .searchbar{grid-template-columns:1fr 1fr}
  .workspace,.workspace.collapsed{display:block}
  .side,.workspace.collapsed .side{position:absolute;left:0;top:0;bottom:0;z-index:30;width:min(90vw,390px);opacity:1;overflow:auto;transform:translateX(-103%);transition:transform .18s ease;pointer-events:auto;border-right:1px solid var(--line);box-shadow:0 14px 38px rgba(15,45,47,.20)}
  .workspace.mobileOpen .side,.workspace.collapsed.mobileOpen .side{transform:translateX(0)}
  .mapPane{position:absolute;inset:0}
}

/* TO:NEST route editor v3 - MAROOWELL UX */
.app{grid-template-rows:auto minmax(0,1fr) auto}
.searchbar{display:none!important}
.workspace{grid-template-columns:370px minmax(0,1fr)}
.sideInner{gap:9px}
.actionCard{padding:11px}
.actionTitle{font-size:13px;font-weight:950;margin-bottom:8px}
.actionLabel{display:block;margin:7px 0 5px;color:#405653;font-size:10.5px;font-weight:900}
.actionGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:7px}
.actionGrid .btn{min-width:0;padding:0 7px}
.actionHint{margin-top:8px;color:#657976;font-size:9.5px;line-height:1.45;font-weight:800}
.btn.register{border-color:#99e5d4;background:#ebfaf6;color:#047857}
.btn.warn{border-color:#fde68a;background:#fffbeb;color:#9a5c00}
.routeSwatch{width:11px;height:11px;flex:0 0 11px;border-radius:3px;border:1px solid rgba(15,23,42,.18)}
.routeLabel{min-width:0!important;display:flex;align-items:center;gap:5px;padding:4px 8px!important;border-radius:11px!important;border:1px solid rgba(255,255,255,.14)!important;background:rgba(0,0,0,.52)!important;color:#fff!important;box-shadow:0 2px 8px rgba(0,0,0,.18)!important;backdrop-filter:blur(1.5px)!important;-webkit-backdrop-filter:blur(1.5px)!important;font-size:10px!important;font-weight:650!important;white-space:nowrap!important}
.routeLabelDot{width:7px;height:7px;flex:0 0 7px;border-radius:999px;box-shadow:0 0 0 2px rgba(255,255,255,.12)}
.routeLabelVendor{
  display:grid;
  gap:2px;
  padding-left:7px;
  border-left:1px solid rgba(255,255,255,.18);
  color:rgba(255,255,255,.92);
  font-size:9px;
  line-height:1.22;
  font-weight:500;
  text-align:left;
}
.routeLabelVendorLine{
  display:grid;
  grid-template-columns:38px minmax(0,1fr);
  gap:3px;
}
.routeLabelVendorKey{
  color:#fff;
  font-weight:750;
}
.routeLabelVendorValue{
  min-width:0;
  max-width:150px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.roadviewWalker{
  position:relative;
  width:46px;
  height:46px;
  pointer-events:none;
  filter:drop-shadow(0 2px 3px rgba(15,23,42,.28));
}
.roadviewWalkerCone{
  position:absolute;
  left:50%;
  top:-21px;
  width:25px;
  height:32px;
  transform:translateX(-50%) rotate(0deg);
  transform-origin:50% 37px;
  background:rgba(37,99,235,.48);
  clip-path:polygon(50% 0,100% 100%,50% 77%,0 100%);
}
.roadviewWalkerHalo{
  position:absolute;
  left:50%;
  top:50%;
  width:30px;
  height:30px;
  transform:translate(-50%,-50%);
  border-radius:999px;
  background:rgba(37,99,235,.16);
  border:2px solid rgba(37,99,235,.72);
}
.roadviewWalkerDot{
  position:absolute;
  left:50%;
  top:50%;
  width:12px;
  height:12px;
  transform:translate(-50%,-50%);
  border-radius:999px;
  background:#2563eb;
  border:3px solid #fff;
  box-shadow:0 0 0 1px rgba(37,99,235,.25);
}
.buttonGrid{display:none!important}
.editor{padding:11px}
@media(max-width:920px){.workspace{display:block}.actionGrid{grid-template-columns:repeat(3,minmax(0,1fr))}}

</style>
</head>

<body>
<div class="app">

<header class="topbar">
  <button id="tnBoardMenuToggle" class="menuBtn" type="button" aria-label="TO:NEST 메뉴 열기">
    <img src="/favicon.ico?v=15" alt="TO:NEST">
  </button>

  <div class="titleBlock">
    <div class="title">쿠팡 라우트 지도</div>
    <div class="subtitle">MAROOWELL 통합 라우트 · 폴리곤 · 입차지 동기화</div>
  </div>

  <div class="grow"></div>
  <span id="userPill" class="pill">권한 확인 중</span>
  <a class="btn blue" href="/route_info" style="text-decoration:none">라우트 정보</a>
  <button id="reloadBtn" class="btn" type="button">새로고침</button>
</header>

<main id="workspace" class="workspace">

<aside class="side">
  <div class="sideInner">

    <section class="card actionCard">
      <div class="actionTitle">라우트 조회 · 등록</div>

      <label class="actionLabel" for="campInput">캠프 이름</label>
      <input id="campInput" class="control" type="text" placeholder="예: 일산2" autocomplete="off">

      <label class="actionLabel" for="codeInput">라우트 코드</label>
      <input id="codeInput" class="control" type="text" placeholder="예: 126 또는 126A 126B" autocomplete="off">

      <select id="modeSelect" class="control" style="margin-top:7px">
        <option value="prefix">앞자리 조회</option>
        <option value="exact">정확히 조회</option>
      </select>

      <div class="actionGrid">
        <button id="searchBtn" class="btn primary" type="button">불러오기</button>
        <button id="registerBtn" class="btn register editOnly" type="button">신규 등록</button>
        <button id="drawNewBtn" class="btn warn editOnly" type="button">새로 그리기</button>
      </div>

      <div class="actionGrid">
        <button id="drawAddBtn" class="btn warn editOnly" type="button">구역 추가</button>
        <button id="saveBtn" class="btn green editOnly" type="button">저장</button>
        <button id="deletePolyBtn" class="btn danger editOnly" type="button">폴리곤 삭제</button>
      </div>

      <div class="actionGrid">
        <button id="editPolygonBtn" class="btn blue editOnly" type="button">점 편집</button>
        <button id="labelBtn" class="btn" type="button">라우트 라벨 ON</button>
        <button id="vendorLabelBtn" class="btn" type="button">벤더 라벨 OFF</button>
      </div>

      <div class="actionGrid">
        <button id="clearBtn" class="btn" type="button">지도 초기화</button>
        <button id="deleteBtn" class="btn danger editOnly" type="button">라우트 삭제</button>
        <button id="cancelEditBtn" class="btn" type="button">편집 종료</button>
      </div>

      <div class="actionHint">조회는 저장과 분리됩니다. 신규는 캠프/라우트 입력 → 신규 등록 → 폴리곤 그리기 → 저장 순서입니다.</div>
    </section>


    <section class="card">
      <div class="cardHead">
        <strong>조회 라우트</strong>
        <span id="routeCount">0건</span>
      </div>
      <div id="routeList" class="routeList">
        <div class="empty">캠프와 라우트를 조회하세요.</div>
      </div>
    </section>

    <section id="editorCard" class="card" hidden>
      <div class="cardHead">
        <strong>선택 라우트</strong>
        <span id="selectedId">-</span>
      </div>

      <div class="editor">
        <div id="selectedMeta" class="selectedMeta"></div>

        <div class="cols">
          <div class="field">
            <label for="editCamp">캠프</label>
            <input id="editCamp" class="control" type="text">
          </div>
          <div class="field">
            <label for="editCode">라우트</label>
            <input id="editCode" class="control" type="text">
          </div>
        </div>

        <div class="field">
          <label for="deliveryName">입차지명</label>
          <input id="deliveryName" class="control" type="text" placeholder="예: 양평동4가MB">
        </div>

        <div class="field">
          <label for="deliveryAddress">입차지 주소</label>
          <input id="deliveryAddress" class="control" type="text" placeholder="입차지 주소">
        </div>
</div>
    </section>

  </div>
</aside>

<section class="mapPane">
  <div id="mapWrap" class="mapWrap">
    <div id="map"></div>
    <div id="roadview"></div>
  </div>
  <button id="sideToggle" class="btn sideToggle" type="button" title="목록 접기">◀</button>

  <div class="mapTools">
    <button id="fitBtn" class="btn" type="button">전체 보기</button>
    <button id="mapTypeBtn" class="btn" type="button">위성</button>
    <button id="roadviewBtn" class="btn" type="button" title="로드뷰 가능 도로 표시 후 지도 클릭">로드뷰</button>
  </div>

  <div id="hint" class="hint"></div>
</section>

</main>

<footer id="footer" class="footer">
  <span class="ready">READY</span>
  <span id="status">시스템 준비 중</span>
</footer>

</div>

<script>
(() => {
"use strict";

const AUTH_BASE = location.origin;
const ROUTE_API = "https://route.tonest-admin.workers.dev";
const ROUTE_INFO_API = "https://route-info.tonest-admin.workers.dev";
const launchParams = new URLSearchParams(location.search);
const launchRouteInfoId = launchParams.get("route_info_id") || "";
const $ = s => document.querySelector(s);

const dom = {
  workspace:$("#workspace"), userPill:$("#userPill"), reloadBtn:$("#reloadBtn"),
  campInput:$("#campInput"), codeInput:$("#codeInput"), modeSelect:$("#modeSelect"),
  searchBtn:$("#searchBtn"), registerBtn:$("#registerBtn"), clearBtn:$("#clearBtn"), deletePolyBtn:$("#deletePolyBtn"), vendorLabelBtn:$("#vendorLabelBtn"), routeList:$("#routeList"),
  routeCount:$("#routeCount"), editorCard:$("#editorCard"), selectedId:$("#selectedId"),
  selectedMeta:$("#selectedMeta"), editCamp:$("#editCamp"), editCode:$("#editCode"),
  deliveryName:$("#deliveryName"), deliveryAddress:$("#deliveryAddress"),
  drawNewBtn:$("#drawNewBtn"), drawAddBtn:$("#drawAddBtn"),
  editPolygonBtn:$("#editPolygonBtn"), saveBtn:$("#saveBtn"),
  deleteBtn:$("#deleteBtn"), cancelEditBtn:$("#cancelEditBtn"),
  sideToggle:$("#sideToggle"), fitBtn:$("#fitBtn"), labelBtn:$("#labelBtn"),
  mapTypeBtn:$("#mapTypeBtn"), roadviewBtn:$("#roadviewBtn"), hint:$("#hint"), footer:$("#footer"), status:$("#status")
};

const state = {
  sb:null, session:null, profile:null, canEdit:false,
  map:null, roadview:null, roadviewClient:null, roadviewWalker:null,
  roadviewOn:false, isRoadmap:true, labelOn:true, vendorLabelOn:false,
  rows:[], selectedId:null, selectedOriginal:null, overlays:new Map(),
  drawing:null, drawPoints:[], drawMarkers:[], drawLine:null,
  editing:false, editMarkers:[],
  lastRouteClickAt:0
};

const roleLabel = role => ({
  super_admin:"최고관리자",
  admin:"관리자",
  team_leader:"팀장",
  driver:"기사"
})[role] || role || "-";

const text = v => String(v ?? "").trim();

function status(message,error=false){
  dom.status.textContent=message||"";
  dom.footer.classList.toggle("error",Boolean(error));
}

function showHint(message=""){
  dom.hint.textContent=message;
  dom.hint.classList.toggle("show",Boolean(message));
}

function hash32(value){
  let h=2166136261;
  for(const ch of String(value||"")){
    h^=ch.charCodeAt(0);
    h=Math.imul(h,16777619);
  }
  return h>>>0;
}

const GOLDEN_ANGLE=137.50776405003785;

function colorByIndex(i,startHue){
  const hue=(startHue+i*GOLDEN_ANGLE)%360;
  const sat=60+(i%4)*3;
  const light=49+(i%4)*3;
  return `hsl(${hue.toFixed(1)} ${sat}% ${light}%)`;
}

function routeKey(row){
  return text(row?.full_code||row?.code||"").toUpperCase();
}

function assignColors(rows){
  const camp=text(rows?.[0]?.camp||dom.campInput.value);
  const startHue=hash32(camp)%360;
  const keys=Array.from(new Set((rows||[]).map(routeKey).filter(Boolean)))
    .sort((a,b)=>a.localeCompare(b,"en",{numeric:true,sensitivity:"base"}));
  const cmap=new Map();
  keys.forEach((key,index)=>cmap.set(key,colorByIndex(index,startHue)));
  for(const row of rows||[]){
    row.__color=cmap.get(routeKey(row))||colorByIndex(0,startHue);
  }
}

function parseCodes(value){
  return String(value||"").split(/[\s,;]+/).map(v=>v.trim().toUpperCase()).filter(Boolean);
}

function parsePolygonWgs84(value){
  if(!value)return null;
  if(Array.isArray(value))return value;
  if(typeof value==="string"){
    try{
      const p=JSON.parse(value);
      return Array.isArray(p)?p:null;
    }catch{return null}
  }
  return null;
}

function normalizeRings(value){
  if(!Array.isArray(value)||!value.length)return[];
  const first=value[0];
  if(Array.isArray(first)&&first.length>=2&&typeof first[0]==="number")return[value];
  if(Array.isArray(first)&&Array.isArray(first[0]))return value;
  return[];
}

function ringToLatLngs(ring){
  return (Array.isArray(ring)?ring:[])
    .map(p=>{
      if(!Array.isArray(p)||p.length<2)return null;
      const lng=Number(p[0]),lat=Number(p[1]);
      return Number.isFinite(lat)&&Number.isFinite(lng)
        ? new kakao.maps.LatLng(lat,lng)
        : null;
    })
    .filter(Boolean);
}

function polygonPathToArray(polygon){
  const path=polygon?.getPath?.();
  if(!path)return[];
  if(Array.isArray(path))return path;
  if(typeof path.getLength==="function"&&typeof path.getAt==="function"){
    const out=[];
    for(let i=0;i<path.getLength();i++)out.push(path.getAt(i));
    return out;
  }
  return[];
}

function polygonsToWgs84(polygons){
  const out=[];
  for(const polygon of polygons||[]){
    const ring=polygonPathToArray(polygon).map(ll=>[ll.getLng(),ll.getLat()]);
    if(ring.length>=3)out.push(ring);
  }
  return out.length?out:null;
}

function centroid(points){
  let lat=0,lng=0;
  for(const p of points){lat+=p.getLat();lng+=p.getLng()}
  return new kakao.maps.LatLng(lat/points.length,lng/points.length);
}

function makeDotImage({size=12,fill="#fff",stroke="#0f172a",strokeWidth=2}={}){
  const c=size/2,r=Math.max(1,c-strokeWidth/2);
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}"><circle cx="${c}" cy="${c}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${strokeWidth}"/></svg>`;
  return new kakao.maps.MarkerImage(
    "data:image/svg+xml;charset=utf-8,"+encodeURIComponent(svg),
    new kakao.maps.Size(size,size),
    {offset:new kakao.maps.Point(c,c)}
  );
}

