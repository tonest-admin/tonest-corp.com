  stopEditMode();
  stopDrawMode();

  const pack=state.overlays.get(String(id));
  if(!pack)return;

  const row=pack.row;
  state.selectedId=String(id);
  state.selectedOriginal=JSON.parse(JSON.stringify(row));

  dom.editorCard.hidden=false;
  dom.selectedId.textContent=`ID ${row.id??"-"}`;
  dom.editCamp.value=text(row.camp);
  dom.editCode.value=text(row.full_code||row.code);
  dom.deliveryName.value=text(row.delivery_location_name);
  dom.deliveryAddress.value=text(row.delivery_location_address);

