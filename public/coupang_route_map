    ${
      state.vendorLabelOn
        ? `
          <span class="routeLabelVendor">
            <span class="routeLabelVendorLine">
              <span class="routeLabelVendorKey">입차지</span>
              <span class="routeLabelVendorValue">: ${escapeHtml(delivery)}</span>
