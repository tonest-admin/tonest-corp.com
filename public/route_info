<style>
:root{
  --bg:#eef6f4;--card:#fff;--line:#cfdcda;--line2:#bccbc8;
  --text:#10191b;--muted:#405452;--primary:#16a7a4;--primary2:#118b89;
  --green:#15803d;--amber:#a16207;--red:#dc2626;--blue:#2563eb;
  --shadow:0 10px 28px rgba(15,45,47,.09);
  --font:"Pretendard Variable","Pretendard","Segoe UI","Noto Sans KR",system-ui,-apple-system,sans-serif
}
*{box-sizing:border-box}
html,body{width:100%;min-height:100%;margin:0;font-family:var(--font);color:var(--text);background:var(--bg);-webkit-font-smoothing:auto;text-rendering:auto}
body{padding:8px;overflow:hidden}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
.app{height:calc(100dvh - 16px);display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;gap:8px}
.panel{border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:var(--shadow)}
.topbar{min-height:64px;display:flex;align-items:center;gap:10px;padding:8px 12px}
.menuBtn{width:42px;height:42px;padding:0;border:0;border-radius:12px;background:#fff;display:grid;place-items:center}
.menuBtn:hover{background:#eaf8f6}.menuBtn img{width:36px;height:36px;object-fit:contain}
.titleBox{min-width:0}.title{font-size:21px;line-height:1.05;font-weight:950;letter-spacing:-.035em}.subtitle{margin-top:3px;color:var(--muted);font-size:11.5px;font-weight:800}
.spacer{flex:1}.pill{min-height:34px;display:inline-flex;align-items:center;padding:0 11px;border:1px solid var(--line2);border-radius:999px;background:#f8fbfa;color:#2c423f;font-size:11.5px;font-weight:900;white-space:nowrap}
.btn{min-height:36px;display:inline-flex;align-items:center;justify-content:center;padding:0 12px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:#263a37;font-size:12px;font-weight:900;white-space:nowrap}
.btn:hover{border-color:#86cac4;background:#f7fcfb}.btn.primary{border-color:var(--primary);background:linear-gradient(180deg,#22b7b2,#16a7a4);color:#fff}.btn.green{border-color:#16a34a;background:linear-gradient(180deg,#22c55e,#16a34a);color:#fff}.btn.blue{border-color:#bfdbfe;background:#eff6ff;color:var(--blue)}.btn.danger{border-color:#fecaca;background:#fff5f5;color:var(--red)}.btn:disabled{opacity:.45;cursor:not-allowed}
.toolbar{min-height:52px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:8px 10px}
.search{height:36px;min-width:260px;flex:1;padding:0 11px;border:1px solid var(--line2);border-radius:10px;background:#fff;outline:none;font-size:12px;font-weight:800}.search:focus{border-color:#65bfb8;box-shadow:0 0 0 3px rgba(22,167,164,.10)}
.filter{height:36px;padding:0 9px;border:1px solid var(--line2);border-radius:10px;background:#fff;font-size:12px;font-weight:850}.helper{color:#526663;font-size:10.5px;font-weight:800}
.sheetWrap{min-height:0;overflow:auto;border:1px solid var(--line);border-radius:16px;background:#eef5f3;box-shadow:var(--shadow)}
.sheetInner{min-width:2740px}table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}th,td{border-right:1px solid #d9e4e2;border-bottom:1px solid #d9e4e2}th:first-child,td:first-child{border-left:1px solid #d9e4e2}
thead th{position:sticky;top:0;z-index:5;height:42px;padding:7px 6px;background:#e2efed;color:#162b29;text-align:center;font-size:12px;font-weight:950;white-space:nowrap}
tbody td{padding:0;background:#fff;vertical-align:middle}tbody tr:nth-child(even) td{background:#fbfefd}tbody tr.dirty td{background:#f3fbfa}tbody tr.newRow td{background:#effcf3!important}
.cellInput,.cellSelect,.cellTextarea{width:100%;min-height:44px;border:0;outline:0;background:transparent;padding:8px 7px;color:#101d1b;font-size:12px;font-weight:800}.cellTextarea{height:44px;resize:none;overflow:hidden;line-height:1.35}.cellInput:disabled,.cellSelect:disabled,.cellTextarea:disabled{opacity:1;color:#334946;cursor:default;background:#f7faf9}
.roCell{min-height:44px;display:flex;align-items:center;padding:7px;color:#334946;font-size:11.5px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.center{justify-content:center;text-align:center}.right{justify-content:flex-end;text-align:right}
.statusBadge{min-height:22px;display:inline-flex;align-items:center;padding:0 7px;border:1px solid #cbd9d7;border-radius:999px;background:#f8fbfa;color:#536866;font-size:9.5px;font-weight:900}.statusBadge.ok{border-color:#a7e2d6;background:#ebfaf6;color:#047857}.statusBadge.warn{border-color:#fde68a;background:#fff9e8;color:#a16207}
.smallBtn{min-height:29px;padding:0 9px;border:1px solid #c8d6d4;border-radius:9px;background:#fff;color:#304542;font-size:10.5px;font-weight:900}.smallBtn.map{border-color:#bfdbfe;background:#eff6ff;color:#2563eb}.smallBtn.details{border-color:#a7e2d6;background:#ebfaf6;color:#047857}.smallBtn.danger{border-color:#fecaca;background:#fff5f5;color:#dc2626}
.actionBox{min-height:44px;display:flex;align-items:center;justify-content:center;gap:5px;padding:5px}.muted{color:#738581;font-size:10px;font-weight:800}
.statusbar{min-height:40px;display:flex;align-items:center;gap:8px;padding:6px 10px}.statusPill{min-height:26px;display:inline-flex;align-items:center;padding:0 9px;border:1px solid var(--line2);border-radius:999px;background:#f8fbfa;color:#506663;font-size:10px;font-weight:900}.statusPill.ok{color:var(--green);border-color:#bbf7d0;background:#f0fdf4}.statusPill.warn{color:var(--amber);border-color:#fde68a;background:#fff9e8}.statusPill.err{color:var(--red);border-color:#fecaca;background:#fff5f5}.statusText{min-width:0;overflow:hidden;color:#334946;font-size:11px;font-weight:800;white-space:nowrap;text-overflow:ellipsis}
.modal{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(15,33,36,.48);backdrop-filter:blur(3px)}.modal.show{display:flex}.modalCard{width:min(920px,100%);max-height:min(82vh,760px);display:grid;grid-template-rows:auto minmax(0,1fr) auto;overflow:hidden;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 28px 90px rgba(15,33,36,.28)}.modalHead,.modalFoot{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 14px}.modalHead{border-bottom:1px solid var(--line)}.modalFoot{justify-content:flex-end;border-top:1px solid var(--line)}.modalBody{min-height:0;overflow:auto;padding:12px}.detailTable{width:100%;border-collapse:collapse}.detailTable th,.detailTable td{border:1px solid #d9e4e2;padding:7px;font-size:11px;line-height:1.4;text-align:left}.detailTable th{position:static;background:#edf6f4;font-weight:950}.empty{padding:35px;text-align:center;color:#60726f;font-size:12px;font-weight:800}
@media(max-width:900px){body{padding:4px}.app{height:calc(100dvh - 8px)}.topbar{flex-wrap:wrap}.spacer{display:none}.pill{order:3;width:100%}.sheetInner{min-width:2740px}}
</style>
</head>
<body>
<div class="app">
  <header class="panel topbar">
    <button id="tnBoardMenuToggle" class="menuBtn" type="button" aria-label="TO:NEST 메뉴 열기"><img src="/favicon.ico?v=15" alt="TO:NEST"></button>
    <div class="titleBox"><div class="title">라우트 정보</div><div class="subtitle">TO:NEST 라우트 · 단가 · 서서브 · MAROOWELL 양방향 연동</div></div>
    <div class="spacer"></div>
    <span id="userPill" class="pill">권한 확인 중</span>
    <button id="reloadBtn" class="btn" type="button">새로고침</button>
    <button id="addBtn" class="btn green editOnly" type="button">행 추가</button>
    <button id="saveBtn" class="btn green editOnly" type="button">전체 저장</button>
    <button id="csvBtn" class="btn" type="button">CSV 다운로드</button>
  </header>

  <section class="panel toolbar">
    <input id="searchInput" class="search" placeholder="캠프 / 라우트 / 입차지 / 벤더 / 메모 검색">
    <select id="waveFilter" class="filter"><option value="">주/야 전체</option><option>주/야</option><option>주간</option><option>야간</option><option>심야</option></select>
    <select id="polyFilter" class="filter"><option value="">폴리곤 전체</option><option value="yes">폴리곤 있음</option><option value="no">폴리곤 없음</option></select>
    <select id="activeFilter" class="filter"><option value="active">활성</option><option value="all">전체</option><option value="inactive">비활성</option></select>
    <button id="clearFilterBtn" class="btn" type="button">필터 초기화</button>
    <span class="helper">라우트 정보 등록 → 지도 등록. 지도에서 먼저 만든 라우트도 저장 시 TO:NEST 라우트 정보로 자동 연결됩니다.</span>
  </section>

  <main class="sheetWrap"><div class="sheetInner"><table>
    <colgroup>
      <col style="width:105px"><col style="width:115px"><col style="width:100px"><col style="width:120px"><col style="width:210px"><col style="width:150px"><col style="width:220px"><col style="width:170px"><col style="width:190px"><col style="width:100px"><col style="width:120px"><col style="width:120px"><col style="width:120px"><col style="width:250px"><col style="width:100px"><col style="width:120px"><col style="width:260px"><col style="width:95px"><col style="width:120px">
    </colgroup>
    <thead><tr>
      <th>캠프</th><th>라우트</th><th>주/야</th><th>계약일</th><th>주소</th><th>입차지</th><th>입차지 주소</th><th>주간 벤더</th><th>야간 벤더</th><th>단가기간</th><th>원청단가</th><th>고정단가</th><th>백업단가</th><th>라우트 정보</th><th>서서브</th><th>폴리곤</th><th>TO:NEST 메모</th><th>활성</th><th>작업</th>
    </tr></thead>
    <tbody id="body"></tbody>
  </table></div></main>

  <footer class="panel statusbar"><span id="statePill" class="statusPill ok">READY</span><span id="rowPill" class="statusPill">0행</span><span id="dirtyPill" class="statusPill warn">변경 0</span><span id="statusText" class="statusText">라우트 정보 준비 중</span></footer>
</div>

<div id="detailModal" class="modal"><div class="modalCard"><div class="modalHead"><b id="detailTitle">서서브 정보</b><button id="detailClose" class="btn" type="button">닫기</button></div><div id="detailBody" class="modalBody"></div><div class="modalFoot"><button id="detailClose2" class="btn" type="button">닫기</button></div></div></div>

<script>
(async()=>{
"use strict";
const AUTH_BASE=location.origin;
const API="https://route-info.tonest-admin.workers.dev";
const $=s=>document.querySelector(s);
const dom={body:$("#body"),userPill:$("#userPill"),reload:$("#reloadBtn"),add:$("#addBtn"),save:$("#saveBtn"),csv:$("#csvBtn"),search:$("#searchInput"),wave:$("#waveFilter"),poly:$("#polyFilter"),active:$("#activeFilter"),clear:$("#clearFilterBtn"),statePill:$("#statePill"),rowPill:$("#rowPill"),dirtyPill:$("#dirtyPill"),status:$("#statusText"),modal:$("#detailModal"),detailTitle:$("#detailTitle"),detailBody:$("#detailBody"),detailClose:$("#detailClose"),detailClose2:$("#detailClose2")};
const state={sb:null,session:null,profile:null,canEdit:false,rows:[],filtered:[],temp:0,busy:false};
const esc=v=>String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#39;");
const text=v=>String(v??"").trim();
const roleLabel=r=>({super_admin:"최고관리자",admin:"관리자",team_leader:"팀장",driver:"기사"})[r]||r||"-";
const money=v=>{if(v==null||v==="")return"";const n=Number(String(v).replace(/,/g,"").replace(/원/g,""));return Number.isFinite(n)?n.toLocaleString("ko-KR"):String(v)};
const rawMoney=v=>{const s=text(v).replace(/,/g,"").replace(/원/g,"");if(!s)return null;const n=Number(s);if(!Number.isFinite(n))throw new Error("단가 값이 숫자가 아닙니다: "+v);return n};
function setStatus(msg,tone="ok"){dom.status.textContent=msg||"";dom.statePill.className="statusPill "+(tone||"");dom.statePill.textContent=tone==="err"?"ERROR":tone==="warn"?"WAIT":"READY"}
function setBusy(on,msg){state.busy=!!on;[dom.reload,dom.add,dom.save].forEach(b=>b.disabled=!!on||(b.classList.contains("editOnly")&&!state.canEdit));if(msg)setStatus(msg,"warn")}
function normalize(row){const r={...(row||{})};r._key=r.id||("new_"+(++state.temp));r._new=!r.id;r._deleted=false;r._dirty=false;r._original=JSON.parse(JSON.stringify(row||{}));return r}
function dirtyCount(){return state.rows.filter(r=>r._dirty||r._new||r._deleted).length}
function currentToken(){return state.session?.access_token||""}
async function api(path,options={},retry=true){let token=currentToken();if(!token)throw new Error("로그인 세션이 없습니다.");const headers=new Headers(options.headers||{});headers.set("Authorization","Bearer "+token);if(options.body&&!headers.has("Content-Type"))headers.set("Content-Type","application/json");let res=await fetch(API+path,{...options,headers,cache:"no-store"});if(res.status===401&&retry){const refreshed=await state.sb.auth.refreshSession();if(!refreshed.error&&refreshed.data?.session){state.session=refreshed.data.session;headers.set("Authorization","Bearer "+currentToken());res=await fetch(API+path,{...options,headers,cache:"no-store"})}}const payload=await res.json().catch(()=>({}));if(!res.ok)throw new Error(payload?.error||payload?.message||`HTTP ${res.status}`);return payload}
async function initAuth(){const cfgRes=await fetch(AUTH_BASE+"/auth-config",{cache:"no-store"});const cfg=await cfgRes.json().catch(()=>({}));if(!cfgRes.ok||!cfg.supabaseUrl||!cfg.supabaseKey)throw new Error(cfg.message||"로그인 설정을 불러오지 못했습니다.");state.sb=window.supabase.createClient(cfg.supabaseUrl,cfg.supabaseKey,{auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}});const {data:{session}}=await state.sb.auth.getSession();if(!session?.access_token){location.replace("/?next=%2Froute_info");return false}state.session=session;const me=await api("/me");state.profile=me.profile||{};state.canEdit=Boolean(me.canEdit);dom.userPill.textContent=`${state.profile.display_name||state.profile.email||session.user.email||"사용자"} · ${roleLabel(state.profile.role)}`;document.querySelectorAll(".editOnly").forEach(el=>el.hidden=!state.canEdit);return true}
function val(row,key){return row[key]??""}
function mark(row,key,value){row[key]=value;row._dirty=true;renderPills()}
function editable(row,key,type="text"){const disabled=!state.canEdit;if(type==="textarea")return `<textarea class="cellTextarea" data-k="${esc(row._key)}" data-f="${key}" ${disabled?"disabled":""}>${esc(val(row,key))}</textarea>`;if(type==="select")return `<select class="cellSelect" data-k="${esc(row._key)}" data-f="${key}" ${disabled?"disabled":""}><option value="" ${!text(val(row,key))?"selected":""}>-</option><option value="주/야" ${text(val(row,key))==="주/야"?"selected":""}>주/야</option><option value="주간" ${text(val(row,key))==="주간"?"selected":""}>주간</option><option value="야간" ${text(val(row,key))==="야간"?"selected":""}>야간</option><option value="심야" ${text(val(row,key))==="심야"?"selected":""}>심야</option></select>`;const inputType=type==="date"?"date":"text";const shown=["origin_price","fixed_price","backup_price"].includes(key)?money(val(row,key)):val(row,key);return `<input class="cellInput" type="${inputType}" data-k="${esc(row._key)}" data-f="${key}" value="${esc(shown)}" ${disabled?"disabled":""}>`}
function mapUrl(row){const p=new URLSearchParams();if(text(row.camp))p.set("camp",text(row.camp));if(text(row.route_code)){p.set("code",text(row.route_code));p.set("mode","exact")}if(row.id)p.set("route_info_id",row.id);return "/coupang_route_map?"+p.toString()}
function render(){dom.body.innerHTML="";if(!state.filtered.length){dom.body.innerHTML='<tr><td colspan="19"><div class="empty">등록된 라우트 정보가 없습니다. 상단 <b>행 추가</b>를 눌러 먼저 등록하세요.</div></td></tr>';renderPills();return}for(const row of state.filtered){const tr=document.createElement("tr");if(row._dirty)tr.classList.add("dirty");if(row._new)tr.classList.add("newRow");const details=Array.isArray(row.route_details)?row.route_details:[];const hasPoly=Boolean(row.has_polygon);const linked=row.maroowell_subsubroute_id!=null;tr.innerHTML=`
<td>${editable(row,"camp")}</td>
<td>${editable(row,"route_code")}</td>
<td>${editable(row,"wave","select")}</td>
<td>${editable(row,"contract_date","date")}</td>
<td>${editable(row,"address")}</td>
<td>${editable(row,"delivery_location_name")}</td>
<td>${editable(row,"delivery_location_address")}</td>
<td>${editable(row,"vendor_name_2w")}</td>
<td>${editable(row,"vendor_name_1w")}</td>
<td>${editable(row,"current_period_code")}</td>
<td>${editable(row,"origin_price")}</td>
<td>${editable(row,"fixed_price")}</td>
<td>${editable(row,"backup_price")}</td>
<td>${editable(row,"route_tip","textarea")}</td>
<td><div class="actionBox"><button class="smallBtn details" data-details="${esc(row._key)}">${details.length.toLocaleString()}개</button></div></td>
<td><div class="actionBox"><button class="smallBtn map" type="button" data-map="${esc(row._key)}">${hasPoly?"지도 확인":"폴리곤 등록"}</button></div></td>
<td>${editable(row,"tonest_memo","textarea")}</td>
<td><div class="actionBox"><span class="statusBadge ${row.is_active!==false?"ok":"warn"}">${row.is_active!==false?"활성":"비활성"}</span></div></td>
<td><div class="actionBox">${linked?`<span class="muted" title="MAROOWELL subsubroute #${esc(row.maroowell_subsubroute_id)}">MW #${esc(row.maroowell_subsubroute_id)}</span>`:`<span class="muted">미연결</span>`}${state.canEdit?`<button class="smallBtn danger" data-delete="${esc(row._key)}">비활성</button>`:""}</div></td>`;
dom.body.appendChild(tr)}renderPills()}
function renderPills(){dom.rowPill.textContent=state.filtered.length.toLocaleString()+"행";dom.dirtyPill.textContent="변경 "+dirtyCount().toLocaleString()}
function applyFilters(){const q=text(dom.search.value).toLowerCase(),wave=text(dom.wave.value),poly=text(dom.poly.value),active=text(dom.active.value);state.filtered=state.rows.filter(row=>{if(active==="active"&&row.is_active===false)return false;if(active==="inactive"&&row.is_active!==false)return false;if(wave&&text(row.wave)!==wave)return false;if(poly==="yes"&&!row.has_polygon)return false;if(poly==="no"&&row.has_polygon)return false;if(q){const hay=[row.camp,row.route_code,row.wave,row.address,row.delivery_location_name,row.delivery_location_address,row.vendor_name_1w,row.vendor_name_2w,row.route_tip,row.tonest_memo].map(x=>text(x).toLowerCase()).join(" ");if(!hay.includes(q))return false}return true});render()}
async function load(){try{setBusy(true,"라우트 정보 불러오는 중...");const payload=await api("/routes?include_inactive=1");state.rows=(payload.rows||[]).map(normalize);applyFilters();setStatus(`로드 완료: ${state.rows.length.toLocaleString()}개`,"ok")}catch(e){console.error(e);setStatus(e.message||String(e),"err")}finally{setBusy(false)}}
function addRow(){const row=normalize({camp:"",route_code:"",wave:"주/야",contract_date:null,address:"",delivery_location_name:"",delivery_location_address:"",vendor_name_1w:"",vendor_name_2w:"",vendor_business_number_1w:null,vendor_business_number_2w:null,current_period_code:String(new Date().getFullYear()),origin_price:null,fixed_price:null,backup_price:null,route_tip:"",route_details:[],tonest_memo:"",has_polygon:false,is_active:true});row._new=true;row._dirty=true;state.rows.unshift(row);applyFilters();setStatus("새 라우트 행을 추가했습니다.","warn")}
function payloadFor(row){return {camp:text(row.camp),route_code:text(row.route_code).toUpperCase(),wave:text(row.wave)||null,contract_date:text(row.contract_date)||null,address:text(row.address)||null,delivery_location_name:text(row.delivery_location_name)||null,delivery_location_address:text(row.delivery_location_address)||null,vendor_name_2w:text(row.vendor_name_2w)||null,vendor_name_1w:text(row.vendor_name_1w)||null,vendor_business_number_2w:text(row.vendor_business_number_2w)||null,vendor_business_number_1w:text(row.vendor_business_number_1w)||null,current_period_code:text(row.current_period_code)||null,origin_price:rawMoney(row.origin_price),fixed_price:rawMoney(row.fixed_price),backup_price:rawMoney(row.backup_price),route_tip:text(row.route_tip)||null,route_details:Array.isArray(row.route_details)?row.route_details:[],tonest_memo:text(row.tonest_memo)||null,is_active:row.is_active!==false}}
async function saveOne(row){if(!text(row.camp)||!text(row.route_code))throw new Error("캠프와 라우트는 필수입니다.");const body=payloadFor(row);const payload=row._new?await api("/routes",{method:"POST",body:JSON.stringify(body)}):await api("/routes/"+row.id,{method:"PATCH",body:JSON.stringify(body)});const saved=payload?.row||{};Object.assign(row,saved);row._new=false;row._dirty=false;row._key=row.id||row._key;return row}
async function saveAll(){try{const dirty=state.rows.filter(r=>r._dirty||r._new);if(!dirty.length){setStatus("저장할 변경사항이 없습니다.","warn");return}setBusy(true,"변경사항 저장 중...");for(const row of dirty)await saveOne(row);await load();setStatus("전체 저장 완료 · 연결된 라우트는 MAROOWELL에도 반영되었습니다.","ok")}catch(e){console.error(e);setStatus("저장 실패: "+(e.message||String(e)),"err")}finally{setBusy(false)}}
async function openMapForRow(row){const popup=window.open("about:blank","_blank");try{if(row._new||row._dirty){setStatus(`${text(row.camp)||"신규"} / ${text(row.route_code)||"라우트"} 저장 후 지도 여는 중...`,"warn");await saveOne(row)}const url=mapUrl(row);if(popup){popup.location.href=url}else{window.open(url,"_blank")}setStatus("쿠팡 라우트 지도를 새 창으로 열었습니다.","ok")}catch(e){if(popup&&!popup.closed)popup.close();setStatus("지도 열기 실패: "+(e.message||String(e)),"err")}}
function showDetails(row){const details=Array.isArray(row.route_details)?row.route_details:[];dom.detailTitle.textContent=`${row.camp||"-"} · ${row.route_code||"-"} 서서브 정보 (${details.length}개)`;if(!details.length){dom.detailBody.innerHTML='<div class="empty">등록된 서서브 정보가 없습니다.</div>'}else{dom.detailBody.innerHTML=`<table class="detailTable"><thead><tr><th>코드</th><th>구역</th><th>설명</th><th>메모</th><th>소분</th></tr></thead><tbody>${details.map(d=>`<tr><td>${esc(d.route_code||[d.sub,d.sub_sub].filter(Boolean).join(""))}</td><td>${esc([d.sub,d.sub_sub].filter(Boolean).join(" / ")||"-")}</td><td>${esc(d.description||"-")}</td><td>${esc(d.memo||"-")}</td><td>${esc(d.sub_package||"-")}</td></tr>`).join("")}</tbody></table>`}dom.modal.classList.add("show")}
function closeDetails(){dom.modal.classList.remove("show")}
function exportCsv(){const rows=state.filtered;if(!rows.length){setStatus("내보낼 데이터가 없습니다.","warn");return}const header=["캠프","라우트","주/야","계약일","주소","입차지","입차지 주소","주간 벤더","야간 벤더","단가기간","원청단가","고정단가","백업단가","라우트 정보","서서브 수","폴리곤","TO:NEST 메모","MW subsubroute ID"];const data=rows.map(r=>[r.camp,r.route_code,r.wave,r.contract_date,r.address,r.delivery_location_name,r.delivery_location_address,r.vendor_name_2w,r.vendor_name_1w,r.current_period_code,r.origin_price,r.fixed_price,r.backup_price,r.route_tip,(r.route_details||[]).length,r.has_polygon?"Y":"N",r.tonest_memo,r.maroowell_subsubroute_id]);const csv=[header,...data].map(row=>row.map(v=>{const s=String(v??"");return /[",\n\r]/.test(s)?'"'+s.replaceAll('"','""')+'"':s}).join(",")).join("\r\n");const blob=new Blob(["\ufeff"+csv],{type:"text/csv;charset=utf-8"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="tonest_route_info_"+new Date().toISOString().slice(0,10)+".csv";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
dom.body.addEventListener("input",e=>{const el=e.target.closest("[data-k][data-f]");if(!el)return;const row=state.rows.find(r=>String(r._key)===String(el.dataset.k));if(!row)return;mark(row,el.dataset.f,el.value);if(el.tagName==="TEXTAREA"){el.style.height="auto";el.style.height=Math.max(44,el.scrollHeight)+"px"}});
dom.body.addEventListener("change",e=>{const el=e.target.closest("[data-k][data-f]");if(!el)return;const row=state.rows.find(r=>String(r._key)===String(el.dataset.k));if(!row)return;mark(row,el.dataset.f,el.value)});
dom.body.addEventListener("click",async e=>{const map=e.target.closest("[data-map]");if(map){const row=state.rows.find(r=>String(r._key)===String(map.dataset.map));if(row)await openMapForRow(row);return}const d=e.target.closest("[data-details]");if(d){const row=state.rows.find(r=>String(r._key)===String(d.dataset.details));if(row)showDetails(row);return}const del=e.target.closest("[data-delete]");if(del){const row=state.rows.find(r=>String(r._key)===String(del.dataset.delete));if(!row)return;if(row._new){state.rows=state.rows.filter(r=>r!==row);applyFilters();return}if(!confirm(`${row.camp} / ${row.route_code} TO:NEST 정보를 비활성 처리할까요?\nMAROOWELL 원본은 삭제하지 않습니다.`))return;try{await api("/routes/"+row.id,{method:"DELETE"});await load()}catch(err){setStatus(err.message||String(err),"err")}}});
[dom.search,dom.wave,dom.poly,dom.active].forEach(el=>el.addEventListener(el.tagName==="INPUT"?"input":"change",applyFilters));dom.clear.addEventListener("click",()=>{dom.search.value="";dom.wave.value="";dom.poly.value="";dom.active.value="active";applyFilters()});dom.reload.addEventListener("click",load);dom.add.addEventListener("click",addRow);dom.save.addEventListener("click",saveAll);dom.csv.addEventListener("click",exportCsv);dom.detailClose.addEventListener("click",closeDetails);dom.detailClose2.addEventListener("click",closeDetails);dom.modal.addEventListener("click",e=>{if(e.target===dom.modal)closeDetails()});document.addEventListener("keydown",e=>{if(e.key==="Escape")closeDetails()});
try{const ok=await initAuth();if(!ok)return;document.documentElement.style.visibility="visible";await load()}catch(e){console.error(e);document.documentElement.style.visibility="visible";setStatus(e.message||String(e),"err")}
})();
</script>
</body>
