.controls{display:grid;grid-template-columns:minmax(220px,1.05fr) minmax(220px,.8fr) minmax(330px,1.2fr) auto;gap:8px;align-items:end}.field{display:flex;flex-direction:column;gap:5px}.field label,.caption,.status,.campMeta,.routeLabel,.timeMeta,.selectionHint{font-size:12px;color:var(--muted);font-weight:700}.liveMode{height:46px;display:flex;align-items:center;padding:0 13px;border:1px solid var(--line2);border-radius:11px;background:#f8fbfa;color:#174846;font-size:12px;font-weight:800}.waveToggle{height:46px;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line2);border-radius:11px;overflow:hidden;background:#f8fbfa}.waveBtn{border:0;background:transparent;color:#64748b;font-size:13px;font-weight:850;cursor:pointer}.waveBtn.all.active{background:#174846;color:#fff}.waveBtn.day.active{background:var(--day);color:#fff}.waveBtn.night.active{background:var(--night);color:#fff}.autoRow{height:46px;display:flex;align-items:center;gap:4px;overflow-x:auto}.autoBtn{height:34px;min-width:44px;padding:0 8px;border-radius:999px;border:1px solid var(--line2);background:#fff;color:#64748b;font-size:11px;font-weight:800;cursor:pointer}.autoBtn.active{background:#e8f7f5;border-color:#8bd6cf;color:#0f766e}.actions .btn{height:46px;min-width:82px}.status{margin-top:8px;min-height:18px;font-size:12px}.status.err{color:#b42318}.status strong{color:#233b3d}
.sectionHead{display:flex;align-items:center;gap:8px;margin-bottom:9px}.sectionHead h2{font-size:17px;margin:0;font-weight:900;letter-spacing:-.03em}.headActions{margin-left:auto;display:flex;gap:6px}.copyBtn{height:32px;padding:0 11px;border-radius:9px;border:1px solid #99e3dc;background:#f0fdfa;color:#0f766e;font-size:11px;font-weight:850;cursor:pointer}.copyBtn.copied{background:#dcfce7;border-color:#86efac;color:#166534}
.summaryGrid{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:7px}.summaryBox{border:1px solid var(--line);border-radius:12px;padding:10px 11px;background:#fff;min-width:0}.summaryBox .label{font-size:11px;color:#607673;font-weight:800}.summaryBox .value{margin-top:4px;font-size:22px;font-weight:900;line-height:1.05;letter-spacing:-.035em}.summaryBox .sub{margin-top:5px;font-size:11px;line-height:1.35;color:#687d7a;font-weight:700}.summaryBox.delivery .value{color:var(--blue);font-size:19px}.summaryBox.freshDelivery .value{color:var(--fresh);font-size:19px}.summaryBox.return .value{color:var(--return);font-size:18px}.summaryBox.fresh .value{color:var(--olive);font-size:18px}.summaryBox.bad .value{color:var(--red)}
.campGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.driverGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.campCard,.driverCard{border:1px solid var(--line);border-radius:13px;background:#fff;padding:11px 12px}.campCard{cursor:pointer}.campCard:hover{border-color:#94d8d2}.campCard.selected{border:2px solid var(--primary);box-shadow:0 0 0 3px rgba(22,167,164,.09)}.campTop,.driverTop{display:flex;align-items:flex-start;gap:8px}.campName,.driverName{font-size:16px;font-weight:900}.campMeta,.routeLabel{margin-top:4px;line-height:1.45;word-break:break-all}.campOps{margin-top:6px;display:flex;gap:8px;flex-wrap:wrap;font-size:11.5px;font-weight:800}.campOps .bad{color:#b42318}.campOps .done{color:#15803d}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-top:9px}.driverCard .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.metricPanel{border-radius:10px;padding:10px 11px;min-width:0;border:1px solid rgba(148,163,184,.16)}.metricPanel.delivery{background:#f0f9ff}.metricPanel.freshDelivery{background:#f0fdf4}.metricPanel.return{background:#eef2ff}.metricPanel.fresh{background:#f7fee7}.metricPanel .k{font-size:13px;font-weight:900}.metricPanel.delivery .k{color:#0369a1}.metricPanel.freshDelivery .k{color:#15803d}.metricPanel.return .k{color:#4338ca}.metricPanel.fresh .k{color:#4d7c0f}.metricPanel .rate{margin-top:3px;font-size:16px;font-weight:900}.metricPanel .detail{margin-top:5px;font-size:12px;line-height:1.5;color:#52666f;font-weight:750}.metricBar,.scoreBar{height:7px;margin-top:7px;border-radius:999px;background:#e2e8f0;overflow:hidden}.metricBar i,.scoreBar i{display:block;height:100%;border-radius:inherit}.metricBar.delivery i,.scoreBar i{background:var(--blue)}.metricBar.freshDelivery i{background:var(--fresh)}.metricBar.return i{background:var(--return)}.metricBar.fresh i{background:var(--olive)}
.driverTop{position:relative;padding-bottom:27px}.driverCamp{display:inline-flex;margin-right:7px;color:#174846;font-size:16px;font-weight:900}.waveBadge{display:inline-flex;margin-right:5px;padding:3px 7px;border-radius:999px;font-size:10px;font-weight:900;vertical-align:2px}.waveBadge.day{background:#fff6df;color:#9a5b00}.waveBadge.night{background:#f2ecff;color:#6d28d9}.doneBadge{display:inline-flex;margin-left:6px;padding:3px 7px;border-radius:999px;background:#dcfce7;color:#15803d;font-size:10px;font-weight:900}.driverScore{margin-left:auto;min-width:102px;text-align:right}.driverScore b{display:block;font-size:16px;color:var(--blue);font-weight:900}.driverScore small{font-size:10.5px;color:#6b7f7c;font-weight:700}.timeMeta{position:absolute;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;font-size:11px;color:#5b6f6d;font-weight:750}.timeStep{display:flex;gap:4px;white-space:nowrap}.timeStep b{color:#334e4b}.routeChips{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}.routeChip{display:inline-flex;padding:3px 7px;border-radius:999px;border:1px solid #d8e6e4;background:#f8fbfa;color:#405b58;font-size:11px;font-weight:800}.routeChip.extra{border-color:#fecaca;background:#fff1f2;color:#b42318}.flagLine,.warnLine,.missLine{margin-top:7px;font-size:11.5px;font-weight:800}.missLine,.warnLine{color:#b42318}.flag{display:inline-flex;margin-right:4px;padding:3px 7px;border-radius:999px;background:#fff7ed;color:#c2410c}
.empty{padding:24px;text-align:center;color:#718481;font-size:12px;font-weight:750}.captureMeta{margin:0 0 10px;padding:7px 10px;border-radius:9px;background:#f4f8f7;color:#52666f;font-size:11px;font-weight:700}
.metaModalBackdrop{position:fixed;inset:0;z-index:100000;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(15,33,36,.55);backdrop-filter:blur(3px)}.metaModalBackdrop.open{display:flex}.metaModal{width:min(920px,100%);height:min(760px,92vh);display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 28px 90px rgba(0,0,0,.3)}.metaModalHead{display:flex;align-items:center;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}.metaModalHead b{font-size:16px}.metaModalHead .grow{flex:1}.metaModalGuide{padding:10px 14px;background:#f0fdfa;border-bottom:1px solid #c7eee9;color:#335b57;font-size:12px;font-weight:750;line-height:1.5}.metaModalActions{display:flex;gap:6px;padding:10px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap}.metaFrame{width:100%;flex:1;border:0;background:#f7faf9}.metaNote{padding:8px 14px;border-top:1px solid var(--line);font-size:11px;color:#647875;font-weight:700}
@media(max-width:1320px){.summaryGrid{grid-template-columns:repeat(5,1fr)}.driverGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
