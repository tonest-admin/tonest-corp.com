  b.title='\ud14c\uc774\ube14 \uc2e4\uc81c \uc870\ud68c \ud1b5\uacfc / '+(latest?fmtClock(latest.toISOString()):'\ucd5c\ucd08 \uc218\uc9d1 \ub300\uae30');
}
async function collectorClick(){
  if(S.controlBusy)return;
  try{
    S.controlBusy=true;renderCollectorState();
    const result=await api('/collector/check',{method:'POST'});
    if(!result?.schema || typeof result.schema.ready!=='boolean'){
      const msg='수집기 응답에 schema.ready가 없습니다. 프론트와 META Worker 코드 버전을 맞춰 배포하세요. (01_META_COLLECTOR_FULL.txt)';
      S.collectorError=msg;
      setStatus(esc(msg)+(result?.version?' / Worker version: '+esc(result.version):''),true);
      return;
    }
    S.schema=result.schema;
    setStatus(result.schema.ready?'DB 필수 컬럼 확인 완료. 수집 상태를 다시 읽습니다.':esc(schemaText(result.schema)),!result.schema.ready);
    await loadCollectorState();
  }catch(e){setStatus(esc(e?.message||String(e)),true);}finally{S.controlBusy=false;renderCollectorState();}
}
async function toggleCollector(){
  if(!S.isAdmin||S.controlBusy||S.collectorPaused==null)return;
  const pause=!S.collectorPaused;
  if(!confirm(pause?'\uc11c\ubc84 \uc790\ub3d9 \uc218\uc9d1\uc744 \uc911\uc9c0\ud560\uae4c\uc694? \uc774\ubbf8 \uc9c4\ud589 \uc911\uc778 \uc800\uc7a5\uc740 \ub9c8\ubb34\ub9ac\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.':'\uc790\ub3d9 \uc218\uc9d1\uc744 \uc2dc\uc791\ud560\uae4c\uc694? \uc2a4\ucf00\uc904 \uc5c6\uc774\ub3c4 META \ud604\ud669\uc744 \uc870\ud68c\ud569\ub2c8\ub2e4.'))return;
  S.controlBusy=true;renderCollectorState();
  try{
    const result=await api('/collector/control',{method:'POST',body:{paused:pause}});
    S.collectorPaused=result.paused;S.collectorState=result.state||S.collectorState;
    setStatus(pause?'\uc218\uc9d1\uc744 \uc911\uc9c0\ud588\uc2b5\ub2c8\ub2e4. \uae30\uc874 \ud604\ud669\uc740 \uc720\uc9c0\ub429\ub2c8\ub2e4.':result.requiresMetaLogin?'\uc218\uc9d1\uc744 \ucf30\uc2b5\ub2c8\ub2e4. META \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.':'\uc218\uc9d1\uc744 \uc2dc\uc791\ud588\uc2b5\ub2c8\ub2e4. \ub370\uc774\ud130 \uc870\ud68c \uc911\uc785\ub2c8\ub2e4.');
    if(result.requiresMetaLogin&&!pause)openMetaModal();
    await loadCollectorState();
    if(!pause){setTimeout(()=>queryAll(),3000);setTimeout(()=>queryAll(),12000);}
  }catch(e){setStatus(esc(e.message),true);}finally{S.controlBusy=false;renderCollectorState();}
}
async function collectNow(){
  if(S.controlBusy||S.collectorPaused!==false)return;
  S.controlBusy=true;renderCollectorState();setStatus('META \ud604\ud669\uc744 \uc989\uc2dc \uc218\uc9d1\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.');
  try{const result=await api('/collector/run',{method:'POST'});await queryAll();
    if(result.paused)setStatus('\uc218\uc9d1\uc774 \uc911\uc9c0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.');
    else if(result.successful===0&&!result.skipped)setStatus('META \uc870\ud68c \uc644\ub8cc. \uc870\ud68c \ub300\uc0c1 \ucea0\ud504: '+num(result.due||0)+'. '+esc(result.ensure?.find(x=>x.note)?.note||'\ubc30\uce58 \ub300\uae30 \uc911'));
  }catch(e){await queryAll();setStatus('\uc989\uc2dc \uc218\uc9d1 \uc2e4\ud328: '+esc(e.message),true);}
  finally{S.controlBusy=false;renderCollectorState();}
}
async function readAll(table,cols,configure){
  const rows=[];for(let offset=0;offset<100000;offset+=1000){const {data,error}=await configure(S.sb.from(table).select(cols)).order('id',{ascending:true}).range(offset,offset+999);if(error)throw error;rows.push(...(data||[]));if(!data||data.length<1000)return rows;}
  throw new Error('Too many rows; query was not partially displayed');
}
async function optionalSchedule(dates){
  try{const rows=await readAll('tonest_schedule','id,schedule_date,camp,wave,route_label,is_active,driver_coupang_id,driver_display_name,driver_name,driver_owner_name',q=>q.in('schedule_date',dates).eq('is_active',true));S.scheduleAvailable=rows.length>0;S.scheduleWarning='';return rows;}
  catch(e){if(!['42P01','42703','PGRST204','PGRST205'].includes(e.code))throw e;S.scheduleAvailable=false;S.scheduleWarning=e.message;return [];}
}
async function queryAll(){
  if(S.busy)return;setBusy(true);
  try{
    await loadCollectorState();
    if(S.schema?.ready===false){setStatus(esc(schemaText(S.schema)),true);return;}
    const activeStatuses=['collecting','completion_candidate','overdue','error','paused'];
    const dates=uniq([activeDate('WAVE1'),activeDate('WAVE2')]);
    const batches=(await readAll('meta_realtime_batch','id,schedule_date,meta_work_date,camp_code,camp_name,wave,status,worker_count,last_polled_at,next_poll_at,last_error,work_completed_at,visible_until,expected_rounds,metrics_status,metrics_close_at,metrics_closed_at,finalized_at,updated_at',q=>q.in('status',[...activeStatuses,'finalized']).in('schedule_date',dates))).filter(batchCurrent);
    const active=batches.filter(b=>b.status!=='finalized'),ids=batches.map(b=>b.id),activeIds=active.map(b=>b.id);
    const base='id,batch_id,schedule_date,meta_worker_key,driver_pk,camp_code,camp_name,wave,coupang_id,driver_name,scheduled_routes,actual_routes,extra_routes,delivery_assigned,delivery_scanned,delivery_completed,delivery_impossible,delivery_pdd_miss,delivery_total,delivery_complete_rate,return_pending,return_collected,return_uncollected,return_uncollected_raw,return_absent_raw,return_total,return_attempt_rate,return_collection_rate,freshbag_pending,freshbag_collected,freshbag_uncollected,freshbag_total,freshbag_attempt_rate,freshbag_collection_rate,scan_started_at,delivery_started_at,round1_delivery_started_at,round2_scan_started_at,round2_delivery_started_at,round3_scan_started_at,round3_delivery_started_at,round3_completed_at,expected_rounds,work_completed_at,all_completed_at,last_seen_at,all_done,dawn_miss,fresh_miss,raw_payload,fresh_delivery_assigned,fresh_delivery_scanned,fresh_delivery_completed,fresh_delivery_impossible,fresh_delivery_pdd_miss,fresh_delivery_total,fresh_delivery_complete_rate';
    const byIds=(table,cols,list)=>list.length?readAll(table,cols,q=>q.in('batch_id',list)):Promise.resolve([]);
    const [currentRows,freshRows,finalRows,schedules]=await Promise.all([
      byIds('meta_realtime_current',base+',current_round',activeIds),
      byIds('meta_realtime_fresh_current','id,batch_id,meta_worker_key,driver_pk,coupang_id,driver_name,delivery_assigned,delivery_scanned,delivery_completed,delivery_impossible,delivery_pdd_miss,delivery_total,delivery_complete_rate,fresh_miss',activeIds),
      byIds('meta_realtime_final',base+',current_round:actual_rounds',ids),optionalSchedule(dates)]);
    const currentKeys=new Set(currentRows.map(r=>r.batch_id+'|'+r.meta_worker_key));
    const merged=[...mergeFresh(currentRows,freshRows),...finalRows.filter(r=>!currentKeys.has(r.batch_id+'|'+r.meta_worker_key))];
    const byBatch=new Map();for(const r of merged){if(!byBatch.has(r.batch_id))byBatch.set(r.batch_id,[]);byBatch.get(r.batch_id).push(r);}
    const now=new Date();S.batches=batches.filter(b=>{const until=visibleUntil(b,byBatch.get(b.id)||[]);return !until||now<until;});
    const visible=new Set(S.batches.map(b=>b.id));S.rows=dedupeRows(merged.filter(r=>visible.has(r.batch_id)));S.scheduleRows=schedules;
    S.camps=buildCamps();S.selected=new Set([...S.selected].filter(k=>S.camps.some(c=>c.key===k)));S.lastQueryAt=Date.now();renderAll();
    const errors=S.batches.filter(b=>b.last_error),last=S.batches.map(b=>b.last_polled_at).filter(Boolean).sort().at(-1);
    const state=S.collectorPaused?'\uc218\uc9d1 \uc911\uc9c0':S.collectorError?'\uc218\uc9d1\uae30 \uc5f0\uacb0 \uc624\ub958':S.collectorState?.status==='active'?'\uc218\uc9d1 \ucf1c\uc9d0':'META \uc0c1\ud0dc \ud655\uc778 \ud544\uc694';
    setStatus(`${waveLabel(S.wave)} \u00b7 \uae30\uc0ac <strong>${num(S.camps.flatMap(c=>c.rows).length)}\uba85</strong> \u00b7 ${state} \u00b7 ${S.scheduleAvailable?'\uc2a4\ucf00\uc904 \uc5f0\ub3d9':'\uc2a4\ucf00\uc904 \uc5c6\uc74c / META \uae30\uc900'} \u00b7 \ucd5c\uadfc \uc218\uc9d1 ${fmtClock(last)}${errors.length?' \u00b7 '+esc(errors[0].last_error):''}`,errors.length>0||!!S.collectorError);
  }catch(e){console.error(e);setStatus('\ubc31\uc5d4\ub4dc \uc870\ud68c \uc2e4\ud328: '+esc(e.message||String(e)),true);}
  finally{setBusy(false);renderCollectorState();}
}
async function metaAction(path,asHtml=false){
  try{const {data:{session},error}=await S.sb.auth.getSession();if(error||!session)throw new Error('Login required');
    const response=await fetch(META_API+path,{method:'POST',headers:{Authorization:'Bearer '+session.access_token},signal:AbortSignal.timeout(90000)});
    const body=await response.text();if(!response.ok){let d;try{d=JSON.parse(body);}catch{}throw new Error(d?.error||'META HTTP '+response.status);}
    $('metaFrame').removeAttribute('src');$('metaFrame').srcdoc=asHtml?body:'<pre style="white-space:pre-wrap">'+esc(body)+'</pre>';
  }catch(e){setStatus(esc(e.message),true);}
}

boot();
})();
