.topbar{display:flex;align-items:center;gap:8px;padding:7px 10px;position:sticky;top:4px;z-index:20}.brandLogo{width:36px;height:36px;border:0;border-radius:10px;background:#fff;padding:0;display:grid;place-items:center;cursor:pointer}.brandLogo img{width:33px;height:33px;object-fit:contain}.brandTitle{font-size:20px;font-weight:900;line-height:1;margin:0;letter-spacing:-.03em}.grow{flex:1}
