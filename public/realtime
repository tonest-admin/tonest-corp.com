@media(max-width:760px){.wrap{padding:7px}.topbar{top:2px;flex-wrap:wrap}.pill.user{display:none}.controls{grid-template-columns:1fr}.actions{grid-column:auto}.actions .btn{width:100%}.summaryGrid{grid-template-columns:repeat(2,1fr)}.driverGrid{grid-template-columns:1fr}.metrics,.driverCard .metrics{grid-template-columns:1fr}.card{padding:10px;border-radius:14px}.selectionHint{display:none}.timeMeta{grid-template-columns:repeat(2,1fr);position:static;margin-top:7px}.driverTop{padding-bottom:0}.metaModalBackdrop{padding:7px}.metaModal{height:96vh}}
</style>
