<body>
<main class="wrap">
<header class="card topbar">
  <button id="tnBoardMenuToggle" class="brandLogo" type="button" aria-label="TO:NEST 메뉴 열기"><img src="/favicon.ico?v=15" alt="TO:NEST"></button>
  <h1 class="brandTitle">실시간 현황</h1>
  <div class="grow"></div>
  <span id="userPill" class="pill user">권한 확인 중</span>
  <button id="metaLoginBtn" class="btn meta" type="button">META 로그인 · 인증</button>
  <button id="collectorBtn" class="btn collectorOk" type="button" disabled>자동 수집 확인 중</button>
  <button id="logoutBtn" class="btn danger" type="button">로그아웃</button>
</header>

<section id="controlCard" class="card">
  <div class="controls">
    <div class="field"><label>조회 기준</label><div class="liveMode">현재 운행 배치 · TO:NEST 백엔드 자동 수집</div></div>
    <div class="field"><label>표시 필터</label><div class="waveToggle"><button class="waveBtn all active" data-wave="ALL">전체</button><button class="waveBtn day" data-wave="WAVE2">주간</button><button class="waveBtn night" data-wave="WAVE1">야간</button></div></div>
    <div class="field"><label>자동 새로고침</label><div class="autoRow"><button class="autoBtn" data-min="0">끔</button><button class="autoBtn active" data-min="1">1분</button><button class="autoBtn" data-min="3">3분</button><button class="autoBtn" data-min="5">5분</button><button class="autoBtn" data-min="10">10분</button><button class="autoBtn" data-min="15">15분</button><button class="autoBtn" data-min="30">30분</button></div></div>
    <div class="actions"><button id="queryBtn" class="btn primary">새로고침</button></div>
  </div>
  <div id="queryStatus" class="status">실시간 데이터를 준비하고 있습니다.</div>
</section>

<section id="summarySection" class="card">
  <div class="sectionHead"><h2 id="summaryTitle">전체 실시간 현황</h2><span id="summaryCaption" class="caption">조회 전</span><div class="headActions"><button class="copyBtn" data-copy-section="summarySection" data-copy-name="전체 현황">이미지 복사</button></div></div>
  <div class="summaryGrid">
    <div class="summaryBox"><div class="label">운행 캠프</div><div id="campCount" class="value">-</div><div class="sub">현재 배치 기준</div></div>
    <div class="summaryBox"><div class="label">기사</div><div id="attendanceCount" class="value">-</div><div class="sub">현재 표시 인원</div></div>
    <div class="summaryBox"><div class="label">주간 / 야간</div><div id="workerCount" class="value">-</div><div class="sub">현재 표시 기준</div></div>
    <div class="summaryBox"><div class="label">배송 수량</div><div id="deliveryTotal" class="value">-</div><div class="sub">전체 배송</div></div>
    <div class="summaryBox delivery"><div class="label">배송 완료율</div><div id="deliveryRate" class="value">-</div><div id="deliverySub" class="sub">-</div></div>
    <div class="summaryBox freshDelivery"><div class="label">신선 완료율</div><div id="freshDeliveryRate" class="value">-</div><div id="freshDeliverySub" class="sub">-</div></div>
    <div class="summaryBox return"><div class="label">반품</div><div id="returnRate" class="value">-</div><div id="returnSub" class="sub">-</div></div>
    <div class="summaryBox fresh"><div class="label">프백</div><div id="freshRate" class="value">-</div><div id="freshSub" class="sub">-</div></div>
    <div class="summaryBox bad"><div class="label">미스캔</div><div id="misscanTotal" class="value">-</div><div class="sub">배송 위탁/미스캔</div></div>
  </div>
</section>

<section id="campSection" class="card">
  <div class="sectionHead"><h2>캠프별 현황</h2><span id="campCaption" class="caption">조회 전</span><span class="selectionHint">여러 캠프 선택 가능 · ESC 전체 해제</span><div class="headActions"><button class="copyBtn" data-copy-section="campSection" data-copy-name="캠프별 현황">이미지 복사</button></div></div>
  <div id="campBody" class="empty">조회 결과가 여기에 표시됩니다.</div>
</section>

<section id="driverSection" class="card">
  <div class="sectionHead"><h2>기사별 현황</h2><span id="driverCaption" class="caption">완료율 낮은 순</span><div class="headActions"><button class="copyBtn" data-copy-section="driverSection" data-copy-name="기사별 현황">이미지 복사</button></div></div>
  <div id="driverBody" class="empty">조회 결과가 여기에 표시됩니다.</div>
</section>
</main>

<div id="metaModalBackdrop" class="metaModalBackdrop" aria-hidden="true">
  <section class="metaModal">
    <div class="metaModalHead"><b>META 로그인 · 문자 인증</b><div class="grow"></div><button id="metaModalClose" class="btn">닫기</button></div>
    <div class="metaModalGuide">아이디·비밀번호는 Cloudflare Worker 비밀값을 사용합니다. <b>로그인 시작</b>을 누르면 Worker가 자동 로그인 후 문자 인증번호를 발송하고, 아래 화면에서 6자리 코드만 입력하면 됩니다.</div>
    <div class="metaModalActions"><button id="metaStartLoginBtn" class="btn primary">로그인 시작 · 인증문자 발송</button><button id="metaTestBtn" class="btn">저장된 세션 확인</button><button id="metaFrameBlankBtn" class="btn">화면 비우기</button></div>
    <iframe id="metaFrame" class="metaFrame" title="META 인증 화면" src="about:blank"></iframe>
    <div class="metaNote">인증 성공 후 닫기를 누르면 수집 상태를 다시 읽습니다. 로그인 페이지를 다시 열면 새 인증문자가 발송될 수 있습니다.</div>
  </section>
</div>

<script>
(()=>{"use strict";
const META_API="https://meta-collector.tonest-admin.workers.dev";
const $=id=>document.getElementById(id);
const S={sb:null,session:null,profile:null,isAdmin:false,wave:"ALL",busy:false,auto:Number(localStorage.getItem("tnRealtimeAuto")||1),timer:null,collectorState:null,collectorPaused:false,batches:[],rows:[],camps:[],selected:new Set(),lastQueryAt:0};
const esc=v=>String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;");
const num=v=>new Intl.NumberFormat("ko-KR").format(Number(v||0));
const pct=v=>`${Number(v||0).toFixed(1)}%`;
const ratio=(a,b)=>Number(b||0)>0?Number(a||0)*100/Number(b):0;
const clamp=v=>Math.max(0,Math.min(100,Number(v||0)));
const uniq=a=>[...new Set((a||[]).filter(Boolean))];
const nameKey=v=>String(v||"").trim().replace(/\s+/g,"").toLowerCase();
const addIso=(date,days)=>{const d=new Date(date+"T00:00:00Z");d.setUTCDate(d.getUTCDate()+days);return d.toISOString().slice(0,10)};
const kstNow=()=>{const d=new Date(Date.now()+9*3600000);return{date:d.toISOString().slice(0,10),hour:d.getUTCHours()}};
const activeDate=wave=>{const k=kstNow();return wave==="WAVE1"&&k.hour<12?addIso(k.date,-1):k.date};
const waveLabel=w=>w==="WAVE1"?"야간":w==="WAVE2"?"주간":"전체";
const isNight=w=>w==="WAVE1";
const roleLabel=r=>({super_admin:"최고관리자",admin:"관리자",team_leader:"팀장",driver:"기사"})[r]||r||"-";
const parseKst=v=>{if(!v)return null;const s=String(v).trim().replace(" ","T");const d=new Date(/[zZ]|[+-]\d\d:\d\d$/.test(s)?s:s+"+09:00");return Number.isFinite(d.getTime())?d:null};
const fmtClock=v=>{if(!v)return"-";const m=String(v).match(/[T\s](\d{2}):(\d{2})/);return m?`${m[1]}:${m[2]}`:"-"};
function setStatus(t,e=false){$("queryStatus").innerHTML=t;$("queryStatus").classList.toggle("err",!!e)}
function setBusy(v){S.busy=!!v;$("queryBtn").disabled=S.busy}
function metricDelivery(r,p="delivery"){const total=Number(r[`${p}_total`]||0),completed=Number(r[`${p}_completed`]||0),impossible=Number(r[`${p}_impossible`]||0),remaining=Number(r[`${p}_scanned`]||0),assigned=Number(r[`${p}_assigned`]||0),pdd=Number(r[`${p}_pdd_miss`]||0);return{total,completed,impossible,remaining,assigned,pdd,rate:ratio(completed+impossible,total),hasData:total>0}}
function metricCollection(r,p,absent=false){const pending=Number(r[`${p}_pending`]||0),collected=Number(r[`${p}_collected`]||0),uncollected=Number(r[`${p}_uncollected`]??r[`${p}_uncollected_raw`]??0),abs=absent?Number(r[`${p}_absent_raw`]||0):0,total=Number(r[`${p}_total`]||0)||(pending+collected+uncollected+abs);return{pending,collected,uncollected,absent:abs,total,attempt:Number(r[`${p}_attempt_rate`]??ratio(collected+uncollected,total)),collection:Number(r[`${p}_collection_rate`]??ratio(collected,total))}}
function addD(a,b){for(const k of["total","completed","impossible","remaining","assigned","pdd"])a[k]=(a[k]||0)+(b[k]||0);a.rate=ratio(a.completed+a.impossible,a.total);a.hasData=a.total>0}
function addC(a,b){for(const k of["pending","collected","uncollected","absent","total"])a[k]=(a[k]||0)+(b[k]||0);a.attempt=ratio(a.collected+a.uncollected,a.total);a.collection=ratio(a.collected,a.total)}
function emptyD(){return{total:0,completed:0,impossible:0,remaining:0,assigned:0,pdd:0,rate:0,hasData:false}}
function emptyC(){return{pending:0,collected:0,uncollected:0,absent:0,total:0,attempt:0,collection:0}}
function batchCurrent(b){return String(b?.schedule_date||"")===activeDate(String(b?.wave||"").toUpperCase())}
