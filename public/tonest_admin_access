async function handleAdminUsers(request,env) {
  await requireSuperAdmin(
    request,
    env
  );

  const url =
    new URL(request.url);

  const query =
    cleanText(
      url.searchParams.get("q"),
      120
    ).toLowerCase();

  const roleFilter =
    cleanText(
      url.searchParams.get("role"),
      30
    );

  const statusFilter =
    cleanText(
      url.searchParams.get("status"),
      30
    );

  const emailState =
    cleanText(
      url.searchParams.get("email_state"),
      30
    );

  const [
    authUsers,
    profiles
  ] = await Promise.all([
    adminListUsers(env),
    getAllProfiles(env)
  ]);

  const profileMap =
    new Map(
      profiles.map(
        profile => [
          String(profile.user_id),
          profile
        ]
      )
    );

  let rows =
    authUsers.map(authUser =>
      mergedAdminUser(
        authUser,
        profileMap.get(
          String(authUser.id)
        ) || null
      )
    );

  if(query){
    rows =
      rows.filter(row =>
        [
          row.display_name,
          row.email,
          row.user_id
        ]
          .some(value =>
            String(value || "")
              .toLowerCase()
              .includes(query)
          )
      );
  }

  if(
    roleFilter &&
    VALID_ROLES.has(roleFilter)
  ){
    rows =
      rows.filter(
        row => row.role === roleFilter
      );
  }

  if(
    statusFilter &&
    VALID_STATUSES.has(statusFilter)
  ){
    rows =
      rows.filter(
        row => row.status === statusFilter
      );
  }

  if(emailState === "confirmed"){
    rows =
      rows.filter(
        row => row.email_confirmed
      );
  }

  if(emailState === "unconfirmed"){
    rows =
      rows.filter(
        row => !row.email_confirmed
      );
  }

  rows.sort((a,b) => {
    const statusRank = {
      pending:0,
      active:1,
      suspended:2,
      rejected:3
    };

    const ar =
      statusRank[a.status] ?? 9;

    const br =
      statusRank[b.status] ?? 9;

    if(ar !== br){
      return ar - br;
    }

    return String(a.display_name || a.email)
      .localeCompare(
        String(b.display_name || b.email),
        "ko",
        {
          numeric:true,
          sensitivity:"base"
        }
      );
  });

  const allMerged =
    authUsers.map(authUser =>
      mergedAdminUser(
        authUser,
        profileMap.get(
          String(authUser.id)
        ) || null
      )
    );

  const stats = {
    total:allMerged.length,
    pending:
      allMerged.filter(
        row => row.status === "pending"
      ).length,
    active:
      allMerged.filter(
        row => row.status === "active"
      ).length,
    suspended:
      allMerged.filter(
        row => row.status === "suspended"
      ).length,
    rejected:
      allMerged.filter(
        row => row.status === "rejected"
      ).length,
    unconfirmed:
      allMerged.filter(
        row => !row.email_confirmed
      ).length
  };

  return json(
    request,
    {
      ok:true,
      rows,
      stats
    }
  );
}

async function activeSuperAdminCount(env) {
  const response =
    await restServiceFetch(
      env,
      "/profiles" +
      "?select=user_id" +
      "&role=eq.super_admin" +
      "&status=eq.active"
