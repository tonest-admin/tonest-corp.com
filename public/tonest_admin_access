}

async function handleAdminApply(
  request,
  env
) {
  const actor =
    await requireSuperAdmin(
      request,
      env
    );

  let body;

  try{
    body =
      await request.json();
  }catch{
    throw httpError(
      400,
      "잘못된 요청 형식입니다."
    );
  }

  const userId =
    cleanText(
      body?.user_id,
      80
    );

  const role =
    cleanText(
      body?.role,
      30
    );

  const status =
    cleanText(
      body?.status,
      30
    );

  const confirmEmail =
    body?.confirm_email === true;

  if(!userId){
    throw httpError(
      400,
      "대상 user_id가 없습니다."
    );
  }

  if(!VALID_ROLES.has(role)){
    throw httpError(
      400,
      "허용되지 않은 권한입니다."
    );
  }

  if(!VALID_STATUSES.has(status)){
    throw httpError(
      400,
      "허용되지 않은 계정 상태입니다."
    );
  }

  let authUser =
    await adminGetUser(
      env,
      userId
    );

  /*
   * 사용자가 요청한 "강제 메일 확인".
   * Service Role이 있는 Worker에서만 실행.
   */
  if(
    confirmEmail &&
    !(
      authUser.email_confirmed_at ||
      authUser.confirmed_at
    )
  ){
    authUser =
      await forceConfirmEmail(
        env,
        userId
      );
  }

  const profile =
    await updateProfileRoleStatus(
      env,
      actor,
      authUser,
      role,
      status
    );

  return json(
    request,
    {
      ok:true,
      user:
        mergedAdminUser(
          authUser,
          profile
        )
    }
  );
}

async function handleAdminConfirmEmail(
  request,
  env
) {
  await requireSuperAdmin(
    request,
    env
  );

  let body;

  try{
    body =
      await request.json();
  }catch{
    throw httpError(
      400,
      "잘못된 요청 형식입니다."
    );
  }

  const userId =
    cleanText(
      body?.user_id,
      80
    );

  if(!userId){
    throw httpError(
      400,
      "대상 user_id가 없습니다."
    );
  }

  const current =
    await adminGetUser(
      env,
      userId
    );

  if(
    current.email_confirmed_at ||
    current.confirmed_at
  ){
    return json(
      request,
      {
        ok:true,
        already_confirmed:true,
        user:
          mergedAdminUser(
            current,
            await ensureProfile(
              env,
              current
            )
          )
      }
    );
  }

  const updated =
    await forceConfirmEmail(
      env,
      userId
    );

  return json(
    request,
    {
      ok:true,
      already_confirmed:false,
      user:
        mergedAdminUser(
          updated,
          await ensureProfile(
            env,
            updated
          )
        )
    }
  );
}

