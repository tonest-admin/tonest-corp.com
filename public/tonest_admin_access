  ).length;
}

async function updateProfileRoleStatus(
  env,
  actor,
  targetAuthUser,
  role,
  status
) {
  let profile =
    await ensureProfile(
      env,
      targetAuthUser
    );

  const currentRole =
    profile?.role || "driver";

  const currentStatus =
    profile?.status || "pending";

  if(
    targetAuthUser.id === actor.user.id &&
    (
      role !== "super_admin" ||
      status !== "active"
    )
  ){
    throw httpError(
      409,
      "현재 로그인 중인 최고관리자 본인은 강등하거나 정지할 수 없습니다."
    );
  }

  if(
    currentRole === "super_admin" &&
    currentStatus === "active" &&
    (
      role !== "super_admin" ||
      status !== "active"
    )
  ){
    const count =
      await activeSuperAdminCount(env);

    if(count <= 1){
      throw httpError(
        409,
        "마지막 최고관리자 계정은 강등하거나 비활성화할 수 없습니다."
      );
    }
  }

  const patch = {
    role,
    status,
    email:normalizeEmail(targetAuthUser.email)
  };

  if(status === "active"){
    patch.approved_at =
      new Date().toISOString();

    patch.approved_by =
      actor.user.id;
  }else if(
    status === "pending" ||
    status === "rejected"
  ){
    patch.approved_at = null;
    patch.approved_by = null;
  }

  const response =
    await restServiceFetch(
      env,
      "/profiles" +
      "?user_id=eq." +
      encodeURIComponent(targetAuthUser.id),
      {
        method:"PATCH",
        headers:{
          "Prefer":"return=representation"
        },
        body:JSON.stringify(patch)
      }
    );

  if(!response.ok){
    throw new Error(
      "프로필 권한 변경 실패: " +
      await response.text()
    );
  }

  const rows =
    await response.json();

  return rows?.[0] || null;
}

