async function requireSuperAdmin(request,env) {
  const user =
    await getSessionUser(
      request,
      env
    );

  if(!user?.id){
    throw httpError(
      401,
      "로그인이 필요합니다."
    );
  }

  const profile =
    await getProfileByUserId(
      env,
      user.id
    );

  if(
    !profile ||
    profile.status !== "active" ||
    profile.role !== "super_admin"
  ){
    throw httpError(
      403,
      "최고관리자 권한이 필요합니다."
    );
  }

  return {
    user,
    profile
  };
}

async function adminGetUser(env,userId) {
  const response =
    await serviceAuthFetch(
      env,
      "/auth/v1/admin/users/" +
      encodeURIComponent(userId)
    );

  const payload =
    await response
      .json()
      .catch(() => ({}));

  if(!response.ok){
    throw httpError(
      response.status,
      payload?.msg ||
      payload?.message ||
      "Auth 사용자 조회에 실패했습니다."
    );
  }

  return payload?.user || payload;
}

async function adminListUsers(env) {
  const all = [];
  const perPage = 1000;

  for(let page = 1; page <= 10; page += 1){
    const response =
      await serviceAuthFetch(
        env,
        "/auth/v1/admin/users" +
        "?page=" + page +
        "&per_page=" + perPage
      );

    const payload =
      await response
        .json()
        .catch(() => ({}));

    if(!response.ok){
      throw httpError(
        response.status,
        payload?.msg ||
        payload?.message ||
        "Auth 사용자 목록 조회에 실패했습니다."
      );
    }

    const users =
      Array.isArray(payload)
        ? payload
        : (
          Array.isArray(payload?.users)
            ? payload.users
            : []
        );

    all.push(...users);

    if(users.length < perPage){
      break;
    }
  }

  return all;
}

async function ensureProfile(env,authUser) {
  const existing =
    await getProfileByUserId(
      env,
      authUser.id
    );

  if(existing){
    return existing;
  }

  const metadata =
    authUser.user_metadata || {};

  const displayName =
    cleanText(
      metadata.display_name ||
      metadata.full_name ||
      metadata.name ||
      "",
      50
    ) || null;

  const response =
    await restServiceFetch(
      env,
      "/profiles" +
      "?on_conflict=user_id",
      {
        method:"POST",
        headers:{
          "Prefer":
            "resolution=merge-duplicates,return=representation"
        },
        body:JSON.stringify({
          user_id:authUser.id,
          email:normalizeEmail(authUser.email),
          display_name:displayName,
          role:"driver",
          status:"pending"
        })
      }
    );

  if(!response.ok){
    throw new Error(
      "누락 프로필 생성 실패: " +
      await response.text()
    );
  }

  const rows =
    await response.json();

  return rows?.[0] || null;
}

function mergedAdminUser(authUser,profile) {
  const metadata =
    authUser?.user_metadata || {};

  const emailConfirmedAt =
    authUser?.email_confirmed_at ||
    authUser?.confirmed_at ||
    null;

  return {
    user_id:authUser?.id || profile?.user_id || "",
    email:
      normalizeEmail(
        authUser?.email ||
        profile?.email ||
        ""
      ),
    display_name:
      profile?.display_name ||
      metadata.display_name ||
      metadata.full_name ||
      metadata.name ||
      "",
    role:
      profile?.role ||
      "driver",
    status:
      profile?.status ||
      "pending",
    approved_at:
      profile?.approved_at ||
      null,
    approved_by:
      profile?.approved_by ||
      null,
    profile_created_at:
      profile?.created_at ||
      null,
    profile_updated_at:
      profile?.updated_at ||
      null,
    auth_created_at:
      authUser?.created_at ||
      null,
    last_sign_in_at:
      authUser?.last_sign_in_at ||
      null,
    email_confirmed_at:
      emailConfirmedAt,
    email_confirmed:
      !!emailConfirmedAt,
    banned_until:
      authUser?.banned_until ||
      null,
    profile_missing:
      !profile
  };
}

