<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="referrer" content="origin">

  <title>TO:NEST 정보</title>

  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=7">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=7">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="/board-menu.js?v=2" defer></script>

  <style>
    :root{
      --bg:#f3f8f7;
      --panel:#fff;
      --line:#d7e5e2;
      --line2:#cbd9d6;
      --txt:#172124;
      --muted:#66787a;

      --sheetBg:#edf5f3;
      --headBg:#e5f3f1;
      --filterBg:#f2f9f8;
      --cellBg:#fff;
      --cellAlt:#f9fcfb;

      --primary:#16a7a4;
      --primary2:#118b89;

      --resignBg:#ffe7e4;
      --resignAlt:#ffddda;
      --resignBorder:#efb8b2;

      --vehicleWarn:#fff7cc;
      --vehicleWarnBorder:#e9d15e;

      --dirtyBg:#e4f6f4;
      --dirtyBorder:#31b7b1;

      --shadow:0 12px 30px rgba(15,45,47,.07);
      --font:"Segoe UI","Malgun Gothic","Noto Sans KR","Apple SD Gothic Neo",Arial,sans-serif;
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      width:100%;
      height:100%;
      font-family:var(--font);
      color:var(--txt);
      background:
        radial-gradient(circle at 10% 0%,rgba(22,167,164,.07),transparent 30%),
        radial-gradient(circle at 90% 0%,rgba(17,139,137,.06),transparent 28%),
        linear-gradient(180deg,#fff 0%,var(--bg) 100%);
      -webkit-font-smoothing:antialiased;
    }

    body{overflow:hidden}

    button,input,select,textarea{
      font-family:var(--font);
    }

    .app{
      width:100%;
      height:100%;
      display:grid;
      grid-template-rows:auto auto auto 1fr auto;
      gap:0;
      min-width:0;
    }

    .topbar{
      width:calc(100% - 24px);
      display:flex;
      align-items:center;
      gap:10px;
      margin:8px 12px 0;
      padding:9px 14px;
      border:1px solid var(--line);
      border-radius:20px;
      background:rgba(255,255,255,.97);
      box-shadow:var(--shadow);
      overflow:auto hidden;
      min-width:0;
    }

    .brandButton{
      width:38px;
      height:38px;
      flex:0 0 38px;
      padding:0;
      border:0;
      border-radius:10px;
      background:#fff;
      display:grid;
      place-items:center;
      cursor:pointer;
    }

    .brandButton img{
      width:32px;
      height:32px;
      object-fit:contain;
      display:block;
    }

    .titleBox{
      display:flex;
      flex-direction:column;
      min-width:0;
      flex:0 0 auto;
    }

    .titleBox b{
      font-size:20px;
      line-height:1.05;
      font-weight:800;
      letter-spacing:-.035em;
      white-space:nowrap;
    }

    .titleBox small{
      margin-top:3px;
      color:var(--muted);
      font-size:11px;
      font-weight:600;
      white-space:nowrap;
    }

    .spacer{flex:1 0 24px}

    .roleBadge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      height:34px;
      padding:0 12px;
      border:1px solid #bfe0dc;
      border-radius:999px;
      background:#f4fbfa;
      color:#46615f;
      font-size:11px;
      font-weight:700;
      white-space:nowrap;
    }

    .btn{
      height:38px;
      padding:0 14px;
      border-radius:999px;
      border:1px solid var(--line2);
      background:#fff;
      color:var(--txt);
      cursor:pointer;
      font-size:12px;
      font-weight:700;
      white-space:nowrap;
      flex:0 0 auto;
    }

    .btn:hover{
      background:#f7fbfa;
      border-color:#92cdc8;
    }

    .btn.primary{
      background:linear-gradient(180deg,#20b9b3,#16a7a4);
      border-color:#16a7a4;
      color:#fff;
    }

    .btn.warn{
      background:linear-gradient(180deg,#f5b64a,#df9318);
      border-color:#df9318;
      color:#fff;
    }

    .btn.danger{
      background:#fff6f6;
      border-color:#fecaca;
      color:#dc2626;
    }

    .btn:disabled{
      opacity:.55;
      cursor:not-allowed;
    }

    .toolbar{
      width:calc(100% - 24px);
      display:flex;
      align-items:center;
      gap:12px;
      margin:8px 12px 0;
      padding:8px 12px;
      background:rgba(255,255,255,.97);
      border:1px solid var(--line);
      border-radius:18px;
      overflow:auto hidden;
      min-width:0;
      box-shadow:0 8px 22px rgba(15,45,47,.05);
    }

    .group{
      display:flex;
      align-items:center;
      gap:8px;
      padding-right:12px;
      border-right:1px solid var(--line);
      flex:0 0 auto;
    }

    .group:last-child{
      border-right:none;
      padding-right:0;
    }

    .toggle{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid var(--line2);
      background:#f7fbfa;
      color:#36504e;
      font-size:11px;
      font-weight:700;
      white-space:nowrap;
    }

    .toggle input{
      width:16px;
      height:16px;
      margin:0;
      accent-color:var(--primary);
      cursor:pointer;
    }

    .helper{
      color:#4f6564;
      font-size:11px;
      font-weight:600;
      white-space:nowrap;
    }

    .hiddenColumnBar{
      min-height:0;
      display:flex;
      align-items:center;
      gap:8px;
      margin:8px 12px 0;
      padding:8px 12px;
      background:rgba(255,255,255,.97);
      border:1px solid var(--line);
      border-radius:16px;
      overflow:auto hidden;
      box-shadow:0 7px 18px rgba(15,45,47,.04);
    }

    .hiddenColumnBar.empty{display:none}

    .hiddenLabel{
      color:var(--primary2);
      font-size:11px;
      font-weight:800;
      flex:0 0 auto;
    }

    .hiddenChip{
      height:30px;
      padding:0 11px;
      border-radius:999px;
      border:1px solid #b9dfdb;
      background:#eef9f7;
      color:#117c79;
      font-size:11px;
      font-weight:700;
      cursor:pointer;
      white-space:nowrap;
      flex:0 0 auto;
    }

    .hiddenChip.all{
      border-color:#bbf7d0;
      background:#f0fdf4;
      color:#15803d;
    }

    .sheetWrap{
      width:calc(100% - 24px);
      min-width:0;
      overflow:auto;
      margin:8px 12px 0;
      border:1px solid var(--line);
      border-radius:16px;
      background:var(--sheetBg);
      box-shadow:var(--shadow);
    }

    .sheetInner{min-width:max-content}

    table{
      width:max-content;
      border-collapse:separate;
      border-spacing:0;
      table-layout:fixed;
      color:#142321;
      font-size:12px;
      font-weight:600;
    }

    th,td{
      border-right:1px solid var(--line2);
      border-bottom:1px solid var(--line2);
    }

    th:first-child,
    td:first-child{
      border-left:1px solid var(--line2)
    }

    thead th{
      position:sticky;
      top:0;
      z-index:4;
      background:var(--headBg);
      padding:8px 7px;
      text-align:center;
      color:#28413f;
      font-size:11px;
      font-weight:750;
      white-space:nowrap;
    }

    thead tr.filterRow th{
      top:39px;
      z-index:3;
      background:var(--filterBg);
      padding:6px;
    }

    .thInner{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:5px;
      min-width:0;
      padding:0 2px;
    }

    .thLabel{
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .hideColBtn{
      height:20px;
      min-width:32px;
      padding:0 6px;
      border-radius:999px;
      border:1px solid #f3a3af;
      background:#ffe5e9;
      color:#b4233c;
      font-size:9px;
      font-weight:900;
      cursor:pointer;
    }

    tbody td{
      background:var(--cellBg);
      padding:0;
      vertical-align:middle;
    }

    tbody tr:nth-child(even) td{
      background:var(--cellAlt)
    }

    tbody tr.resigned-row td{
      background:var(--resignBg)!important;
      border-bottom-color:var(--resignBorder);
    }

    tbody tr.resigned-row:nth-child(even) td{
      background:var(--resignAlt)!important;
    }

    td.vehicle-warn{
      background:var(--vehicleWarn)!important;
      box-shadow:inset 0 0 0 1px var(--vehicleWarnBorder);
    }

    td.dirty-cell{
      background:var(--dirtyBg)!important;
      box-shadow:inset 0 0 0 2px var(--dirtyBorder);
    }

    .cellView{
      min-height:42px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:0 9px;
      font-size:12px;
      line-height:1.35;
      font-weight:600;
      word-break:break-word;
      overflow-wrap:anywhere;
    }

    .cellView.right{
      justify-content:flex-end;
      text-align:right;
      font-variant-numeric:tabular-nums;
    }

    .cellInput,
    .cellSelect{
      width:100%;
      min-height:42px;
      border:none;
      outline:none;
      background:transparent;
      color:#142321;
      padding:9px;
      font:inherit;
      font-size:12px;
      font-weight:600;
      border-radius:0;
    }

    .cellInput.code{
      font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
      font-size:11px;
    }

    .cellInput.center,
    .cellSelect.center{text-align:center}

    .cellInput.right{
      text-align:right;
      font-variant-numeric:tabular-nums;
    }

    .inlineCheckCell{
      min-height:42px;
      display:flex;
      align-items:center;
      gap:3px;
      padding:0 4px;
    }

    .inlineCheck{
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:1px;
      flex:0 0 auto;
      min-width:22px;
      color:#405351;
      font-size:7px;
      line-height:1;
      font-weight:800;
      cursor:pointer;
      user-select:none;
      white-space:nowrap;
    }

    .inlineCheck input{
      width:12px;
      height:12px;
      margin:0;
      accent-color:var(--primary);
      cursor:pointer;
    }

    .inlineCheck.resigned input{accent-color:#dc2626}

    .inlineNameInput{
      min-width:0;
      flex:1;
      width:62px!important;
      padding-left:4px!important;
      padding-right:2px!important;
      font-weight:750;
    }

    .filterInput{
      width:100%;
      height:34px;
      border-radius:10px;
      border:1px solid #c4d8d5;
      background:#fff;
      color:#263d3b;
      padding:0 10px;
      font-size:11px;
      font-weight:600;
      outline:none;
    }

    .filterInput:focus{
      border-color:#62c2bd;
      box-shadow:0 0 0 3px rgba(22,167,164,.11);
    }

    .docCellBtn{
      min-width:92px;
      height:28px;
      padding:0 10px;
      border:1px solid #b9dfdb;
      border-radius:9px;
      background:#eef9f7;
      color:#117c79;
      cursor:pointer;
      font-size:10px;
      font-weight:750;
      white-space:nowrap;
    }

    .docCellBtn.hasDocs{
      background:#f0fdf4;
      border-color:#bbf7d0;
      color:#15803d;
    }

    .docCellBtn:disabled{
      cursor:not-allowed;
      opacity:.55;
    }

    .rowActionBtn{
      width:32px;
      height:30px;
      border-radius:9px;
      border:1px solid #fecaca;
      background:#fff5f5;
      color:#dc2626;
      cursor:pointer;
      font-size:10px;
      font-weight:700;
    }

    .emptyDataRow td{
      height:88px;
      text-align:center;
      color:#64748b;
      font-weight:600;
      background:#eef5f3;
    }

    .statusbar{
      width:100%;
      display:flex;
      align-items:center;
      gap:8px;
      padding:6px 12px;
      border-top:1px solid var(--line);
      background:rgba(255,255,255,.97);
      min-width:0;
      overflow:auto hidden;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      height:28px;
      padding:0 12px;
      border-radius:999px;
      border:1px solid var(--line);
      background:#f8fbfa;
      color:#36504e;
      font-size:11px;
      font-weight:700;
      white-space:nowrap;
      flex:0 0 auto;
    }

    .pill.ok{
      border-color:#bbf7d0;
      background:#f0fdf4;
      color:#15803d;
    }

    .pill.warn{
      border-color:#fde68a;
      background:#fffbeb;
      color:#a16207;
    }

    .pill.err{
      border-color:#fecaca;
      background:#fff5f5;
      color:#dc2626;
    }

    .statusText{
      color:#4f6564;
      font-size:11px;
      font-weight:650;
      min-width:max-content;
    }

    /* 서류 모달 */
    .docModal{
      position:fixed;
      inset:0;
      z-index:1200;
      display:none;
      align-items:center;
      justify-content:center;
      padding:24px;
      background:rgba(15,33,36,.44);
      backdrop-filter:blur(4px);
    }

    .docModal.show{display:flex}

    .docDialog{
      width:min(1040px,96vw);
      max-height:92vh;
      display:flex;
      flex-direction:column;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:22px;
      background:#fff;
      box-shadow:0 28px 90px rgba(15,45,47,.24);
    }

    .docHeader{
      display:flex;
      align-items:center;
      gap:12px;
      padding:17px 20px;
      border-bottom:1px solid var(--line);
      background:linear-gradient(180deg,#fff,#f7fbfa);
    }

    .docTitleBox{min-width:0;flex:1}

    .docTitle{
      margin:0;
      color:#172124;
      font-size:20px;
      font-weight:800;
      letter-spacing:-.035em;
    }

    .docSubtitle{
      margin-top:4px;
      color:#5d706f;
      font-size:12px;
      font-weight:600;
    }

    .docClose{
      width:34px;
      height:34px;
      border:1px solid var(--line);
      border-radius:10px;
      background:#fff;
      color:#475b59;
      cursor:pointer;
      font-size:18px;
    }

    .docSummary{
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      padding:12px 20px;
      border-bottom:1px solid var(--line);
      background:#fbfefd;
    }

    .docSummaryChip{
      display:inline-flex;
      align-items:center;
      min-height:27px;
      padding:0 10px;
      border:1px solid var(--line);
      border-radius:999px;
      background:#fff;
      color:#2e4240;
      font-size:11px;
      font-weight:700;
    }

    .docSummaryChip.ok{
      border-color:#bbf7d0;
      background:#f0fdf4;
      color:#15803d;
    }

    .docBody{
      overflow:auto;
      padding:16px 20px 22px;
      background:#f3f8f7;
    }

    .docGroup{margin-bottom:18px}
    .docGroup:last-child{margin-bottom:0}

    .docGroupTitle{
      display:flex;
      align-items:center;
      gap:8px;
      margin:0 0 9px;
      color:#172124;
      font-size:12px;
      font-weight:800;
    }

    .docGroupTitle span{
      color:#66787a;
      font-size:10px;
      font-weight:600;
    }

    .docGrid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
    }

    .docCard{
      min-width:0;
      border:1px solid var(--line);
      border-radius:15px;
      background:#fff;
      padding:13px;
      box-shadow:0 5px 14px rgba(15,45,47,.035);
    }

    .docCardTop{
      display:flex;
      align-items:flex-start;
      gap:10px;
    }

    .docCardInfo{min-width:0;flex:1}

    .docLabel{
      color:#172124;
      font-size:13px;
      font-weight:800;
      line-height:1.35;
    }

    .docScope{
      margin-top:3px;
      color:#617371;
      font-size:10px;
      font-weight:600;
    }

    .docStatus{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:48px;
      height:24px;
      padding:0 8px;
      border-radius:999px;
      border:1px solid #fecaca;
      background:#fff5f5;
      color:#dc2626;
      font-size:10px;
      font-weight:800;
      white-space:nowrap;
    }

    .docStatus.ok{
      border-color:#bbf7d0;
      background:#f0fdf4;
      color:#15803d;
    }

    .docFileMeta{
      margin-top:9px;
      padding:8px 9px;
      border-radius:10px;
      background:#f7fbfa;
      color:#566866;
      font-size:10px;
      font-weight:600;
      line-height:1.5;
      word-break:break-all;
    }

    .docActions{
      display:flex;
      align-items:center;
      gap:6px;
      flex-wrap:wrap;
      margin-top:9px;
    }

    .docBtn{
      height:27px;
      padding:0 10px;
      border:1px solid var(--line2);
      border-radius:8px;
      background:#fff;
      color:#36504e;
      cursor:pointer;
      font-size:10px;
      font-weight:700;
    }

    .docBtn.primary{
      border-color:#99dcd7;
      background:#eef9f7;
      color:#117c79;
    }

    .docBtn.danger{
      border-color:#fecaca;
      background:#fff5f5;
      color:#dc2626;
    }

    .docHistory{
      margin-top:9px;
      border-top:1px dashed var(--line);
      padding-top:8px;
    }

    .docHistory summary{
      cursor:pointer;
      color:#5a6d6b;
      font-size:10px;
      font-weight:700;
      user-select:none;
    }

    .docHistoryRow{
      display:flex;
      align-items:center;
      gap:8px;
      margin-top:7px;
      padding:7px 8px;
      border-radius:9px;
      background:#f7fbfa;
    }

    .docHistoryText{
      min-width:0;
      flex:1;
      color:#566866;
      font-size:10px;
      font-weight:600;
      line-height:1.35;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .docEmpty{
      padding:28px 12px;
      text-align:center;
      color:#66787a;
      font-size:12px;
      font-weight:600;
    }

    .docBusy{
      pointer-events:none;
      opacity:.65;
    }

    .accessDenied{
      position:fixed;
      inset:0;
      z-index:1300;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:rgba(245,250,249,.97);
    }

    .accessDenied.show{display:flex}

    .accessCard{
      width:min(520px,100%);
      border:1px solid var(--line);
      border-radius:22px;
      background:#fff;
      box-shadow:0 24px 70px rgba(15,45,47,.14);
      padding:24px;
    }

    .accessCard h2{
      margin:0 0 10px;
      font-size:24px;
      font-weight:800;
    }

    .accessCard p{
      margin:0;
      color:#566866;
      line-height:1.6;
      font-size:14px;
      font-weight:600;
      white-space:pre-wrap;
    }

    .accessMeta{
      margin-top:14px;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid var(--line);
      background:#f7fbfa;
      font-size:13px;
      font-weight:600;
      word-break:break-word;
    }

    .accessActions{
      margin-top:18px;
      display:flex;
      gap:10px;
      justify-content:flex-end;
      flex-wrap:wrap;
    }

    @media(max-width:980px){
      .topbar,.toolbar,.sheetWrap,.hiddenColumnBar{
        width:100%;
        margin-left:0;
        margin-right:0;
        border-left:0;
        border-right:0;
        border-radius:0;
      }
    }

    @media(max-width:760px){
      .docModal{padding:8px}
      .docDialog{
        width:100%;
        max-height:96vh;
        border-radius:16px;
      }
      .docHeader{padding:14px}
      .docSummary{padding:10px 14px}
      .docBody{padding:12px}
      .docGrid{grid-template-columns:1fr}
    }
  </style>
</head>

<body>
<div class="app">

  <div class="topbar">
    <button
      id="tnBoardMenuToggle"
      class="brandButton"
      type="button"
      title="TO:NEST 메뉴"
      aria-label="TO:NEST 메뉴"
    >
      <img src="/favicon.ico?v=7" alt="TO:NEST">
    </button>

    <div class="titleBox">
      <b>TO:NEST 정보</b>
      <small>인사 · 운영 기본정보 관리</small>
    </div>

    <div class="spacer"></div>

    <span id="roleBadge" class="roleBadge">권한 확인 중</span>

    <button id="btnReload" class="btn" type="button">불러오기</button>
    <button id="btnAddRow" class="btn warn" type="button">행 추가</button>
    <button id="btnSaveAll" class="btn primary" type="button">전체 저장</button>
