  async function uploadDocumentFile(file){
    const personId =
      Number(state.documentPersonId || 0);

    const typeCode =
      state.documentUploadType;

    const type =
      state.documentTypes.find(
        item => item.code === typeCode
      );

    if(!personId || !type || !file){
      return;
    }

    const allowed = new Set([
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/heic",
      "image/heif",
      "application/pdf"
    ]);

    if(!allowed.has(file.type)){
      alert(
        "JPG, PNG, WebP, HEIC/HEIF, PDF 파일만 등록할 수 있습니다."
      );
      return;
    }

    if(file.size > DOCUMENT_MAX_BYTES){
      alert(
        "파일은 50MB 이하만 등록할 수 있습니다."
      );
      return;
    }

    const existing =
      documentsForType(
        personId,
        typeCode
      );

    const currentDocs =
      existing.filter(
        doc => doc.is_current !== false
      );

    const versionNo =
      Math.max(
        0,
        ...existing.map(
          doc => Number(doc.version_no || 0)
        )
      ) + 1;

    const uid =
      globalThis.crypto?.randomUUID?.() ||
      (
        Date.now() +
        "_" +
        Math.random().toString(16).slice(2)
      );

    const storagePath =
      `${personId}/${typeCode}/${uid}.${safeFileExtension(file)}`;

    let inserted = null;

    try{
      setDocumentBusy(true);
      setStatus(
        `${type.label} 업로드 중...`,
        "warn"
      );

      const uploadResult =
        await supabase
          .storage
          .from(DOCUMENT_BUCKET)
          .upload(
            storagePath,
            file,
            {
              contentType:file.type,
              cacheControl:"3600",
              upsert:false
            }
          );

      if(uploadResult.error){
        throw uploadResult.error;
      }

      const insertResult =
        await supabase
          .from("tonest_info_documents")
          .insert({
            tonest_info_id:personId,
            document_type:typeCode,
            document_label:type.label,
            storage_path:storagePath,
            original_filename:file.name || null,
            mime_type:file.type || null,
            file_size:file.size || null,
            is_current:true,
            version_no:versionNo
          })
          .select()
          .single();

      if(insertResult.error){
        await supabase
          .storage
          .from(DOCUMENT_BUCKET)
          .remove([storagePath]);

        throw insertResult.error;
      }

      inserted = insertResult.data;

      if(currentDocs.length){
        const ids =
          currentDocs
            .map(doc => doc.id)
            .filter(Boolean);

        const updateResult =
          await supabase
            .from("tonest_info_documents")
            .update({
              is_current:false
            })
            .in("id",ids);

        if(updateResult.error){
          await supabase
            .from("tonest_info_documents")
            .delete()
            .eq("id",inserted.id);

          await supabase
            .storage
            .from(DOCUMENT_BUCKET)
            .remove([storagePath]);

          throw updateResult.error;
        }
      }

      await loadDocumentData();

      renderDocumentsModal();
      renderTable();

      setStatus(
        `${type.label} 등록 완료`,
        "ok"
      );

    }catch(error){
      console.error(error);

      alert(
        "서류 등록 실패: " +
        (error?.message || String(error))
      );

      setStatus(
        "서류 등록 실패",
        "err"
      );

    }finally{
      setDocumentBusy(false);
      state.documentUploadType = "";
      dom.documentFileInput.value = "";
    }
  }

  async function deleteDocument(docId){
    const doc =
      state.documents.find(
        item => String(item.id) === String(docId)
      );

    if(!doc) return;

    if(
      !confirm(
        `${doc.document_label || "서류"} 파일을 삭제할까요?`
      )
    ){
      return;
    }

    try{
      setDocumentBusy(true);

      const deleteResult =
        await supabase
          .from("tonest_info_documents")
          .delete()
          .eq("id",doc.id);

      if(deleteResult.error){
        throw deleteResult.error;
      }

      const removeResult =
        await supabase
          .storage
          .from(DOCUMENT_BUCKET)
          .remove([doc.storage_path]);

      if(removeResult.error){
        console.warn(
          "storage cleanup failed",
          removeResult.error
        );
      }

      if(doc.is_current !== false){
        const remaining =
          await supabase
            .from("tonest_info_documents")
            .select("id")
            .eq(
              "tonest_info_id",
              doc.tonest_info_id
            )
            .eq(
              "document_type",
              doc.document_type
            )
            .order(
              "version_no",
              {ascending:false}
            )
            .limit(1);

        if(
          !remaining.error &&
          remaining.data?.[0]?.id
        ){
          await supabase
            .from("tonest_info_documents")
            .update({
              is_current:true
            })
            .eq(
              "id",
              remaining.data[0].id
            );
        }
      }

      await loadDocumentData();
      renderDocumentsModal();
      renderTable();

      setStatus(
        "서류 삭제 완료",
        "ok"
      );

    }catch(error){
      console.error(error);

      alert(
        "서류 삭제 실패: " +
        (error?.message || String(error))
      );

      setStatus(
        "서류 삭제 실패",
        "err"
      );

    }finally{
      setDocumentBusy(false);
    }
  }

  function bindEvents(){
    dom.btnReload.addEventListener("click",fetchRows);
    dom.btnAddRow.addEventListener("click",addRow);
    dom.btnSaveAll.addEventListener("click",saveAll);
    dom.btnExportExcel.addEventListener("click",exportExcel);
    dom.btnClearFilters.addEventListener("click",clearFilters);

    dom.btnLogout.addEventListener(
      "click",
      async () => {
        try{
          await supabase.auth.signOut();
        }finally{
          location.replace("/");
        }
      }
    );

    dom.toggleIncludeResigned.addEventListener(
      "change",
      () => applyFilters()
    );

    dom.toggleOnlyChanged.addEventListener(
      "change",
      () => applyFilters()
    );

    dom.tableHead.addEventListener(
      "compositionstart",
      event => {
        const target = event.target;

        if(
          target instanceof HTMLInputElement &&
          target.dataset.filter
        ){
          target.dataset.composing = "1";
        }
      }
    );

    dom.tableHead.addEventListener(
      "compositionend",
      event => {
        const target = event.target;

        if(
          !(target instanceof HTMLInputElement)
        ){
          return;
        }

        const key =
          target.dataset.filter;

        if(!key) return;

        target.dataset.composing = "";
        state.filters[key] = target.value;

        applyFilters({
          renderStructure:false
        });
      }
    );

    dom.tableHead.addEventListener(
      "input",
      event => {
        const target = event.target;

        if(
          !(target instanceof HTMLInputElement)
        ){
          return;
        }

        const key =
          target.dataset.filter;

        if(!key) return;

        if(
          event.isComposing ||
          target.dataset.composing === "1"
        ){
          return;
        }

        state.filters[key] = target.value;

        applyFilters({
          renderStructure:false
        });
      }
    );

    dom.tableHead.addEventListener(
      "click",
      event => {
        const button =
          event.target.closest("[data-hide-col]");

        if(!button) return;

        hideColumn(
          button.getAttribute("data-hide-col")
        );
      }
    );

    dom.hiddenColumnBar.addEventListener(
      "click",
      event => {
        const button =
          event.target.closest("button");

        if(!button) return;

        if(
          button.hasAttribute(
            "data-show-all-cols"
          )
        ){
          showAllColumns();
          return;
        }

        const key =
          button.getAttribute(
            "data-show-col"
          );

        if(key){
          showColumn(key);
        }
      }
    );

    dom.sheetBody.addEventListener(
      "input",
      event => {
        const target = event.target;

        if(!(target instanceof HTMLElement)){
          return;
        }

        const id =
          target.getAttribute("data-row-id");

        const key =
          target.getAttribute("data-key");

        if(!id || !key) return;

        const row =
          findRowById(id);

        if(!row) return;

        const value =
          target instanceof HTMLInputElement &&
          target.type === "checkbox"
            ? (target.checked ? "true" : "false")
            : target.value;

        markRowDirty(
          row,
          key,
          value
        );

        if(
          key === "is_resigned" &&
          !dom.toggleIncludeResigned.checked &&
          isResigned(row)
        ){
          applyFilters();
        }
      }
    );

    dom.sheetBody.addEventListener(
      "change",
      event => {
        const target = event.target;

        if(!(target instanceof HTMLElement)){
          return;
        }

        const id =
          target.getAttribute("data-row-id");

        const key =
          target.getAttribute("data-key");

        if(!id || !key) return;

        const row =
          findRowById(id);

        if(!row) return;

        const value =
          target instanceof HTMLInputElement &&
          target.type === "checkbox"
            ? (target.checked ? "true" : "false")
            : target.value;

        markRowDirty(
          row,
          key,
          value
        );

        if(
          key === "is_resigned" &&
          !dom.toggleIncludeResigned.checked &&
          isResigned(row)
        ){
          applyFilters();
        }
      }
    );

    dom.sheetBody.addEventListener(
      "click",
      event => {
        const target = event.target;

        if(!(target instanceof HTMLElement)){
          return;
        }

        const docsId =
          target.getAttribute(
            "data-docs-row"
          );

        if(docsId){
          const row =
            findRowById(docsId);

          if(row){
            openDocumentsModal(row);
          }

          return;
        }

        const deleteId =
          target.getAttribute(
            "data-delete-row"
          );

        if(deleteId){
          deleteRow(deleteId);
        }
      }
    );

    dom.btnDocumentsClose.addEventListener(
      "click",
      closeDocumentsModal
    );

    dom.documentsModal.addEventListener(
      "click",
      event => {
        if(event.target === dom.documentsModal){
          closeDocumentsModal();
        }
      }
    );

    dom.documentsBody.addEventListener(
      "click",
      event => {
        const button =
          event.target.closest("button");

        if(!button) return;

        const viewId =
          button.getAttribute("data-view-doc");

        if(viewId){
          viewDocument(viewId);
          return;
        }

        const uploadType =
          button.getAttribute("data-upload-type");

        if(uploadType){
          chooseDocumentFile(uploadType);
          return;
        }

        const deleteId =
          button.getAttribute("data-delete-doc");

        if(deleteId){
          deleteDocument(deleteId);
        }
      }
    );

    dom.documentFileInput.addEventListener(
      "change",
      () => {
        const file =
          dom.documentFileInput.files?.[0];

        if(file){
          uploadDocumentFile(file);
        }
      }
    );

    dom.btnDeniedHome.addEventListener(
      "click",
      () => location.replace("/home")
    );

    dom.btnDeniedLogout.addEventListener(
      "click",
      async () => {
        try{
          await supabase.auth.signOut();
        }finally{
          location.replace("/");
        }
      }
    );

    document.addEventListener(
      "keydown",
      event => {
        if(
          event.key === "Escape" &&
          dom.documentsModal.classList.contains("show")
        ){
          closeDocumentsModal();
        }
      }
    );
  }

  try{
    bindEvents();
    renderTableStructure();
    renderTable();

    const allowed =
      await ensureAccess();

    if(!allowed){
      return;
    }

    await fetchRows();

  }catch(error){
    console.error(error);

    setStatus(
      error?.message || String(error),
      "err"
    );
  }
})();
</script>
</body>
</html>
