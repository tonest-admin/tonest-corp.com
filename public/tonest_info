  function applyFilters(options = {}){
    const renderStructure =
      options.renderStructure !== false;

    state.filteredRows =
      state.rows.filter(row => {
        if(
          row.pk_id &&
          state.deletedIds.has(row.pk_id)
        ){
          return false;
        }

        if(
          !dom.toggleIncludeResigned.checked &&
          isResigned(row)
        ){
          return false;
        }

        if(
          dom.toggleOnlyChanged.checked &&
          !row.__dirty
        ){
          return false;
        }

        for(
          const [key,expression]
          of Object.entries(state.filters)
        ){
          if(!normalizeText(expression)) continue;

          if(
            !matchFilter(
              getRowValue(row,key),
              expression
            )
          ){
            return false;
          }
        }

        return true;
      });

    if(renderStructure){
      renderTableStructure();
    }

    renderTable();
    updatePills();

    if(!state.rows.length){
      setStatus("데이터가 없습니다.","warn");
    }else if(state.filteredRows.length !== state.rows.length){
      setStatus(`필터 결과 ${state.filteredRows.length}건`,"ok");
    }else{
      setStatus(`전체 ${state.rows.length}건 로드 완료`,"ok");
    }
  }

  function addRow(){
    state.rows.unshift(blankRow());
    applyFilters();
    setStatus("신규 행을 추가했습니다.","warn");
  }

  function deleteRow(id){
    const row = findRowById(id);
    if(!row) return;

    const label =
      normalizeText(row.person_name) ||
      normalizeText(row.coupang_id) ||
      String(id);

    if(
      !confirm(
        `삭제 대상으로 표시할까요?\n전체 저장을 눌러야 실제 반영됩니다.\n\n대상: ${label}`
      )
    ){
      return;
    }

    if(row.__isNew){
      state.rows =
        state.rows.filter(
          item => String(rowId(item)) !== String(id)
        );
    }else if(row.pk_id){
      state.deletedIds.add(row.pk_id);
      row.__dirty = true;
    }

    applyFilters();
    setStatus(
      "삭제 대상으로 표시했습니다. 전체 저장 시 반영됩니다.",
      "warn"
    );
  }

  async function loadDocumentData(){
    const [
      typesResult,
      documentsResult
    ] = await Promise.all([
      supabase
        .from("tonest_document_types")
        .select("code,label,group_code,required_scope,sort_order,is_active")
        .eq("is_active",true)
        .order("sort_order",{ascending:true}),

      supabase
        .from("tonest_info_documents")
        .select(
          "id,tonest_info_id,document_type,document_label,storage_path,original_filename,mime_type,file_size,effective_date,expires_at,is_current,version_no,memo,uploaded_by,created_at,updated_at"
        )
        .order("created_at",{ascending:false})
    ]);

    if(typesResult.error) throw typesResult.error;
    if(documentsResult.error) throw documentsResult.error;

    state.documentTypes =
      Array.isArray(typesResult.data)
        ? typesResult.data
        : [];

    state.documents =
      Array.isArray(documentsResult.data)
        ? documentsResult.data
        : [];
  }

  async function fetchRows(){
    try{
      setLoading(true,"데이터 불러오는 중...");
      state.deletedIds.clear();

      const result =
        await infoApi(
          "/api/info",
          {method:"GET"}
        );

      state.role =
        result.role || state.role;

      dom.roleBadge.textContent =
        roleLabel(state.role);

      state.rows =
        (
          Array.isArray(result.rows)
            ? result.rows
            : []
        ).map(normalizeLoadedRow);

      try{
        await loadDocumentData();
      }catch(docError){
        console.error(
          "document load failed",
          docError
        );

        state.documentTypes = [];
        state.documents = [];
      }

      applyFilters();

    }catch(error){
      console.error(error);

      state.rows = [];
      state.filteredRows = [];

      renderTableStructure();
      renderTable();
      updatePills();

      setStatus(
        "불러오기 실패: " +
        (error?.message || String(error)),
        "err"
      );

    }finally{
      setLoading(false);
    }
  }

  async function saveAll(){
    try{
      setLoading(true,"저장 중...");

      const deleteIds =
        Array.from(state.deletedIds)
          .filter(Boolean);

      const dirtyRows =
        state.rows.filter(row =>
          row.__dirty &&
          !(
            row.pk_id &&
            state.deletedIds.has(row.pk_id)
          )
        );

      const updates =
        dirtyRows
          .filter(row =>
            !row.__isNew &&
            row.pk_id != null
          )
          .map(cleanPayload);

      const inserts =
        dirtyRows
          .filter(row =>
            row.__isNew &&
            hasAnyValue(row)
          )
          .map(cleanPayload)
          .map(row => {
            delete row.pk_id;
            return row;
          });

      if(
        !deleteIds.length &&
        !updates.length &&
        !inserts.length
      ){
        setStatus(
          "저장할 변경사항이 없습니다.",
          "warn"
        );
        return;
      }

      const result =
        await infoApi(
          "/api/info/save-all",
          {
            method:"POST",
            body:JSON.stringify({
              deleteIds,
              updates,
              inserts
            })
          }
        );

      await fetchRows();

      setStatus(
        `저장 완료: 삭제 ${result.deleted || 0} / 수정 ${result.updated || 0} / 신규 ${result.inserted || 0}`,
        "ok"
      );

    }catch(error){
      console.error(error);

      setStatus(
        "저장 실패: " +
        (error?.message || String(error)),
        "err"
      );

    }finally{
      setLoading(false);
    }
  }

