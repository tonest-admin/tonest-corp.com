    {key:"business_name", label:"사업자 상호", width:150},
    {key:"business_registration_number", label:"사업자 번호", className:"code", width:150},
    {key:"hire_date", label:"입사일", type:"date", className:"center code", width:130},
    {key:"safety_health_education_completion_date", label:"안전보건교육 수료일", type:"date", className:"center code", width:160},
    {key:"emergency_contact_phone", label:"비상 연락처", className:"code", width:150},
    {key:"emergency_contact_relationship", label:"관계", className:"center", width:110},
    {key:"fixed_commission_amount", label:"고정 수수료", className:"right code", width:120},
    {key:"fixed_unit_price", label:"고정 단가", className:"right code", width:120},
    {key:"dragon_car_commission", label:"용차 수수료", className:"right code", width:120},
    {key:"employment_accident_insurance", label:"고용산재", type:"select", options:["","O","X"], className:"center", width:90},
    {key:"summer_vest_size", label:"조끼(하계)", className:"center", width:105},
    {key:"winter_fleece_size", label:"후리스(동계)", className:"center", width:105}
  ];

  const FILTER_PLACEHOLDERS = {
    person_name:"이름 / !이우람",
    contact_phone:"연락처",
    position_title:"직책",
    resignation_scheduled_date:"YYYY-MM-DD",
    camp_code:"camp",
    wave:"주간 / 야간 / !주간",
    coupang_id:"ID",
    vehicle_plate_number:"차량 번호 / !배",
    resident_registration_number:"주민번호",
    transport_qualification_number:"자격증번호",
    sub_account_info:"서브 계정",
    payroll_bank_name:"은행",
    payroll_account_number:"계좌",
    business_name:"사업자 상호",
    business_registration_number:"사업자 번호",
    hire_date:"2026 / !2025",
    safety_health_education_completion_date:"2026 / !2025",
    emergency_contact_phone:"비상 연락처",
    emergency_contact_relationship:"관계",
    fixed_commission_amount:"고정 수수료",
    fixed_unit_price:"고정 단가",
    dragon_car_commission:"용차 수수료 / !8%",
    employment_accident_insurance:"O / X / !X",
    summer_vest_size:"조끼 사이즈",
    winter_fleece_size:"후리스 사이즈"
  };

  const $ = selector => document.querySelector(selector);

  const dom = {
    tableColgroup:$("#tableColgroup"),
    tableHead:$("#tableHead"),
    sheetBody:$("#sheetBody"),
    hiddenColumnBar:$("#hiddenColumnBar"),
    roleBadge:$("#roleBadge"),
    btnReload:$("#btnReload"),
    btnAddRow:$("#btnAddRow"),
    btnSaveAll:$("#btnSaveAll"),
    btnExportExcel:$("#btnExportExcel"),
    btnClearFilters:$("#btnClearFilters"),
    btnLogout:$("#btnLogout"),
    toggleIncludeResigned:$("#toggleIncludeResigned"),
    toggleOnlyChanged:$("#toggleOnlyChanged"),
    pillState:$("#pillState"),
    pillRows:$("#pillRows"),
    pillDirty:$("#pillDirty"),
    statusText:$("#statusText"),
    documentsModal:$("#documentsModal"),
    documentsModalTitle:$("#documentsModalTitle"),
    documentsModalSubtitle:$("#documentsModalSubtitle"),
    documentsSummary:$("#documentsSummary"),
    documentsBody:$("#documentsBody"),
    btnDocumentsClose:$("#btnDocumentsClose"),
    documentFileInput:$("#documentFileInput"),
    accessDenied:$("#accessDenied"),
    accessDeniedEmail:$("#accessDeniedEmail"),
    btnDeniedHome:$("#btnDeniedHome"),
    btnDeniedLogout:$("#btnDeniedLogout")
  };

  const state = {
    rows:[],
    filteredRows:[],
    loading:false,
    session:null,
    profile:null,
    role:"",
    deletedIds:new Set(),
    tempSeq:0,
    filters:{},
    hiddenColumns:new Set(),
    documentTypes:[],
    documents:[],
    documentPersonId:null,
    documentUploadType:"",
    documentBusy:false
  };

  const roleLabel = role => ({
    super_admin:"최고관리자",
    admin:"관리자",
    team_leader:"팀장",
    driver:"기사"
  })[role] || role || "-";

  const normalizeText = value =>
    String(value ?? "")
      .replace(/\s+/g," ")
      .trim();

  const normalizeLower = value =>
    normalizeText(value)
      .toLowerCase();

  const escapeHtml = value =>
    String(value ?? "")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#39;");

  function formatDate(value){
    const text = normalizeText(value);
    return text ? text.slice(0,10) : "";
  }

  function loadHiddenColumns(){
    try{
      const arr = JSON.parse(
        localStorage.getItem(HIDDEN_COLUMNS_KEY) || "[]"
      );

      state.hiddenColumns = new Set(
        Array.isArray(arr)
          ? arr.filter(key =>
              COLUMN_CONFIG.some(col => col.key === key)
            )
          : []
      );
    }catch{
      state.hiddenColumns = new Set();
    }
  }

  function saveHiddenColumns(){
    try{
      localStorage.setItem(
        HIDDEN_COLUMNS_KEY,
        JSON.stringify(Array.from(state.hiddenColumns))
      );
    }catch{}
  }

  loadHiddenColumns();

  function normalizeLoadedRow(row){
    const out = {...(row || {})};

    for(const key of DATA_COLUMNS){
      out[key] = out[key] == null ? "" : String(out[key]);
    }

    out.is_resigned = String(row?.is_resigned === true);
    out.is_two_person_team = String(row?.is_two_person_team === true);
    out.hire_date = formatDate(out.hire_date);
    out.resignation_scheduled_date = formatDate(out.resignation_scheduled_date);
    out.safety_health_education_completion_date =
      formatDate(out.safety_health_education_completion_date);

    out.__dirty = false;
    out.__isNew = false;
    out.__dirtyFields = {};

    return out;
  }

  function blankRow(){
    const row = {
      __temp_id:"new_" + (++state.tempSeq),
      __isNew:true,
      __dirty:true,
      __dirtyFields:{},
      is_resigned:"false",
      is_two_person_team:"false"
    };

    for(const key of DATA_COLUMNS){
      if(!(key in row)) row[key] = "";
    }

    return row;
  }

  function rowId(row){
    return row.pk_id ?? row.__temp_id;
  }

  function findRowById(id){
    return state.rows.find(
      row => String(rowId(row)) === String(id)
    );
  }

  function isResigned(row){
    return String(row?.is_resigned).toLowerCase() === "true";
  }

  function isVehicleWarn(row){
    return /[배아바사자]/.test(
      normalizeText(row?.vehicle_plate_number)
    );
  }

  function hasAnyValue(row){
    const ignore = new Set(["is_resigned","is_two_person_team"]);

    return DATA_COLUMNS.some(
      key =>
        !ignore.has(key) &&
        normalizeText(row[key])
    );
  }

  function valueForSave(key, value){
    if(key === "is_resigned" || key === "is_two_person_team"){
      return String(value).toLowerCase() === "true";
    }

    const text = normalizeText(value);
    return text || null;
  }

  function cleanPayload(row){
    const out = {};

    for(const key of DATA_COLUMNS){
      out[key] = valueForSave(key,row[key]);
    }

    if(row.pk_id != null){
      out.pk_id = row.pk_id;
    }

    return out;
  }

  function setStatus(text,tone){
    dom.statusText.textContent = text || "";
    dom.pillState.className = "pill";

    if(tone === "err") dom.pillState.classList.add("err");
    else if(tone === "warn") dom.pillState.classList.add("warn");
    else dom.pillState.classList.add("ok");

    dom.pillState.textContent =
      tone === "err" ? "ERROR" :
      tone === "warn" ? "WAIT" :
      "READY";
  }

  function setLoading(on,text){
    state.loading = !!on;

    [
      dom.btnReload,
      dom.btnAddRow,
      dom.btnSaveAll,
      dom.btnExportExcel,
      dom.btnClearFilters
    ].forEach(button => {
      if(button) button.disabled = !!on;
    });

    if(on){
      setStatus(text || "처리 중...","warn");
    }
  }

  function updatePills(){
    const dirtyCount =
      state.rows.filter(row => row.__dirty).length +
      state.deletedIds.size;

    dom.pillRows.textContent =
      "행 " + state.filteredRows.length;

    dom.pillDirty.textContent =
      "변경 " + dirtyCount;
  }

  function visibleColumns(){
    return COLUMN_CONFIG.filter(
      col => !state.hiddenColumns.has(col.key)
    );
  }

  function documentCountForPerson(personId){
    const id = Number(personId);
    if(!id) return 0;

    return new Set(
      state.documents
        .filter(doc =>
          Number(doc.tonest_info_id) === id &&
          doc.is_current !== false
        )
        .map(doc => doc.document_type)
    ).size;
  }

  function documentsForType(personId,typeCode){
    const id = Number(personId);

    return state.documents
      .filter(doc =>
        Number(doc.tonest_info_id) === id &&
        doc.document_type === typeCode
      )
      .sort((a,b) =>
        Number(b.version_no || 0) -
        Number(a.version_no || 0)
      );
  }

  function currentDocumentForType(personId,typeCode){
    return documentsForType(personId,typeCode)
      .find(doc => doc.is_current !== false) || null;
  }

  function documentGroupLabel(code){
    return ({
      basic:"기본 제출서류",
      contract:"계약서",
      plate:"배번호 서류",
      onboarding:"신입 교육"
    })[code] || "기타 서류";
  }

  function documentScopeLabel(scope){
    return ({
      all:"기본 관리",
      new_plate:"새 배번호 발급 대상",
      new_hire:"신입 대상"
    })[scope] || scope || "";
  }

  function formatFileSize(bytes){
    const n = Number(bytes || 0);

    if(!Number.isFinite(n) || n <= 0) return "";
    if(n < 1024) return n + " B";
    if(n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";

    return (
      n / (1024 * 1024)
    ).toFixed(n >= 10 * 1024 * 1024 ? 0 : 1) + " MB";
  }

  function safeFileExtension(file){
    const byMime = {
      "image/jpeg":"jpg",
      "image/png":"png",
      "image/webp":"webp",
      "image/heic":"heic",
      "image/heif":"heif",
      "application/pdf":"pdf"
    };

    if(byMime[file?.type]){
      return byMime[file.type];
    }

    const match = String(file?.name || "")
      .toLowerCase()
      .match(/\.([a-z0-9]{2,5})$/);

    return match ? match[1] : "bin";
  }

  async function createSupabase(){
    const response = await fetch(
      AUTH_BASE + "/auth-config",
      {cache:"no-store"}
    );

    const cfg = await response.json().catch(() => ({}));

    if(
      !response.ok ||
      !cfg.supabaseUrl ||
      !cfg.supabaseKey
    ){
      throw new Error(
        cfg.message ||
        "로그인 설정을 불러오지 못했습니다."
      );
    }

    return window.supabase.createClient(
      cfg.supabaseUrl,
      cfg.supabaseKey,
      {
        auth:{
          persistSession:true,
          storage:sessionStorage,
          autoRefreshToken:true,
          detectSessionInUrl:true
        }
      }
    );
  }

  const supabase = await createSupabase();

  async function ensureAccess(){
    const {
      data:{session}
    } = await supabase.auth.getSession();

    if(!session?.user?.id){
      location.replace("/?next=%2Ftonest_info");
      return false;
    }

    state.session = session;

    const {
      data:profile,
      error
    } = await supabase
      .from("profiles")
      .select("user_id,email,display_name,role,status")
      .eq("user_id",session.user.id)
      .maybeSingle();

    if(error) throw error;

    state.profile = profile;
    state.role = profile?.role || "";

    if(
      !profile ||
      profile.status !== "active" ||
      !["super_admin","admin"].includes(profile.role)
    ){
      dom.accessDenied.classList.add("show");
      dom.accessDeniedEmail.textContent =
        "현재 로그인: " +
        (profile?.email || session.user.email || "-");

      return false;
    }

    dom.roleBadge.textContent =
      roleLabel(profile.role);

    return true;
  }

  async function infoApi(path,options = {}){
    const token = state.session?.access_token || "";

    if(!token){
      throw new Error("로그인이 필요합니다.");
    }

    const headers =
      new Headers(options.headers || {});

    headers.set(
      "Authorization",
      "Bearer " + token
    );

    if(options.body && !headers.has("Content-Type")){
      headers.set(
        "Content-Type",
        "application/json"
      );
    }

    const response = await fetch(
      INFO_API_BASE + path,
      {
        ...options,
        headers
      }
    );

    const data =
      await response.json().catch(() => ({}));

    if(!response.ok){
      throw new Error(
        data.message || "요청 실패"
      );
    }

    return data;
  }

  function getRowValue(row,key){
    if(key === "documents"){
      return row.pk_id
        ? documentCountForPerson(row.pk_id)
        : 0;
    }

    return row?.[key] ?? "";
  }

  function matchFilter(value,expression){
    const haystack =
      normalizeLower(value);

    const tokens =
      normalizeText(expression)
        .split(/\s+/)
        .filter(Boolean);

    if(!tokens.length) return true;

    for(const token of tokens){
      if(token.startsWith("!")){
        const needle =
          normalizeLower(token.slice(1));

        if(
          needle &&
          haystack.includes(needle)
        ){
          return false;
        }
      }else{
        const needle =
          normalizeLower(token);

        if(
          needle &&
          !haystack.includes(needle)
        ){
          return false;
        }
      }
    }

    return true;
  }

  function renderHiddenColumnBar(){
    const hidden =
      COLUMN_CONFIG.filter(
        col => state.hiddenColumns.has(col.key)
      );

    if(!hidden.length){
      dom.hiddenColumnBar.className =
        "hiddenColumnBar empty";
      dom.hiddenColumnBar.innerHTML = "";
      return;
    }

    dom.hiddenColumnBar.className =
      "hiddenColumnBar";

    dom.hiddenColumnBar.innerHTML = `
      <span class="hiddenLabel">숨김 열</span>
      ${hidden.map(col => `
        <button
          class="hiddenChip"
          type="button"
          data-show-col="${escapeHtml(col.key)}"
        >
          ${escapeHtml(col.label)}
        </button>
      `).join("")}

      <button
        class="hiddenChip all"
        type="button"
        data-show-all-cols
      >
        전체 열 복원
      </button>
    `;
  }

  function renderTableStructure(){
    const columns = visibleColumns();

    dom.tableColgroup.innerHTML = [
      ...columns.map(col => `
        <col style="width:${Number(col.width || 120)}px">
      `),
      `<col style="width:72px">`
    ].join("");

    dom.tableHead.innerHTML = `
      <tr>
        ${columns.map(col => `
          <th data-head-col="${escapeHtml(col.key)}">
            <div class="thInner">
              <span class="thLabel">${escapeHtml(col.label)}</span>
              <button
                class="hideColBtn"
                type="button"
                data-hide-col="${escapeHtml(col.key)}"
                title="${escapeHtml(col.label)} 열 접기"
              >
                접기
              </button>
            </div>
          </th>
        `).join("")}

        <th>
          <div class="thInner">
            <span class="thLabel">삭제</span>
          </div>
        </th>
      </tr>

      <tr class="filterRow">
        ${columns.map(col => {
          if(col.key === "pk_id" || col.key === "documents"){
            return "<th></th>";
          }

          const value =
            state.filters[col.key] || "";

          return `
            <th>
              <input
                class="filterInput"
                data-filter="${escapeHtml(col.key)}"
                value="${escapeHtml(value)}"
                placeholder="${escapeHtml(
                  FILTER_PLACEHOLDERS[col.key] || col.label
                )}"
              >
            </th>
          `;
        }).join("")}
        <th></th>
      </tr>
    `;

    renderHiddenColumnBar();
  }

  function markRowDirty(row,key,value){
    row[key] = value;
    row.__dirty = true;
    row.__dirtyFields[key] = true;
    updatePills();
  }

  function buildDataCell(row,col){
    const id = rowId(row);
    const value = getRowValue(row,col.key);
    const classes = [];

