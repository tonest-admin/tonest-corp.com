  function exportExcel(){
    const rows =
      state.filteredRows.filter(
        row =>
          !(
            row.pk_id &&
            state.deletedIds.has(row.pk_id)
          )
      );

    if(!rows.length){
      alert("내보낼 데이터가 없습니다.");
      return;
    }

    const columns = visibleColumns();

    const aoa = [
      columns.map(col => col.label),
      ...rows.map(row =>
        columns.map(col =>
          col.key === "pk_id"
            ? (row.pk_id ?? "")
            : getRowValue(row,col.key)
        )
      )
    ];

    const now = new Date();

    const stamp = [
      now.getFullYear(),
      String(now.getMonth()+1).padStart(2,"0"),
      String(now.getDate()).padStart(2,"0"),
      "_",
      String(now.getHours()).padStart(2,"0"),
      String(now.getMinutes()).padStart(2,"0")
    ].join("");

    const ws =
      XLSX.utils.aoa_to_sheet(aoa);

    ws["!cols"] =
      columns.map(col => ({
        wch:Math.max(
          10,
          Math.min(
            28,
            Math.round((col.width || 120) / 7)
          )
        )
      }));

    const wb =
      XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
      wb,
      ws,
      "tonest_info"
    );

    XLSX.writeFile(
      wb,
      `tonest_info_${stamp}.xlsx`
    );
  }

