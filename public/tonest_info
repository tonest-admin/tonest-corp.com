<script>
(async function(){
  "use strict";

  const AUTH_BASE = location.origin;
  const INFO_API_BASE = "https://tonest-info.tonest-admin.workers.dev";
  const DOCUMENT_BUCKET = "tonest-info-documents";
  const DOCUMENT_MAX_BYTES = 50 * 1024 * 1024;
  const HIDDEN_COLUMNS_KEY = "tonest_info_hidden_columns_v3";

  /*
   * DB 저장 컬럼 = maroowell_info와 동일
   */
  const DATA_COLUMNS = [
    "person_name",
    "contact_phone",
    "position_title",
    "camp_code",
    "wave",
    "coupang_id",
    "vehicle_plate_number",
    "resident_registration_number",
    "transport_qualification_number",
