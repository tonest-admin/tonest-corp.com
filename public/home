<style>
:root{--bg:#f3f8f7;--card:#fff;--line:#dce7e5;--line2:#cbd8d6;--text:#172124;--muted:#596d6a;--primary:#16a7a4;--primary2:#118b89;--danger:#dc2626;--shadow:0 12px 32px rgba(15,45,47,.08);--font:"Pretendard Variable","Pretendard","Noto Sans KR",system-ui,-apple-system,"Segoe UI",sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;font-family:var(--font);color:var(--text);background:radial-gradient(circle at 12% 0%,rgba(22,167,164,.07),transparent 30%),linear-gradient(180deg,#fff 0%,var(--bg) 76%,#edf5f3 100%);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}body{min-width:0;overflow-x:hidden}button,a{font:inherit}.wrap{width:100%;max-width:none;margin:0;padding:12px 18px 36px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.top{width:100%;display:flex;align-items:center;gap:10px;padding:10px 14px;margin-bottom:12px;position:sticky;top:6px;z-index:20}.menuLogoBtn{width:42px;height:42px;flex:0 0 42px;padding:0;border:0;background:#fff;border-radius:11px;display:grid;place-items:center;cursor:pointer}.menuLogoBtn:hover{background:#eaf8f6}.logo{width:36px;height:36px;object-fit:contain;display:block}.brandBlock{display:flex;flex-direction:column;justify-content:center;min-width:0}.brand{font-size:20px;font-weight:900;letter-spacing:-.03em;line-height:1.05}.sub{margin-top:3px;color:var(--muted);font-size:10.5px;font-weight:750;letter-spacing:.02em}.grow{flex:1}.pill{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 12px;border:1px solid var(--line2);border-radius:999px;background:#fff;color:#425956;font-size:11px;font-weight:800;white-space:nowrap}.btn{height:36px;padding:0 13px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:#334345;font-weight:800;cursor:pointer}.btn.danger{color:var(--danger);border-color:#fecaca}.hero{width:100%;padding:24px 22px;margin-bottom:12px;background:linear-gradient(135deg,#fff 0%,#f3fbfa 100%)}.heroKicker{color:var(--primary2);font-size:11px;font-weight:900;letter-spacing:.13em}.hero h1{margin:7px 0 7px;font-size:30px;line-height:1.1;font-weight:950;letter-spacing:-.045em}.hero p{margin:0;color:var(--muted);font-size:13px;line-height:1.6;font-weight:700}.grid{width:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.menuCard{min-width:0;display:block;text-decoration:none;color:inherit;padding:20px;transition:transform .15s,border-color .15s,box-shadow .15s}.menuCard:hover{transform:translateY(-1px);border-color:#9fd8d4;box-shadow:0 14px 34px rgba(15,45,47,.10)}.menuIcon{width:42px;height:42px;border-radius:13px;background:#e9f8f6;color:var(--primary2);display:grid;place-items:center;font-size:18px;font-weight:950}.menuIcon.live{background:#eefbf9;color:#0f766e}.menuIcon.camp{font-size:15px}.menuIcon.route{font-size:13px}.menuIcon.admin{background:#fff9e8;color:#a16207}.menuTitle{margin-top:13px;font-size:17px;font-weight:900;letter-spacing:-.025em}.menuDesc{margin-top:5px;color:var(--muted);font-size:11.5px;line-height:1.55;font-weight:700}.menuMeta{margin-top:12px;display:flex;gap:6px;flex-wrap:wrap}.badge{display:inline-flex;align-items:center;min-height:22px;padding:0 8px;border:1px solid #d9e6e4;border-radius:999px;background:#f8fbfa;color:#536966;font-size:9px;font-weight:850}.badge.api{border-color:#bfe4e0;background:#eaf8f6;color:#118b89}.badge.admin{border-color:#fde68a;background:#fff9e8;color:#a16207}.badge.ok{border-color:#86efac;background:#f0fdf4;color:#15803d}.badge.warn{border-color:#fed7aa;background:#fff7ed;color:#c2410c}.badge.err{border-color:#fecaca;background:#fff1f2;color:#b42318}.status{min-height:18px;margin-top:13px;padding:0 3px;color:#657875;font-size:11px;font-weight:700}.status.err{color:#dc2626}[hidden]{display:none!important}@media(max-width:1180px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:850px){.wrap{padding:8px 10px 30px}.top{flex-wrap:wrap}.grow{display:none}.pill{order:3;width:100%}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.grid{grid-template-columns:1fr}.hero{padding:20px 18px}.hero h1{font-size:25px}}
</style>
</head>
<body>
<div class="wrap">
<header class="card top"><button id="tnBoardMenuToggle" class="menuLogoBtn" type="button" aria-label="TO:NEST 메뉴 열기"><img class="logo" src="/favicon.ico?v=15" alt="TO:NEST"></button><div class="brandBlock"><div class="brand">TO:NEST</div><div class="sub">OPERATIONS</div></div><div class="grow"></div><span id="userPill" class="pill">권한 확인 중</span><button id="logoutBtn" class="btn danger" type="button">로그아웃</button></header>
<section class="card hero"><div class="heroKicker">TO:NEST OPERATIONS</div><h1 id="welcomeTitle">Home</h1><p>투네스트 운영 시스템입니다.</p></section>
<section class="grid">
  <a class="card menuCard" href="/tonest_info"><div class="menuIcon">i</div><div class="menuTitle">TO:NEST 정보</div><div class="menuDesc">인사 · 운영 기본정보를 조회하고 관리합니다.</div></a>
  <a id="realtimeCard" class="card menuCard" href="/realtime"><div class="menuIcon live">LIVE</div><div class="menuTitle">실시간 현황</div><div class="menuDesc">현재 캠프별 · 기사별 배송, 반품, 프레시백 진행 상황을 확인합니다.</div><div class="menuMeta"><span id="metaCollectorBadge" class="badge">수집 상태 확인 중</span><span class="badge">주간 · 야간</span></div></a>
  <a class="card menuCard" href="/coupang_camp"><div class="menuIcon camp">CP</div><div class="menuTitle">쿠팡 캠프 조회</div><div class="menuDesc">MAROOWELL 공용 API의 캠프 · 본캠프 · 수신 SH · 채번 링크를 조회하고 관리합니다.</div><div class="menuMeta"><span class="badge api">MAROOWELL API</span><span class="badge">공용 데이터</span></div></a>
  <a class="card menuCard" href="/route_info"><div class="menuIcon route">INFO</div><div class="menuTitle">라우트 정보</div><div class="menuDesc">TO:NEST 라우트 · 단가 · 입차지 · 서서브 정보를 관리합니다.</div></a>
  <a class="card menuCard" href="/coupang_route_map"><div class="menuIcon route">MAP</div><div class="menuTitle">쿠팡 라우트 지도</div><div class="menuDesc">라우트 폴리곤과 입차지 위치를 지도에서 확인하고 등록합니다.</div></a>
  <a id="adminAccessCard" class="card menuCard" href="/admin_access" hidden><div class="menuIcon admin">A</div><div class="menuTitle">계정 · 권한 관리</div><div class="menuDesc">가입 승인 · 역할 변경 · 이메일 강제 인증을 관리합니다.</div><div class="menuMeta"><span class="badge admin">최고관리자</span></div></a>
</section>
<div id="status" class="status"></div>
</div>
<script>
(()=>{
const AUTH_BASE=location.origin,statusEl=document.getElementById("status"),userPill=document.getElementById("userPill"),welcomeTitle=document.getElementById("welcomeTitle"),logoutBtn=document.getElementById("logoutBtn"),adminAccessCard=document.getElementById("adminAccessCard"),metaCollectorBadge=document.getElementById("metaCollectorBadge");let client=null;
const roleLabel=role=>({super_admin:"최고관리자",admin:"관리자",team_leader:"팀장",driver:"기사"})[role]||role||"-";
function status(message,isError=false){statusEl.textContent=message||"";statusEl.className="status"+(isError?" err":"")}
async function loadCollector(role){if(!["super_admin","admin","team_leader"].includes(role)){metaCollectorBadge.textContent="팀장 이상 조회";return}try{const{data,error}=await client.rpc("tn_meta_collector_state");if(error)throw error;const s=Array.isArray(data)?data[0]:data;if(s?.paused){metaCollectorBadge.className="badge warn";metaCollectorBadge.textContent="자동수집 정지"}else if(s?.status==="active"){metaCollectorBadge.className="badge ok";metaCollectorBadge.textContent="자동수집 정상"}else{metaCollectorBadge.className="badge err";metaCollectorBadge.textContent="META 로그인 필요"}}catch(e){metaCollectorBadge.className="badge err";metaCollectorBadge.textContent="수집 상태 오류"}}
async function init(){const cfgRes=await fetch(AUTH_BASE+"/auth-config",{cache:"no-store"}),cfg=await cfgRes.json().catch(()=>({}));if(!cfgRes.ok||!cfg.supabaseUrl||!cfg.supabaseKey)throw new Error(cfg.message||"로그인 설정을 불러오지 못했습니다.");client=window.supabase.createClient(cfg.supabaseUrl,cfg.supabaseKey,{auth:{persistSession:true,storage:sessionStorage,autoRefreshToken:true,detectSessionInUrl:true}});const{data:{session}}=await client.auth.getSession();if(!session?.user?.id){location.replace("/?next=%2Fhome");return}const{data:profile,error}=await client.from("profiles").select("display_name,email,role,status").eq("user_id",session.user.id).maybeSingle();if(error)throw error;if(!profile||profile.status!=="active"){await client.auth.signOut();location.replace("/");return}userPill.textContent=`${profile.display_name||profile.email||"사용자"} · ${roleLabel(profile.role)}`;welcomeTitle.textContent=`${profile.display_name||"사용자"}님 안녕하세요.`;adminAccessCard.hidden=profile.role!=="super_admin";await loadCollector(profile.role);status("TO:NEST 운영 시스템에 연결되었습니다.")}
logoutBtn.addEventListener("click",async()=>{try{await client?.auth?.signOut()}finally{location.replace("/")}});init().catch(error=>{console.error(error);status(error?.message||String(error),true)})
})();
</script>
</body>
