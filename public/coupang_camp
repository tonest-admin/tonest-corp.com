<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="referrer" content="origin">

  <title>쿠팡 캠프 조회 | TO:NEST</title>

  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=9">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=9">

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
  <script src="/board-menu.js?v=4" defer></script>

  <style>
    :root{
      --bg:#f3f8f7;
      --card:#fff;
      --line:#d9e6e4;
      --line2:#cbd8d6;
      --text:#172124;
      --muted:#566b69;
      --primary:#16a7a4;
      --primary2:#118b89;
      --primary-soft:#eaf8f6;
      --green:#15803d;
      --green-soft:#effcf3;
      --red:#dc2626;
      --red-soft:#fff2f2;
      --amber:#a16207;
      --amber-soft:#fff9e8;
      --blue:#2563eb;
      --blue-soft:#eff6ff;
      --shadow:0 12px 32px rgba(15,45,47,.075);
      --font:"Pretendard Variable","Pretendard","Noto Sans KR",system-ui,-apple-system,"Segoe UI",sans-serif;
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      width:100%;
      height:100%;
      font-family:var(--font);
      color:var(--text);
      background:
        radial-gradient(circle at 10% 0%,rgba(22,167,164,.06),transparent 28%),
        linear-gradient(180deg,#fff 0%,var(--bg) 70%,#edf5f3 100%);
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
    }

    body{
      overflow:hidden;
    }

    button,input,select,textarea{
      font:inherit;
    }

    button{cursor:pointer}

    .app{
      width:100%;
      height:100dvh;
      display:grid;
      grid-template-rows:auto auto minmax(0,1fr) auto;
      gap:8px;
      padding:8px;
    }

    .panel{
      width:100%;
      border:1px solid var(--line);
      border-radius:17px;
      background:rgba(255,255,255,.97);
      box-shadow:var(--shadow);
    }

    .topbar{
      min-height:62px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 12px;
    }

    .menuBtn{
      width:42px;
      height:42px;
      flex:0 0 42px;
      display:grid;
      place-items:center;
      border:0;
      border-radius:12px;
      background:#fff;
    }

    .menuBtn:hover{
      background:var(--primary-soft);
    }

    .menuBtn img{
      width:36px;
      height:36px;
      display:block;
      object-fit:contain;
    }

    .titleBox{
      min-width:0;
      display:flex;
      flex-direction:column;
      gap:2px;
    }

    .title{
      font-size:20px;
      line-height:1.05;
      font-weight:900;
      letter-spacing:-.035em;
    }

    .subtitle{
      color:var(--muted);
      font-size:11px;
      line-height:1.35;
      font-weight:700;
    }

    .spacer{flex:1}

    .accessPill{
      min-height:34px;
      display:inline-flex;
      align-items:center;
      padding:0 11px;
      border:1px solid var(--line2);
      border-radius:999px;
      background:#f8fbfa;
      color:#425957;
      font-size:11px;
      font-weight:800;
      white-space:nowrap;
    }

    .btn{
      min-height:36px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:0 13px;
      border:1px solid #c8d6d4;
      border-radius:11px;
      background:#fff;
      color:#304542;
      font-size:11.5px;
      font-weight:850;
      white-space:nowrap;
    }

    .btn:hover{
      border-color:#8fcfc9;
      background:#f8fdfc;
    }

    .btn.primary{
      color:#fff;
      border-color:var(--primary);
      background:linear-gradient(180deg,#22b7b2,#16a7a4);
    }

    .btn.green{
      color:#fff;
      border-color:#16a34a;
      background:linear-gradient(180deg,#22c55e,#16a34a);
    }

    .btn.red{
      color:var(--red);
      border-color:#fecaca;
      background:var(--red-soft);
    }

    .btn.blue{
      color:var(--blue);
      border-color:#bfdbfe;
      background:var(--blue-soft);
    }

    .btn:disabled{
      opacity:.45;
      cursor:not-allowed;
    }

    .toolbar{
      min-height:52px;
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      padding:8px 10px;
    }

    .toggle{
      min-height:34px;
      display:flex;
      align-items:center;
      gap:7px;
      padding:0 10px;
      border:1px solid var(--line2);
      border-radius:999px;
      background:#fff;
      color:#405552;
      font-size:11px;
      font-weight:800;
    }

    .toggle input{
      width:16px;
      height:16px;
      margin:0;
      accent-color:var(--primary);
    }

    .helper{
      color:var(--muted);
      font-size:10.5px;
      font-weight:700;
    }

    .sheetWrap{
      min-height:0;
      overflow:auto;
      border:1px solid var(--line);
      border-radius:17px;
      background:#eef5f3;
      box-shadow:var(--shadow);
    }

    .sheetInner{
      min-width:2240px;
    }

    table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      table-layout:fixed;
    }

    th,td{
      border-right:1px solid #d9e4e2;
      border-bottom:1px solid #d9e4e2;
    }

    th:first-child,
    td:first-child{
      border-left:1px solid #d9e4e2;
    }

    thead th{
      position:sticky;
      top:0;
      z-index:5;
      height:42px;
      padding:7px 6px;
      background:#e7f3f1;
      color:#24413e;
      text-align:center;
      font-size:11.5px;
      font-weight:900;
      white-space:nowrap;
    }

    thead tr.filterRow th{
      top:42px;
      z-index:4;
      height:43px;
      background:#f5faf9;
      padding:5px;
    }

    tbody td{
      padding:0;
      background:#fff;
      vertical-align:middle;
    }

    tbody tr:nth-child(even) td{
      background:#fbfefd;
    }

    tbody tr.newRow td{
      background:#effcf3 !important;
    }

    tbody tr.deleted td{
      opacity:.45;
      text-decoration:line-through;
    }

    .dirtyCell{
      background:#edf8f7 !important;
      box-shadow:inset 0 0 0 2px rgba(22,167,164,.55);
    }

    .cellInput,
    .cellSelect,
    .cellTextarea{
      width:100%;
      min-height:44px;
      border:0;
      outline:0;
      background:transparent;
      padding:8px 7px;
      color:#1d3330;
      font-size:12px;
      font-weight:700;
    }

    .cellTextarea{
      height:44px;
      resize:none;
      overflow:hidden;
      line-height:1.35;
    }

    .cellSelect{
      cursor:pointer;
    }

    .cellInput:disabled,
    .cellSelect:disabled,
    .cellTextarea:disabled{
      opacity:1;
      color:#435956;
      cursor:default;
    }

    .filterInput,
    .filterSelect{
      width:100%;
      height:32px;
      border:1px solid #c6d6d3;
      border-radius:9px;
      background:#fff;
      padding:0 8px;
      outline:0;
      color:#2e4542;
      font-size:10.5px;
      font-weight:700;
    }

    .filterInput:focus,
    .filterSelect:focus{
      border-color:#60beb7;
      box-shadow:0 0 0 2px rgba(22,167,164,.11);
    }

    .relationWrap{
      display:flex;
      flex-direction:column;
      min-height:44px;
    }

    .relationWrap select{
      min-height:29px;
      padding-top:4px;
      padding-bottom:2px;
    }

    .relationMeta{
      min-height:14px;
      padding:0 7px 4px;
      overflow:hidden;
      color:#6a7d7a;
      font-size:9px;
      font-weight:750;
      white-space:nowrap;
      text-overflow:ellipsis;
    }

    .relationMeta.direct{color:#2563eb}
    .relationMeta.inherited{color:#15803d}
    .relationMeta.unassigned{color:#a16207}

    .numberingCell{
      display:grid;
      grid-template-columns:minmax(0,1fr) 52px;
      min-height:44px;
    }

    .openBtn{
      border:0;
      border-left:1px solid #d9e4e2;
      background:#f8fbfa;
      color:var(--primary2);
      font-size:10px;
      font-weight:900;
    }

    .openBtn:disabled{
      color:#a2b0ae;
      cursor:default;
    }

    .campCell{
      display:grid;
      grid-template-columns:minmax(0,1fr) 46px;
      min-height:44px;
    }

    .qrBtn{
      border:0;
      border-left:1px solid #d9e4e2;
      background:#f8fbfa;
      color:var(--primary2);
      font-size:10px;
      font-weight:900;
    }

    .actionCell{
      padding:5px;
      text-align:center;
    }

    .deleteBtn{
      min-height:30px;
      padding:0 9px;
      border:1px solid #fecaca;
      border-radius:9px;
      background:#fff5f5;
      color:#dc2626;
      font-size:10px;
      font-weight:850;
    }

    .statusbar{
      min-height:42px;
      display:flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
    }

    .statusPill{
      min-height:28px;
      display:inline-flex;
      align-items:center;
      padding:0 10px;
      border:1px solid var(--line2);
      border-radius:999px;
      background:#f8fbfa;
      color:#506663;
      font-size:10px;
      font-weight:850;
      white-space:nowrap;
    }

    .statusPill.ok{
      color:var(--green);
      border-color:#bbf7d0;
      background:var(--green-soft);
    }

    .statusPill.warn{
      color:var(--amber);
      border-color:#fde68a;
      background:var(--amber-soft);
    }

    .statusText{
      min-width:0;
      overflow:hidden;
      color:#556966;
      font-size:10.5px;
      font-weight:750;
      white-space:nowrap;
      text-overflow:ellipsis;
    }

    .statusText.ok{color:var(--green)}
    .statusText.err{color:var(--red)}
    .statusText.warn{color:var(--amber)}

    .empty td{
      height:180px;
      background:#fff !important;
      color:#657976;
      text-align:center;
      font-size:12px;
      font-weight:700;
    }

    .modal{
      position:fixed;
      inset:0;
      z-index:99999;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:rgba(15,33,36,.48);
      backdrop-filter:blur(3px);
    }

    .modal.show{display:flex}

    .modalCard{
      width:min(520px,100%);
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:20px;
      background:#fff;
      box-shadow:0 28px 90px rgba(15,33,36,.28);
    }

    .modalHead,
    .modalActions{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      padding:13px 15px;
    }

    .modalHead{
      border-bottom:1px solid var(--line);
    }

    .modalActions{
      justify-content:flex-end;
      border-top:1px solid var(--line);
    }

    .modalBody{
      padding:20px;
      text-align:center;
    }

    .qrBox{
      display:inline-flex;
      padding:13px;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fff;
    }

    .qrMeta{
      margin-top:12px;
      color:#4d625f;
      font-size:11px;
      line-height:1.6;
      font-weight:700;
    }

    @media(max-width:900px){
      .topbar{
        flex-wrap:wrap;
      }

      .spacer{
        display:none;
      }

      .accessPill{
        order:3;
        width:100%;
      }

      .sheetInner{
        min-width:2240px;
      }
    }
  </style>
</head>

<body>
<div class="app">

  <header class="panel topbar">
    <button
      id="tnBoardMenuToggle"
      class="menuBtn"
      type="button"
      aria-label="TO:NEST 메뉴 열기"
    >
      <img src="/favicon.ico?v=9" alt="TO:NEST">
    </button>

    <div class="titleBox">
      <div class="title">쿠팡 캠프 조회</div>
      <div class="subtitle">
        MAROOWELL 공용 캠프 API · 본캠프 · 수신 서브허브 · 채번 링크 관리
      </div>
    </div>

    <div class="spacer"></div>

    <span id="accessPill" class="accessPill">권한 확인 중</span>

    <button id="btnReload" class="btn primary" type="button">
      불러오기
    </button>

    <button id="btnAddRow" class="btn green" type="button" disabled>
      행 추가
    </button>

    <button id="btnSaveAll" class="btn green" type="button" disabled>
      전체 저장
    </button>

    <button id="btnCsv" class="btn" type="button">
      CSV 다운로드
    </button>

    <button id="btnLogout" class="btn red" type="button">
      로그아웃
    </button>
  </header>

  <section class="panel toolbar">
    <label class="toggle">
      <input id="onlyChanged" type="checkbox">
      변경 행만 보기
    </label>

    <button id="btnClearFilters" class="btn" type="button">
      필터 초기화
    </button>

    <span id="accessText" class="helper">
      TO:NEST 계정 권한 확인 중...
    </span>

    <span class="helper">
      캠프 데이터 원본은 MAROOWELL camps API를 사용합니다.
    </span>
  </section>

  <main class="sheetWrap">
    <div class="sheetInner">
      <table>
        <colgroup>
          <col style="width:120px">
          <col style="width:220px">
          <col style="width:155px">
          <col style="width:225px">
          <col style="width:240px">
          <col style="width:320px">
          <col style="width:130px">
          <col style="width:145px">
          <col style="width:150px">
          <col style="width:315px">
          <col style="width:130px">
          <col style="width:130px">
          <col style="width:310px">
          <col style="width:85px">
        </colgroup>

        <thead>
          <tr>
            <th>구분</th>
            <th>캠프명</th>
            <th>MB캠프</th>
            <th>본캠프</th>
            <th>받는 SH</th>
            <th>주소</th>
            <th>Region</th>
            <th>Area</th>
            <th>코드</th>
            <th>채번 링크</th>
            <th>위도</th>
            <th>경도</th>
            <th>설명</th>
            <th>작업</th>
          </tr>

          <tr class="filterRow">
            <th>
              <select id="fType" class="filterSelect">
                <option value="">전체</option>
              </select>
            </th>
            <th><input id="fCamp" class="filterInput" placeholder="캠프명"></th>
            <th><input id="fMb" class="filterInput" placeholder="MB캠프"></th>
            <th><input id="fParent" class="filterInput" placeholder="본캠프"></th>
            <th><input id="fSh" class="filterInput" placeholder="받는 SH"></th>
            <th><input id="fAddress" class="filterInput" placeholder="주소"></th>
            <th>
              <select id="fRegion" class="filterSelect">
                <option value="">전체</option>
              </select>
            </th>
            <th>
              <select id="fArea" class="filterSelect">
                <option value="">전체</option>
              </select>
            </th>
            <th><input id="fCode" class="filterInput" placeholder="코드"></th>
            <th><input id="fNumbering" class="filterInput" placeholder="채번 URL"></th>
            <th><input id="fLat" class="filterInput" placeholder="위도"></th>
            <th><input id="fLng" class="filterInput" placeholder="경도"></th>
            <th><input id="fDesc" class="filterInput" placeholder="설명"></th>
            <th></th>
          </tr>
        </thead>

        <tbody id="sheetBody"></tbody>
      </table>
    </div>
  </main>

  <footer class="panel statusbar">
    <span id="pillReady" class="statusPill">준비 중</span>
    <span id="pillRows" class="statusPill">0행</span>
    <span id="pillDirty" class="statusPill">변경 0</span>
    <span id="statusText" class="statusText">
      캠프 데이터를 불러오는 중입니다.
    </span>
  </footer>

</div>

<div id="qrModal" class="modal" aria-hidden="true">
  <div class="modalCard">
    <div class="modalHead">
      <b id="qrTitle">채번 링크 QR</b>
      <button id="qrClose" class="btn" type="button">닫기</button>
    </div>

    <div class="modalBody">
      <div class="qrBox">
        <canvas id="qrCanvas" width="300" height="300"></canvas>
      </div>
      <div id="qrMeta" class="qrMeta"></div>
    </div>

    <div class="modalActions">
      <button id="qrCopy" class="btn primary" type="button">
        이미지 복사
      </button>
      <button id="qrDownload" class="btn" type="button">
        다운로드
      </button>
    </div>
  </div>
</div>

<script>
(async () => {
  "use strict";

  const AUTH_BASE = location.origin;

  /*
   * Cloudflare Workers & Pages에서 만든 coupang-camps Worker URL.
   * Worker 이름이 바뀌면 여기만 변경.
   */
  const CAMPS_API_BASE =
    "https://coupang-camps.tonest-admin.workers.dev";

  const FIELDS = [
    "camp_type",
    "camp",
    "mb_camp",
    "parent_camp_id",
    "receiving_sh_id",
    "address",
    "region",
    "area",
    "code",
    "numbering_url",
    "latitude",
    "longitude",
    "description"
  ];

  const AREA_OPTIONS = [
    "강남","강북","강서","고양","광주","김포","남경기","대구",
    "대전","동부산","동인천","북경기","서경기","서부산","서인천"
  ];

  const LEGACY_ROCKET_TYPES = new Set([
    "MOBILE_CAMP",
    "MINI_CAMP"
  ]);

  const $ = selector => document.querySelector(selector);

  const esc = value =>
    String(value ?? "")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#39;");

  const text = value =>
    String(value ?? "").trim();

  const normType = value =>
    text(value)
      .toUpperCase()
      .replaceAll("-","_")
      .replaceAll(" ","_");

  const normalizeCampType = value => {
    const original = text(value);
    return LEGACY_ROCKET_TYPES.has(normType(original))
      ? "로켓"
      : original;
  };

  const nullableId = value => {
    const n = Number(value);
    return (
      value === "" ||
      value == null ||
      !Number.isSafeInteger(n) ||
      n <= 0
    )
      ? null
      : n;
  };

  const dom = {
    body:$("#sheetBody"),
    reload:$("#btnReload"),
    add:$("#btnAddRow"),
    save:$("#btnSaveAll"),
    csv:$("#btnCsv"),
    logout:$("#btnLogout"),
    clear:$("#btnClearFilters"),
    onlyChanged:$("#onlyChanged"),
    accessText:$("#accessText"),
    accessPill:$("#accessPill"),
    ready:$("#pillReady"),
    rows:$("#pillRows"),
    dirty:$("#pillDirty"),
    status:$("#statusText"),

    fType:$("#fType"),
    fCamp:$("#fCamp"),
    fMb:$("#fMb"),
    fParent:$("#fParent"),
    fSh:$("#fSh"),
    fAddress:$("#fAddress"),
    fRegion:$("#fRegion"),
    fArea:$("#fArea"),
    fCode:$("#fCode"),
    fNumbering:$("#fNumbering"),
    fLat:$("#fLat"),
    fLng:$("#fLng"),
    fDesc:$("#fDesc"),

    qrModal:$("#qrModal"),
    qrTitle:$("#qrTitle"),
    qrCanvas:$("#qrCanvas"),
    qrMeta:$("#qrMeta"),
    qrClose:$("#qrClose"),
    qrCopy:$("#qrCopy"),
    qrDownload:$("#qrDownload")
  };

  const state = {
    rows:[],
    deletedIds:new Set(),
    canEdit:false,
    profile:null,
    session:null,
    sb:null,
    currentQr:null,
    renderTimer:null
  };

  function setStatus(message, kind="") {
    dom.status.textContent = message || "";
    dom.status.className =
      "statusText" + (kind ? " " + kind : "");
  }

  function setBusy(on) {
    dom.reload.disabled = !!on;
    dom.add.disabled = !!on || !state.canEdit;
    dom.save.disabled = !!on || !state.canEdit;
  }

  function roleLabel(role) {
    return ({
      super_admin:"최고관리자",
      admin:"관리자",
      team_leader:"팀장",
      driver:"기사"
    })[role] || role || "-";
  }

  function rowKey(row) {
    return String(row._key);
  }

  function rowByKey(key) {
    return state.rows.find(
      row => rowKey(row) === String(key)
    ) || null;
  }

  function byId() {
    return new Map(
      state.rows
        .filter(row => !row._deleted && row.id != null)
        .map(row => [String(row.id), row])
    );
  }

  function isSubHub(row) {
    return normType(row?.camp_type) === "SUB_HUB";
  }

  function isBaseCampRow(row) {
    if (!row || isSubHub(row)) return false;

    const mb = text(row.mb_camp);

    return (
      !mb ||
      mb === "본캠프" ||
      mb === text(row.camp)
    );
  }

  function isDirty(row) {
    return (
      row._new ||
      row._deleted ||
      FIELDS.some(
        field =>
          String(row[field] ?? "") !==
          String(row._original?.[field] ?? "")
      )
    );
  }

  function dirtyCount() {
    return state.rows.filter(isDirty).length;
  }

  function baseByCamp() {
    const map = new Map();

    for (const row of state.rows) {
      if (
        row._deleted ||
        !isBaseCampRow(row) ||
        !text(row.camp) ||
        map.has(text(row.camp))
      ) {
        continue;
      }

      map.set(text(row.camp), row);
    }

    return map;
  }

  function resolveParent(
    row,
    index = byId(),
    bases = baseByCamp()
  ) {
    const explicit =
      nullableId(row.parent_camp_id);

    if (explicit != null) {
      return {
        row:index.get(String(explicit)) || null,
        type:"DIRECT"
      };
    }

    if (!isBaseCampRow(row)) {
      const inferred =
        bases.get(text(row.camp)) || null;

      if (inferred && inferred !== row) {
        return {
          row:inferred,
          type:"INFERRED"
        };
      }
    }

    return {
      row:null,
      type:"UNASSIGNED"
    };
  }

  function resolveSh(
    row,
    index = byId(),
    bases = baseByCamp()
  ) {
    const visited = new Set();
    let current = row;
    let inherited = false;

    while (current) {
      const id = nullableId(current.id);

      if (id != null) {
        if (visited.has(String(id))) break;
        visited.add(String(id));
      }

      const direct =
        nullableId(current.receiving_sh_id);

      if (direct != null) {
        return {
          row:index.get(String(direct)) || null,
          type:inherited
            ? "INHERITED"
            : "DIRECT"
        };
      }

      const parent =
        resolveParent(
          current,
          index,
          bases
        ).row;

      if (!parent) break;

      current = parent;
      inherited = true;
    }

    return {
      row:null,
      type:"UNASSIGNED"
    };
  }

  function inheritedParent(
    row,
    index = byId(),
    bases = baseByCamp()
  ) {
    if (
      !row ||
      isSubHub(row) ||
      isBaseCampRow(row)
    ) {
      return null;
    }

    return resolveParent(
      row,
      index,
      bases
    ).row || null;
  }

  function effectiveRegion(
    row,
    index = byId(),
    bases = baseByCamp()
  ) {
    const parent =
      inheritedParent(row,index,bases);

    return text(parent?.region) ||
      text(row?.region);
  }

  function effectiveArea(
    row,
    index = byId(),
    bases = baseByCamp()
  ) {
    const parent =
      inheritedParent(row,index,bases);

    return text(parent?.area) ||
      text(row?.area);
  }

  function safeExternalUrl(value) {
    const raw = text(value);

    if (!raw) return "";

    try {
      const url = new URL(raw);

      return (
        url.protocol === "http:" ||
        url.protocol === "https:"
      )
        ? url.href
        : "";
    } catch {
      return "";
    }
  }

  function campSortCompare(a,b) {
    const campCompare =
      text(a.camp).localeCompare(
        text(b.camp),
        "ko",
        {
          numeric:true,
          sensitivity:"base"
        }
      );

    if (campCompare !== 0) {
      return campCompare;
    }

    const aBase =
      isBaseCampRow(a) ? 0 : 1;

    const bBase =
      isBaseCampRow(b) ? 0 : 1;

    if (aBase !== bBase) {
      return aBase - bBase;
    }

    return text(a.mb_camp).localeCompare(
      text(b.mb_camp),
      "ko",
      {
        numeric:true,
        sensitivity:"base"
      }
    );
  }

  function parentCandidates(row) {
    return state.rows
      .filter(candidate =>
        !candidate._deleted &&
        candidate.id != null &&
        candidate !== row &&
        isBaseCampRow(candidate)
      )
      .sort(campSortCompare);
  }

  function shCandidates() {
    return state.rows
      .filter(row =>
        !row._deleted &&
        row.id != null &&
        isSubHub(row)
      )
      .sort(campSortCompare);
  }

  function disabledFor(row, field) {
    if (!state.canEdit || row._deleted) {
      return true;
    }

    if (
      isSubHub(row) &&
      (
        field === "parent_camp_id" ||
        field === "receiving_sh_id"
      )
    ) {
      return true;
    }

    return false;
  }

  function inputHtml(row, field) {
    const disabled =
      disabledFor(row,field);

    const value =
      row[field] ?? "";

    if (
      field === "description" ||
      field === "address"
    ) {
      return `
        <textarea
          class="cellTextarea"
          data-field="${field}"
          ${disabled ? "disabled" : ""}
        >${esc(value)}</textarea>
      `;
    }

    return `
      <input
        class="cellInput"
        data-field="${field}"
        value="${esc(value)}"
        ${disabled ? "disabled" : ""}
      >
    `;
  }

  function typeOptions(current) {
    const known = [
      "로켓",
      "SUB_HUB",
      "FC",
      "기타"
    ];

    const options =
      Array.from(
        new Set(
          [
            current,
            ...known,
            ...state.rows.map(
              row => normalizeCampType(row.camp_type)
            )
          ].filter(Boolean)
        )
      )
      .sort((a,b) =>
        String(a).localeCompare(
          String(b),
          "ko",
          {numeric:true}
        )
      );

    return options
      .map(value => `
        <option
          value="${esc(value)}"
          ${text(value) === text(current) ? "selected" : ""}
        >
          ${esc(value)}
        </option>
      `)
      .join("");
  }

  function relationParentHtml(row,index,bases) {
    const resolved =
      resolveParent(row,index,bases);

    const selected =
      nullableId(row.parent_camp_id);

    const options =
      parentCandidates(row)
        .map(candidate => `
          <option
            value="${candidate.id}"
            ${selected === Number(candidate.id) ? "selected" : ""}
          >
            ${esc(candidate.camp)}
            ${candidate.mb_camp ? " · " + esc(candidate.mb_camp) : ""}
          </option>
        `)
        .join("");

    const meta =
      resolved.row
        ? (
          resolved.type === "DIRECT"
            ? "직접 · " + text(resolved.row.camp)
            : "자동 · " + text(resolved.row.camp)
        )
        : "미지정";

    const cls =
      resolved.row
        ? (
          resolved.type === "DIRECT"
            ? "direct"
            : "inherited"
        )
        : "unassigned";

    return `
      <div class="relationWrap">
        <select
          class="cellSelect"
          data-field="parent_camp_id"
          ${disabledFor(row,"parent_camp_id") ? "disabled" : ""}
        >
          <option value="">자동/미지정</option>
          ${options}
        </select>
        <div class="relationMeta ${cls}">
          ${esc(meta)}
        </div>
      </div>
    `;
  }

  function relationShHtml(row,index,bases) {
    const resolved =
      resolveSh(row,index,bases);

    const selected =
      nullableId(row.receiving_sh_id);

    const options =
      shCandidates()
        .map(candidate => `
          <option
            value="${candidate.id}"
            ${selected === Number(candidate.id) ? "selected" : ""}
          >
            ${esc(candidate.camp)}
            ${candidate.code ? " · " + esc(candidate.code) : ""}
          </option>
        `)
        .join("");

    const meta =
      resolved.row
        ? (
          resolved.type === "DIRECT"
            ? "직접 · " + text(resolved.row.camp)
            : "상속 · " + text(resolved.row.camp)
        )
        : "미지정";

    const cls =
      resolved.row
        ? (
          resolved.type === "DIRECT"
            ? "direct"
            : "inherited"
        )
        : "unassigned";

    return `
      <div class="relationWrap">
        <select
          class="cellSelect"
          data-field="receiving_sh_id"
          ${disabledFor(row,"receiving_sh_id") ? "disabled" : ""}
        >
          <option value="">자동/미지정</option>
          ${options}
        </select>
        <div class="relationMeta ${cls}">
          ${esc(meta)}
        </div>
      </div>
    `;
  }

  function numberingHtml(row) {
    const url =
      safeExternalUrl(
        row.numbering_url
      );

    return `
      <div class="numberingCell">
        ${inputHtml(row,"numbering_url")}
        <button
          class="openBtn"
          type="button"
          data-numbering-open
          ${url ? "" : "disabled"}
        >
          열기
        </button>
      </div>
    `;
  }

  function campHtml(row) {
    const url =
      safeExternalUrl(
        row.numbering_url
      );

    return `
      <div class="campCell">
        ${inputHtml(row,"camp")}
        <button
          class="qrBtn"
          type="button"
          data-qr-open
          ${url ? "" : "disabled"}
        >
          QR
        </button>
      </div>
    `;
  }

  function rowHtml(row,index,bases) {
    const dirty =
      isDirty(row);

    const dirtyClass =
      dirty ? " dirtyCell" : "";

    const disabled =
      !state.canEdit ||
      row._deleted;

    return `
      <tr
        data-key="${esc(rowKey(row))}"
        class="
          ${row._new ? "newRow" : ""}
          ${row._deleted ? "deleted" : ""}
        "
      >
        <td class="${dirtyClass}">
          <select
            class="cellSelect"
            data-field="camp_type"
            ${disabled ? "disabled" : ""}
          >
            ${typeOptions(normalizeCampType(row.camp_type))}
          </select>
        </td>

        <td class="${dirtyClass}">
          ${campHtml(row)}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"mb_camp")}
        </td>

        <td class="${dirtyClass}">
          ${relationParentHtml(row,index,bases)}
        </td>

        <td class="${dirtyClass}">
          ${relationShHtml(row,index,bases)}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"address")}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"region")}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"area")}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"code")}
        </td>

        <td class="${dirtyClass}">
          ${numberingHtml(row)}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"latitude")}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"longitude")}
        </td>

        <td class="${dirtyClass}">
          ${inputHtml(row,"description")}
        </td>

        <td class="actionCell">
          ${
            state.canEdit
              ? `
                <button
                  class="deleteBtn"
                  type="button"
                  data-delete-row
                >
                  ${row._deleted ? "복원" : "삭제"}
                </button>
              `
              : "-"
          }
        </td>
      </tr>
    `;
  }

  function currentFilters() {
    return {
      type:text(dom.fType.value).toLowerCase(),
      camp:text(dom.fCamp.value).toLowerCase(),
      mb:text(dom.fMb.value).toLowerCase(),
      parent:text(dom.fParent.value).toLowerCase(),
      sh:text(dom.fSh.value).toLowerCase(),
      address:text(dom.fAddress.value).toLowerCase(),
      region:text(dom.fRegion.value).toLowerCase(),
      area:text(dom.fArea.value).toLowerCase(),
      code:text(dom.fCode.value).toLowerCase(),
      numbering:text(dom.fNumbering.value).toLowerCase(),
      lat:text(dom.fLat.value).toLowerCase(),
      lng:text(dom.fLng.value).toLowerCase(),
      desc:text(dom.fDesc.value).toLowerCase()
    };
  }

  function includesValue(value,needle) {
    return (
      !needle ||
      text(value)
        .toLowerCase()
        .includes(needle)
    );
  }

  function filteredRows() {
    const f = currentFilters();
    const index = byId();
    const bases = baseByCamp();

    return state.rows
      .filter(row => {
        if (
          dom.onlyChanged.checked &&
          !isDirty(row)
        ) {
          return false;
        }

        const parent =
          resolveParent(
            row,
            index,
            bases
          ).row;

        const sh =
          resolveSh(
            row,
            index,
            bases
          ).row;

        return (
          includesValue(
            normalizeCampType(row.camp_type),
            f.type
          ) &&
          includesValue(row.camp,f.camp) &&
          includesValue(row.mb_camp,f.mb) &&
          includesValue(
            parent
              ? parent.camp + " " + parent.mb_camp
              : "",
            f.parent
          ) &&
          includesValue(
            sh
              ? sh.camp + " " + sh.code
              : "",
            f.sh
          ) &&
          includesValue(row.address,f.address) &&
          includesValue(
            effectiveRegion(row,index,bases),
            f.region
          ) &&
          includesValue(
            effectiveArea(row,index,bases),
            f.area
          ) &&
          includesValue(row.code,f.code) &&
          includesValue(row.numbering_url,f.numbering) &&
          includesValue(row.latitude,f.lat) &&
          includesValue(row.longitude,f.lng) &&
          includesValue(row.description,f.desc)
        );
      })
      .sort(campSortCompare);
  }

  function renderFilters() {
    const types =
      Array.from(
        new Set(
          state.rows
            .map(row => normalizeCampType(row.camp_type))
            .filter(Boolean)
        )
      ).sort((a,b) =>
        a.localeCompare(
          b,
          "ko",
          {numeric:true}
        )
      );

    const regions =
      Array.from(
        new Set(
          state.rows
            .map(row => text(row.region))
            .filter(Boolean)
        )
      ).sort((a,b) =>
        a.localeCompare(
          b,
          "ko",
          {numeric:true}
        )
      );

    const areas =
      Array.from(
        new Set(
          [
            ...AREA_OPTIONS,
            ...state.rows
              .map(row => text(row.area))
              .filter(Boolean)
          ]
        )
      ).sort((a,b) =>
        a.localeCompare(
          b,
          "ko",
          {numeric:true}
        )
      );

    const oldType =
      dom.fType.value;

    const oldRegion =
      dom.fRegion.value;

    const oldArea =
      dom.fArea.value;

    dom.fType.innerHTML =
      '<option value="">전체</option>' +
      types
        .map(value =>
          `<option value="${esc(value)}">${esc(value)}</option>`
        )
        .join("");

    dom.fRegion.innerHTML =
      '<option value="">전체</option>' +
      regions
        .map(value =>
          `<option value="${esc(value)}">${esc(value)}</option>`
        )
        .join("");

    dom.fArea.innerHTML =
      '<option value="">전체</option>' +
      areas
        .map(value =>
          `<option value="${esc(value)}">${esc(value)}</option>`
        )
        .join("");

    dom.fType.value = oldType;
    dom.fRegion.value = oldRegion;
    dom.fArea.value = oldArea;
  }

  function render() {
    const index = byId();
    const bases = baseByCamp();
    const rows = filteredRows();

    if (!rows.length) {
      dom.body.innerHTML = `
        <tr class="empty">
          <td colspan="14">
            조건에 맞는 캠프가 없습니다.
          </td>
        </tr>
      `;
    } else {
      dom.body.innerHTML =
        rows
          .map(row =>
            rowHtml(
              row,
              index,
              bases
            )
          )
          .join("");
    }

    dom.rows.textContent =
      `${rows.length}행`;

    dom.dirty.textContent =
      `변경 ${dirtyCount()}`;

    dom.dirty.className =
      "statusPill" +
      (dirtyCount() ? " warn" : "");

    dom.add.disabled =
      !state.canEdit;

    dom.save.disabled =
      !state.canEdit ||
      dirtyCount() === 0;
  }

  function scheduleRender() {
    clearTimeout(state.renderTimer);
    state.renderTimer =
      setTimeout(render,40);
  }

  function normalizeLoadedRow(row,index) {
    const clean = {
      ...row
    };

    clean.camp_type =
      normalizeCampType(
        clean.camp_type
      );

    clean._key =
      clean.id != null
        ? "id:" + clean.id
        : "loaded:" + index;

    clean._new = false;
    clean._deleted = false;
    clean._original = {};

    for (const field of FIELDS) {
      clean._original[field] =
        clean[field] ?? "";
    }

    return clean;
  }

  async function authInit() {
    const response =
      await fetch(
        AUTH_BASE + "/auth-config",
        {cache:"no-store"}
      );

    const cfg =
      await response
        .json()
        .catch(() => ({}));

    if (
      !response.ok ||
      !cfg.supabaseUrl ||
      !cfg.supabaseKey
    ) {
      throw new Error(
        cfg.message ||
        "로그인 설정을 불러오지 못했습니다."
      );
    }

    state.sb =
      window.supabase.createClient(
        cfg.supabaseUrl,
        cfg.supabaseKey,
        {
          auth:{
            persistSession:true,
            storage:sessionStorage,
            autoRefreshToken:true,
            detectSessionInUrl:true
          }
        }
      );

    const {
      data:{session}
    } =
      await state.sb.auth.getSession();

    if (!session?.access_token) {
      location.replace(
        "/?next=%2Fcoupang_camp"
      );
      return false;
    }

    state.session = session;

    const meResponse =
      await fetch(
        CAMPS_API_BASE + "/me",
        {
          headers:{
            "Authorization":
              "Bearer " +
              session.access_token
          },
          cache:"no-store"
        }
      );

    const me =
      await meResponse
        .json()
        .catch(() => ({}));

    if (!meResponse.ok) {
      if (meResponse.status === 401) {
        await state.sb.auth.signOut();
        location.replace("/");
        return false;
      }

      throw new Error(
        me.message ||
        "캠프 조회 권한을 확인할 수 없습니다."
      );
    }

    state.profile =
      me.profile || {};

    state.canEdit =
      me.canEdit === true;

    const display =
      state.profile.display_name ||
      state.profile.email ||
      state.session.user.email ||
      "사용자";

    dom.accessPill.textContent =
      `${display} · ${roleLabel(state.profile.role)}`;

    dom.accessText.textContent =
      state.canEdit
        ? "조회 · 추가 · 수정 · 삭제 가능"
        : "조회 전용";

    return true;
  }

  async function apiFetch(
    path,
    options = {}
  ) {
    if (!state.session?.access_token) {
      throw new Error(
        "로그인 세션이 없습니다."
      );
    }

    const headers =
      new Headers(
        options.headers || {}
      );

    headers.set(
      "Authorization",
      "Bearer " +
      state.session.access_token
    );

    if (
      options.body &&
      !headers.has("Content-Type")
    ) {
      headers.set(
        "Content-Type",
        "application/json"
      );
    }

    const response =
      await fetch(
        CAMPS_API_BASE + path,
        {
          ...options,
          headers,
          cache:"no-store"
        }
      );

    const payload =
      await response
        .json()
        .catch(() => ({}));

    if (!response.ok) {
      const error =
        new Error(
          payload?.message ||
          payload?.error ||
          `HTTP ${response.status}`
        );

      error.status =
        response.status;

      throw error;
    }

    return payload;
  }

  async function loadRows() {
    setBusy(true);
    setStatus(
      "MAROOWELL 캠프 API에서 데이터를 불러오는 중...",
      "warn"
    );

    try {
      const payload =
        await apiFetch(
          "/camps?limit=1000"
        );

      const rows =
        Array.isArray(payload?.rows)
          ? payload.rows
          : [];

      state.rows =
        rows.map(normalizeLoadedRow);

      state.deletedIds.clear();

      renderFilters();
      render();

      dom.ready.textContent = "READY";
      dom.ready.className =
        "statusPill ok";

      setStatus(
        `캠프 ${state.rows.length}건을 불러왔습니다.`,
        "ok"
      );

    } finally {
      setBusy(false);
    }
  }

  function addRow() {
    if (!state.canEdit) return;

    const key =
      "new:" +
      Date.now() +
      ":" +
      Math.random()
        .toString(36)
        .slice(2);

    const row = {
      id:null,
      camp_type:"로켓",
      camp:"",
      mb_camp:"",
      parent_camp_id:null,
      receiving_sh_id:null,
      address:"",
      region:"",
      area:"",
      code:"",
      numbering_url:"",
      latitude:"",
      longitude:"",
      description:"",
      _key:key,
      _new:true,
      _deleted:false,
      _original:{}
    };

    for (const field of FIELDS) {
      row._original[field] = "";
    }

    state.rows.push(row);

    renderFilters();
    render();

    setStatus(
      "새 행을 추가했습니다. 값을 입력한 뒤 전체 저장을 누르세요.",
      "warn"
    );
  }

  function payloadFromRow(row) {
    const out = {};

    for (const field of FIELDS) {
      let value = row[field];

      if (
        field === "parent_camp_id" ||
        field === "receiving_sh_id"
      ) {
        value = nullableId(value);
      }

      if (
        field === "latitude" ||
        field === "longitude"
      ) {
        value =
          text(value) === ""
            ? null
            : Number(value);

        if (
          value != null &&
          !Number.isFinite(value)
        ) {
          value = null;
        }
      }

      if (
        ![
          "parent_camp_id",
          "receiving_sh_id",
          "latitude",
          "longitude"
        ].includes(field)
      ) {
        value =
          text(value) || null;
      }

      out[field] = value;
    }

    return out;
  }

  async function saveAll() {
    if (!state.canEdit) return;

    const inserts = [];
    const updates = [];
    const deletes = [];

    for (const row of state.rows) {
      if (
        row._deleted &&
        row.id != null
      ) {
        deletes.push(Number(row.id));
        continue;
      }

      if (row._deleted) {
        continue;
      }

      if (row._new) {
        inserts.push(
          payloadFromRow(row)
        );
        continue;
      }

      if (isDirty(row)) {
        updates.push({
          id:Number(row.id),
          payload:payloadFromRow(row)
        });
      }
    }

    if (
      !inserts.length &&
      !updates.length &&
      !deletes.length
    ) {
      setStatus(
        "저장할 변경사항이 없습니다.",
        "ok"
      );
      return;
    }

    const yes =
      confirm(
        `변경사항을 저장할까요?\n\n` +
        `추가 ${inserts.length}건\n` +
        `수정 ${updates.length}건\n` +
        `삭제 ${deletes.length}건`
      );

    if (!yes) return;

    setBusy(true);
    setStatus(
      "캠프 변경사항을 MAROOWELL API에 저장하는 중...",
      "warn"
    );

    try {
      const result =
        await apiFetch(
          "/camps/batch",
          {
            method:"POST",
            body:JSON.stringify({
              inserts,
              updates,
              deletes
            })
          }
        );

      setStatus(
        `저장 완료 · 추가 ${result.inserted || 0} · 수정 ${result.updated || 0} · 삭제 ${result.deleted || 0}`,
        "ok"
      );

      await loadRows();

    } finally {
      setBusy(false);
    }
  }

  function updateField(
    row,
    field,
    value
  ) {
    if (
      field === "parent_camp_id" ||
      field === "receiving_sh_id"
    ) {
      row[field] =
        nullableId(value);
    } else {
      row[field] = value;
    }

    renderFilters();
    scheduleRender();
  }

  function toggleDelete(row) {
    if (!state.canEdit) return;

    row._deleted =
      !row._deleted;

    scheduleRender();
  }

  function clearFilters() {
    [
      dom.fType,
      dom.fCamp,
      dom.fMb,
      dom.fParent,
      dom.fSh,
      dom.fAddress,
      dom.fRegion,
      dom.fArea,
      dom.fCode,
      dom.fNumbering,
      dom.fLat,
      dom.fLng,
      dom.fDesc
    ].forEach(el => {
      el.value = "";
    });

    dom.onlyChanged.checked = false;

    render();
  }

  function csvEscape(value) {
    const s = String(value ?? "");
    return `"${s.replaceAll('"','""')}"`;
  }

  function downloadCsv() {
    const index = byId();
    const bases = baseByCamp();
    const rows = filteredRows();

    const head = [
      "구분","캠프명","MB캠프","본캠프","받는 SH","주소",
      "Region","Area","코드","채번 링크","위도","경도","설명"
    ];

    const data = rows.map(row => {
      const parent =
        resolveParent(
          row,
          index,
          bases
        ).row;

      const sh =
        resolveSh(
          row,
          index,
          bases
        ).row;

      return [
        normalizeCampType(row.camp_type),
        row.camp,
        row.mb_camp,
        parent?.camp || "",
        sh?.camp || "",
        row.address,
        effectiveRegion(row,index,bases),
        effectiveArea(row,index,bases),
        row.code,
        row.numbering_url,
        row.latitude,
        row.longitude,
        row.description
      ];
    });

    const csv =
      "\ufeff" +
      [
        head,
        ...data
      ]
        .map(row =>
          row
            .map(csvEscape)
            .join(",")
        )
        .join("\r\n");

    const blob =
      new Blob(
        [csv],
        {
          type:"text/csv;charset=utf-8"
        }
      );

    const url =
      URL.createObjectURL(blob);

    const a =
      document.createElement("a");

    a.href = url;
    a.download =
      "TO_NEST_쿠팡캠프_" +
      new Date()
        .toISOString()
        .slice(0,10) +
      ".csv";

    document.body.appendChild(a);
    a.click();
    a.remove();

    URL.revokeObjectURL(url);
  }

  async function openQr(row) {
    const url =
      safeExternalUrl(
        row.numbering_url
      );

    if (!url) {
      alert("채번 링크가 없습니다.");
      return;
    }

    state.currentQr = {
      row,
      url
    };

    dom.qrTitle.textContent =
      `${row.camp || "캠프"} · QR`;

    dom.qrMeta.textContent =
      `${row.camp || ""} ${row.mb_camp || ""}\n${url}`;

    const ctx =
      dom.qrCanvas.getContext("2d");

    ctx.clearRect(
      0,
      0,
      dom.qrCanvas.width,
      dom.qrCanvas.height
    );

    await QRCode.toCanvas(
      dom.qrCanvas,
      url,
      {
        width:300,
        margin:2,
        errorCorrectionLevel:"M"
      }
    );

    dom.qrModal.classList.add("show");
    dom.qrModal.setAttribute(
      "aria-hidden",
      "false"
    );
  }

  function closeQr() {
    dom.qrModal.classList.remove("show");
    dom.qrModal.setAttribute(
      "aria-hidden",
      "true"
    );
    state.currentQr = null;
  }

  async function copyQr() {
    if (!navigator.clipboard?.write) {
      alert("이 브라우저는 이미지 클립보드 복사를 지원하지 않습니다.");
      return;
    }

    const blob =
      await new Promise(resolve =>
        dom.qrCanvas.toBlob(
          resolve,
          "image/png"
        )
      );

    if (!blob) return;

    await navigator.clipboard.write([
      new ClipboardItem({
        "image/png":blob
      })
    ]);

    setStatus(
      "QR 이미지를 클립보드에 복사했습니다.",
      "ok"
    );
  }

  function downloadQr() {
    if (!state.currentQr) return;

    const a =
      document.createElement("a");

    a.href =
      dom.qrCanvas.toDataURL(
        "image/png"
      );

    a.download =
      `${state.currentQr.row.camp || "camp"}_QR.png`;

    a.click();
  }

  async function logout() {
    try {
      await state.sb?.auth?.signOut();
    } finally {
      location.replace("/");
    }
  }

  dom.body.addEventListener(
    "input",
    event => {
      const field =
        event.target?.dataset?.field;

      if (!field) return;

      const tr =
        event.target.closest(
          "tr[data-key]"
        );

      const row =
        rowByKey(
          tr?.dataset?.key
        );

      if (!row) return;

      updateField(
        row,
        field,
        event.target.value
      );
    }
  );

  dom.body.addEventListener(
    "change",
    event => {
      const field =
        event.target?.dataset?.field;

      if (!field) return;

      const tr =
        event.target.closest(
          "tr[data-key]"
        );

      const row =
        rowByKey(
          tr?.dataset?.key
        );

      if (!row) return;

      updateField(
        row,
        field,
        event.target.value
      );
    }
  );

  dom.body.addEventListener(
    "click",
    event => {
      const tr =
        event.target.closest(
          "tr[data-key]"
        );

      const row =
        rowByKey(
          tr?.dataset?.key
        );

      if (!row) return;

      if (
        event.target.closest(
          "[data-delete-row]"
        )
      ) {
        toggleDelete(row);
        return;
      }

      if (
        event.target.closest(
          "[data-numbering-open]"
        )
      ) {
        const url =
          safeExternalUrl(
            row.numbering_url
          );

        if (url) {
          window.open(
            url,
            "_blank",
            "noopener,noreferrer"
          );
        }

        return;
      }

      if (
        event.target.closest(
          "[data-qr-open]"
        )
      ) {
        openQr(row)
          .catch(error =>
            alert(
              error?.message ||
              String(error)
            )
          );
      }
    }
  );

  [
    dom.fType,
    dom.fCamp,
    dom.fMb,
    dom.fParent,
    dom.fSh,
    dom.fAddress,
    dom.fRegion,
    dom.fArea,
    dom.fCode,
    dom.fNumbering,
    dom.fLat,
    dom.fLng,
    dom.fDesc
  ].forEach(el => {
    el.addEventListener(
      el.tagName === "SELECT"
        ? "change"
        : "input",
      scheduleRender
    );
  });

  dom.onlyChanged.addEventListener(
    "change",
    render
  );

  dom.reload.addEventListener(
    "click",
    () =>
      loadRows()
        .catch(error =>
          setStatus(
            error?.message ||
            String(error),
            "err"
          )
        )
  );

  dom.add.addEventListener(
    "click",
    addRow
  );

  dom.save.addEventListener(
    "click",
    () =>
      saveAll()
        .catch(error =>
          setStatus(
            error?.message ||
            String(error),
            "err"
          )
        )
  );

  dom.csv.addEventListener(
    "click",
    downloadCsv
  );

  dom.clear.addEventListener(
    "click",
    clearFilters
  );

  dom.logout.addEventListener(
    "click",
    logout
  );

  dom.qrClose.addEventListener(
    "click",
    closeQr
  );

  dom.qrModal.addEventListener(
    "click",
    event => {
      if (
        event.target ===
        dom.qrModal
      ) {
        closeQr();
      }
    }
  );

  dom.qrCopy.addEventListener(
    "click",
    () =>
      copyQr()
        .catch(error =>
          alert(
            error?.message ||
            String(error)
          )
        )
  );

  dom.qrDownload.addEventListener(
    "click",
    downloadQr
  );

  try {
    const ready =
      await authInit();

    if (!ready) return;

    await loadRows();

  } catch (error) {
    console.error(error);

    dom.ready.textContent =
      "ERROR";

    setStatus(
      error?.message ||
      String(error),
      "err"
    );
  }
})();
</script>
</body>
</html>
